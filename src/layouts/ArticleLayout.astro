---
import type { CollectionEntry } from 'astro:content';
import { existsSync } from 'node:fs';
import path from 'node:path';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductPromo from '../components/ProductPromo.astro';
import TagPills from '../components/TagPills.astro';
import AudioNarration from '../components/AudioNarration.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Faq from '../components/Faq.astro';
import Toc from '../components/Toc.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { SITE_TITLE, TAG_MAP, pageTitle } from '../consts';
import { getRelatedArticles, toArticleCard } from '../utils/articles';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

type Props = CollectionEntry<'articles'>['data'] & {
	id?: string;
	headings?: Heading[];
	readTime?: number;
};

const { title, description, pubDate, updatedDate, image, cardImage, id, headings = [], readTime, faq, tags = [] } = Astro.props;
const heroImage = cardImage || image;

// Human-readable publish (or last-updated) date shown in the article header,
// alongside the machine-readable <time datetime> the same value feeds.
const displayDate = updatedDate ?? pubDate;
const displayDateLabel = updatedDate ? 'Updated' : undefined;
const formattedDate = displayDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Narration audio is generated per-article via scripts/generate-audio-narration.mjs
// and lives at public/audio/{id}.mp3 by convention — render the player only if
// that file actually exists, so articles awaiting generation don't break.
const audioSrc = id && existsSync(path.resolve('public/audio', `${id}.mp3`))
	? `/audio/${id}.mp3`
	: undefined;

const tocHeadings = headings.filter((h) => h.depth === 2);

const related = (await getRelatedArticles(tags, id)).map(toArticleCard);

// Structured data uses the rasterized PNG (same swap BaseHead makes for
// og:image) so image-aware crawlers get a format they can actually render.
const schemaImage = heroImage
	? new URL(heroImage.replace(/\.svg$/i, '.png'), Astro.site).toString()
	: undefined;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	...(schemaImage && { image: schemaImage }),
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	author: {
		'@type': 'Person',
		name: 'Ryan Sheridan',
		url: new URL('/about/', Astro.site).toString(),
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: Astro.site?.toString(),
		logo: {
			'@type': 'ImageObject',
			url: new URL('/images/logo-256px.jpg', Astro.site).toString(),
		},
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': Astro.url.toString(),
	},
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: Astro.site?.toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Articles',
			item: new URL('/articles/', Astro.site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: title,
		},
	],
};

const articleUrl = Astro.url.toString();
const emailShareUrl = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`Check out this article: ${articleUrl}`)}`;

const productSlugs: Record<string, string> = {
	budget: 'budget-spreadsheet',
	couples: 'couples-budget-spreadsheet',
	debt: 'debt-payoff-tracker',
	savings: 'savings-goals-tracker',
};

const tagProductMap: Record<string, string[]> = {
	'expense-tracking': ['budget', 'savings'],
	'couples-budgeting': ['couples', 'budget'],
	'debt-payoff': ['debt', 'budget'],
	'savings-goals': ['savings', 'budget'],
	'irregular-income': ['budget', 'savings'],
	'net-worth': ['budget', 'savings'],
	'budgeting-styles': ['budget', 'couples'],
};

const productIds = tags.flatMap((tag: string) => tagProductMap[tag] ?? []);
const seen = new Set<string>();
const uniqueProductIds = productIds.filter((pid: string) => {
	if (seen.has(pid)) return false;
	seen.add(pid);
	return true;
}).slice(0, 2);
const recommendedSlugs = (uniqueProductIds.length >= 2 ? uniqueProductIds : ['budget', 'savings'])
	.map((pid: string) => productSlugs[pid]);
---

<html lang="en">
	<head>
		<BaseHead title={pageTitle(title)} description={description} image={cardImage || image} type="article" pubDate={pubDate} updatedDate={updatedDate} />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<Header />
		<ReadingProgress />

		<main id="main-content" class:list={['article-main', { 'has-toc': tocHeadings.length > 1 }]}>
			<Breadcrumbs crumbs={[{ label: 'Articles', href: '/articles/' }, { label: title }]} />
			<div class="article-grid">
				{tocHeadings.length > 1 && (
					<Toc entries={tocHeadings.map((h) => ({ slug: h.slug, text: h.text }))}>
						<ProductPromo slug={recommendedSlugs[0]} variant="mini" />
					</Toc>
				)}

				<article>
					<header class="article-header">
						<TagPills tags={tags} tagMap={TAG_MAP} />
						<h1 class="article-title">{title}</h1>
						<p class="article-meta">
							<time datetime={displayDate.toISOString()}>{displayDateLabel && `${displayDateLabel} `}{formattedDate}</time>
							{readTime && <><span class="article-meta-sep" aria-hidden="true">·</span><span>{readTime} min read</span></>}
						</p>
					</header>

					{heroImage && (
						<div class="article-hero-img">
							<img src={heroImage} alt={title} fetchpriority="high" />
						</div>
					)}

					<div class="article-actions">
						<button class="action-btn" id="share-btn" aria-label="Share this article" data-cta="article_share_button">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
								<polyline points="16 6 12 2 8 6" />
								<line x1="12" y1="2" x2="12" y2="15" />
							</svg>
							<span>Share</span>
						</button>
						<a href={emailShareUrl} class="action-btn" aria-label="Share via email" data-cta="article_share_email">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<rect x="2" y="4" width="20" height="16" rx="2" />
								<path d="M22 4l-10 8L2 4" />
							</svg>
							<span>Email</span>
						</a>
					</div>

					{audioSrc && <AudioNarration src={audioSrc} />}

					<div class="prose">
						<slot />
					</div>
				</article>
			</div>

			{related.length > 0 && (
				<aside class="related content-block" aria-labelledby="related-heading">
					<h2 id="related-heading" class="content-block-title">Related articles</h2>
					<div class="card-list">
						{related.map((r) => (
							<ArticleCard article={r} variant="compact" cta={`article_related_link:${r.id}`} />
						))}
					</div>
				</aside>
			)}

			{faq && faq.length > 0 && <Faq items={faq} class="content-block" />}

			<section class="recommended-products content-block" aria-label="Recommended spreadsheets">
				{recommendedSlugs.map((slug) => (
					<ProductPromo slug={slug} variant="row" />
				))}
			</section>
		</main>
		<Footer />

		<script>
			const shareBtn = document.getElementById('share-btn');
			shareBtn?.addEventListener('click', async () => {
				const url = window.location.href;
				const title = document.title;

				if (navigator.share) {
					try {
						await navigator.share({ title, url });
					} catch {}
				} else {
					await navigator.clipboard.writeText(url);
					const label = shareBtn.querySelector('span');
					if (label) {
						const original = label.textContent;
						label.textContent = 'Copied!';
						setTimeout(() => { label.textContent = original; }, 2000);
					}
				}
			});

			/* :not(.calc-table) is load-bearing. Calculator tables opt out of
			   scrolling on purpose — they set display:table + table-layout:fixed so
			   their columns stay aligned inside an article — and wrapping one gave
			   it the wrap's mobile right-bleed while leaving it unable to scroll.
			   The result was a table 24px wider than the column, pinned flush to
			   the screen edge with its last header clipped and no way to reach it. */
			document.querySelectorAll<HTMLTableElement>('.prose table:not(.calc-table)').forEach((table) => {
				const wrap = document.createElement('div');
				wrap.className = 'table-scroll-wrap';
				table.parentNode?.insertBefore(wrap, table);
				wrap.appendChild(table);

				const rail = document.createElement('div');
				rail.className = 'table-scroll-rail';
				const thumb = document.createElement('span');
				thumb.className = 'table-scroll-thumb';
				rail.appendChild(thumb);
				wrap.appendChild(rail);

				function updateOverflow() {
					const max = table.scrollWidth - table.clientWidth;
					const scrollable = max > 4;
					wrap.classList.toggle('is-scrollable', scrollable);
					if (!scrollable) return;

					// Thumb width is the visible fraction, so its size states how much
					// table there is. Translation is expressed in multiples of the
					// thumb's own width, which is what a percentage transform resolves
					// against.
					const visible = table.clientWidth / table.scrollWidth;
					const travelled = table.scrollLeft / max;
					thumb.style.width = `${visible * 100}%`;
					thumb.style.transform = `translateX(${travelled * (100 / visible - 100)}%)`;
				}
				updateOverflow();
				window.addEventListener('resize', updateOverflow, { passive: true });
				table.addEventListener('scroll', updateOverflow, { passive: true });
			});

		</script>
	</body>
</html>

<style>
	/* ——— Article hero image ——— */

	/* Card radius and the same inner hairline as .card-media, so the article's
	   own image matches the card that linked to it. */
	.article-hero-img {
		position: relative;
		aspect-ratio: 16 / 9;
		margin-bottom: var(--space-lg);
		border-radius: var(--radius-card);
		overflow: hidden;
	}

	.article-hero-img::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 0 0 1px rgba(var(--shadow-rgb), 0.06);
		pointer-events: none;
	}

	.article-hero-img img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}


	/* ——— Article main ——— */

	.article-main {
		--toc-rail-width: 220px;
		--toc-gap: calc(var(--space-xl) + 3rem);
		max-width: calc(var(--max-width-narrow) + var(--space-md) * 2);
		margin: 0 auto;
		padding: var(--space-lg) var(--space-md) var(--space-2xl);
	}

	@media (min-width: 1100px) {
		.article-main.has-toc {
			/* Header's nav is max-width(--max-width) plus its own space-md padding outside that;
			   mirror the same total width here so the TOC's left edge lines up with the logo/nav. */
			max-width: calc(var(--max-width) + var(--space-md) * 2);
		}
	}

	.article-grid {
		padding-top: 3rem;
	}

	/* ——— Fallback header (no image) ——— */

	.article-header {
		margin-bottom: var(--space-lg);
	}

	.article-title {
		font-size: clamp(1.75rem, 3vw + 0.5rem, 2.5rem);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--space-sm);
	}

	.article-meta {
		font-size: var(--text-small);
		color: var(--color-text-muted);
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.375rem;
	}

	/* ——— Share / actions ——— */

	.article-actions {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		padding: var(--space-sm) 0;
		margin-bottom: var(--space-lg);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.action-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font-family: var(--font-sans);
		font-size: var(--text-small);
		font-weight: var(--weight-normal);
		/* Reset the UA default line-height (`normal`) that the <button> uses but
		   the <a> doesn't — without this the two share buttons render at
		   different heights. */
		line-height: 1;
		color: var(--color-text-secondary);
		background: none;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		padding: 0.375rem 0.875rem;
		cursor: pointer;
		text-decoration: none;
		transition: color 0.15s, border-color 0.15s;
	}

	.action-btn:hover {
		color: var(--color-text);
		border-color: var(--color-text-muted);
	}

	/* The pill is 30px tall from its padding, and the two sit 8px apart — two
	   small targets in a row under a thumb. min-height rather than more
	   padding so the label and icon stay exactly where they are and the
	   button just centres itself in a taller box; scoped to touch widths so
	   the desktop row keeps its current proportions. */
	@media (max-width: 768px) {
		.action-btn {
			min-height: 2.75rem;
		}
	}

	/* ——— Table of contents: left rail on wide viewports ———
	   The Toc component makes itself sticky; this places it in the grid and
	   lines the closing blocks up under the reading column. Those blocks are
	   rendered by child components (Faq), so the selectors are :global. */

	@media (min-width: 1100px) {
		.has-toc .article-grid {
			display: grid;
			grid-template-columns: var(--toc-rail-width) minmax(0, var(--max-width-narrow));
			column-gap: var(--toc-gap);
			align-items: start;
		}

		.has-toc :global(.content-block) {
			max-width: var(--max-width-narrow);
			margin-left: calc(var(--toc-rail-width) + var(--toc-gap));
			margin-right: auto;
		}
	}
</style>
