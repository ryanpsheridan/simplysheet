---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductPromo from '../components/ProductPromo.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ToolCard from '../components/ToolCard.astro';
import Faq from '../components/Faq.astro';
import Toc from '../components/Toc.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { SITE_TITLE, pageTitle } from '../consts';
import { TOOLS, toolId } from '../data/tools';
import { getRelatedArticles, toArticleCard } from '../utils/articles';

interface TocEntry {
	slug: string;
	text: string;
}

interface FaqEntry {
	question: string;
	answer: string;
}

interface Props {
	title: string;
	metaTitle: string;
	description: string;
	breadcrumbLabel: string;
	kind?: 'calculator' | 'assessment';
	toc: TocEntry[];
	faq?: FaqEntry[];
	tags?: string[];
	productSlug: string;
	productLabel?: string;
	relatedToolUrls?: string[];
}

const {
	title,
	metaTitle,
	description,
	breadcrumbLabel,
	kind = 'calculator',
	toc,
	faq = [],
	tags = [],
	productSlug,
	productLabel,
	relatedToolUrls,
} = Astro.props;

const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const otherTools = TOOLS.filter((t) => t.url !== currentPath);
const relatedTools = relatedToolUrls
	? relatedToolUrls.map((url) => otherTools.find((t) => t.url === url)).filter((t): t is (typeof TOOLS)[number] => Boolean(t))
	: otherTools.slice(0, 4);

const related = (await getRelatedArticles(tags)).map(toArticleCard);

const kindLabel = kind === 'assessment' ? 'Assessment' : 'Calculator';
const tocEntries: TocEntry[] = [
	{ slug: 'calculator', text: kindLabel },
	...toc,
	...(faq.length ? [{ slug: 'faq', text: 'Frequently asked questions' }] : []),
	{ slug: 'more-tools', text: 'More free tools' },
	...(related.length ? [{ slug: 'related-articles', text: 'Related articles' }] : []),
];

const appSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: title,
	description,
	url: Astro.url.toString(),
	applicationCategory: 'FinanceApplication',
	operatingSystem: 'Any',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: Astro.site?.toString(),
	},
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: Astro.site?.toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Tools',
			item: new URL('/tools/', Astro.site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: breadcrumbLabel,
		},
	],
};

---

<html lang="en">
	<head>
		<BaseHead title={pageTitle(metaTitle)} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<Header />
		<ReadingProgress />

		<main id="main-content" class="calc-main">
			<Breadcrumbs crumbs={[{ label: 'Tools', href: '/tools/' }, { label: breadcrumbLabel }]} />
			<div class="calc-grid">
				<Toc entries={tocEntries}>
					<ProductPromo slug={productSlug} variant="mini" />
				</Toc>

				<article>
					<header class="calc-header">
						<h1>{title}</h1>
						<p class="calc-intro"><slot name="intro" /></p>
					</header>

					<div class="calc-embed" id="calculator">
						<slot name="calculator" />
					</div>

					<div class="prose">
						<slot />
					</div>

					<Faq items={faq} html class="content-block" />

					<section class="content-block" id="more-tools" aria-labelledby="more-tools-heading">
						<h2 id="more-tools-heading" class="content-block-title">More free tools</h2>
						<div class="more-tools-list">
							{relatedTools.map((tool) => (
								<ToolCard tool={tool} variant="row" cta={`calculator_more_tools_item:${toolId(tool)}`} />
							))}
						</div>
						<p class="content-block-foot"><a href="/tools/" class="text-link" data-cta="calculator_more_tools_view_all">View all tools <span class="arrow">&rarr;</span></a></p>
					</section>

					{related.length > 0 && (
						<aside class="content-block" id="related-articles" aria-labelledby="related-articles-heading">
							<h2 id="related-articles-heading" class="content-block-title">Related articles</h2>
							<div class="card-list">
								{related.map((r) => (
									<ArticleCard article={r} variant="compact" cta={`calculator_related_article:${r.id}`} />
								))}
							</div>
						</aside>
					)}

					<section class="content-block" aria-label="Recommended spreadsheet">
						<ProductPromo slug={productSlug} variant="interstitial" label={productLabel} />
					</section>
				</article>
			</div>
		</main>
		<Footer />

	</body>
</html>

<style>
	/* ——— Main layout ——— */

	.calc-main {
		--toc-rail-width: 220px;
		--toc-gap: calc(var(--space-xl) + 3rem);
		max-width: calc(var(--max-width-narrow) + var(--space-md) * 2);
		margin: 0 auto;
		padding: var(--space-lg) var(--space-md) var(--space-2xl);
	}

	@media (min-width: 1100px) {
		.calc-main {
			/* Header's nav is max-width(--max-width) plus its own space-md padding outside that;
			   mirror the same total width here so the TOC's left edge lines up with the logo/nav. */
			max-width: calc(var(--max-width) + var(--space-md) * 2);
		}
	}

	.calc-grid {
		padding-top: var(--space-lg);
	}

	@media (min-width: 1100px) {
		.calc-grid {
			display: grid;
			grid-template-columns: var(--toc-rail-width) minmax(0, var(--max-width-narrow));
			column-gap: var(--toc-gap);
			align-items: start;
		}
	}

	/* ——— Header ——— */

	.calc-header {
		margin-bottom: var(--space-sm);
	}

	.calc-header h1 {
		font-size: var(--text-h1);
	}

	.calc-intro {
		font-size: var(--text-read);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
	}

	.calc-embed {
		scroll-margin-top: var(--header-offset);
	}

	/* ——— More tools ——— */

	.more-tools-list {
		border-top: 1px solid var(--color-border);
	}
</style>
