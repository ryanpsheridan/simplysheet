		height: 100%;
		width: 0%;
		background: var(--color-text);
		transition: width linear;
	}
	.reviews-nav {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		margin-top: var(--space-md);
	}
	.reviews-count {
		font-size: var(--text-small);
		color: var(--color-text-muted);
		margin-left: var(--space-xs);
