		top: 0;
		left: 0;
		right: 0;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.6s ease;
	}
	.product-reviews.is-multi .review-entry.is-active {
		opacity: 1;
		pointer-events: auto;
	}
	.reviews-quote {
		font-size: clamp(1.375rem, 1.8vw + 0.6rem, 1.75rem);
		font-weight: var(--weight-normal);
		line-height: 1.5;
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin: 0;
	}
	.reviews-entry-name {
		display: block;
		font-size: var(--text-small);
		font-style: normal;
		color: var(--color-text-muted);
		margin-top: var(--space-md);
