---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_TITLE, ETSY_SHOP_URL, withEtsyTracking } from '../consts';
import { intrinsicSize } from '../../scripts/image-size.mjs';

type Props = CollectionEntry<'templates'>['data'] & {
	id?: string;
};

const { title, description, badge, platforms, darkListing, lightListing, heroImage, lightImage, features, howItWorks, relatedArticles, bundles, faq, reviews, id, price, sku } = Astro.props;

// Optional long-form buyer's guide, written as the markdown body of the
// template's own content file. Rendered to a string rather than gated on
// `Astro.slots.has('default')`, because the route always passes a <Content />
// — `has` would report true even for a template whose body is empty, and the
// section would render as a stray rule with nothing under it.
const guide = (await Astro.slots.render('default')).trim();

// The "how it works" images are styled `width: 100%; height: auto` with no
// aspect-ratio container, so without dimensions the browser cannot reserve
// space and everything below them shifts once they load. Probed at build time
// from the file itself, so the ratio can never drift from the real asset.
type HowToRow = { heading: string; body: string; image?: string; imageAlt?: string };
const howToSizes = new Map(
	await Promise.all(
		(howItWorks as HowToRow[])
			.flatMap((row) => (row.image ? [row.image] : []))
			.map(async (image) => [image, await intrinsicSize(image)] as const),
	),
);

const allArticles = await getCollection('articles');
const linkedArticles = relatedArticles
	.map((slug: string) => allArticles.find((a) => a.id === slug))
	.filter(Boolean)
	.slice(0, 4);

const allTemplates = await getCollection('templates');
const otherTemplates = allTemplates
	.filter((t) => t.id !== id)
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);

const platformLabels: Record<string, string> = {
	'google-sheets': 'Google Sheets',
	'excel': 'Excel',
};

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.simplysheetdesign.com';
const imageUrl = `${siteUrl}${heroImage}`;

const darkListingUrl = withEtsyTracking(darkListing);
const lightListingUrl = withEtsyTracking(lightListing);
const etsyReviewsUrl = withEtsyTracking(`${ETSY_SHOP_URL}/#reviews`);

const reviewSchema = reviews?.map((r: { name: string; text: string; date?: string }) => ({
	'@type': 'Review',
	author: { '@type': 'Person', name: r.name },
	reviewBody: r.text,
	reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
	...(r.date ? { datePublished: r.date } : {}),
}));

const aggregateRating = reviews?.length ? {
	'@type': 'AggregateRating',
	ratingValue: 5,
	reviewCount: reviews.length,
	bestRating: 5,
	worstRating: 1,
} : undefined;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: title,
	description,
	image: imageUrl,
	sku,
	brand: {
		'@type': 'Brand',
		name: SITE_TITLE,
	},
	...(reviewSchema?.length ? { review: reviewSchema } : {}),
	...(aggregateRating ? { aggregateRating } : {}),
	offers: {
		'@type': 'Offer',
		price: price.toFixed(2),
		priceCurrency: 'USD',
		availability: 'https://schema.org/InStock',
		url: darkListing,
		seller: {
			'@type': 'Organization',
			name: SITE_TITLE,
		},
		shippingDetails: {
			'@type': 'OfferShippingDetails',
			shippingDestination: {
				'@type': 'DefinedRegion',
				addressCountry: 'US',
			},
			doesNotShip: true,
		},
		hasMerchantReturnPolicy: {
			'@type': 'MerchantReturnPolicy',
			applicableCountry: 'US',
			returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
		},
	},
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: Astro.site?.toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Spreadsheets',
			item: new URL('/spreadsheets/', Astro.site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: title,
		},
	],
};

const faqSchema = faq?.length ? {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map(({ question, answer }: { question: string; answer: string }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
} : null;

const templateId = Math.random().toString(36).slice(2, 10);

function featureIcon(text: string): string {
	const t = text.toLowerCase();
	// Income / earnings
	if (t.includes('income') && !t.includes('dual')) return '<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>';
	// Dual / partners / couples
	if (t.includes('dual') || t.includes('partner') || (t.includes('both') && t.includes('income'))) return '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>';
	// Progress bars / visual progress
	if (t.includes('progress bar')) return '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>';
	// Dashboard / overview
	if (t.includes('dashboard') || t.includes('overview')) return '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>';
	// Trends / spending trends
	if (t.includes('trend')) return '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>';
	// Log / logging / daily expense
	if (t.includes('log') || t.includes('logging')) return '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>';
	// Categories / customize / pre-built
	if (t.includes('categor') || t.includes('customize')) return '<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>';
	// Goals / target / savings goal
	if (t.includes('goal') || t.includes('target')) return '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>';
	// Contribution / combined savings
	if (t.includes('contribution')) return '<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>';
	// Deadline / date
	if (t.includes('deadline') || t.includes('monthly') || t.includes('month')) return '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>';
	// Debt / balance / credit
	if (t.includes('debt') || t.includes('balance') || t.includes('credit')) return '<rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>';
	// Interest / percent
	if (t.includes('interest')) return '<line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>';
	// Shared / personal / split / bill
	if (t.includes('shared') || t.includes('personal') || t.includes('split') || t.includes('bill')) return '<path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/>';
	// Spreadsheet / Google Sheets / Excel / works with
	if (t.includes('google sheets') || t.includes('excel') || t.includes('spreadsheet')) return '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/>';
	// Default checkmark
	return '<polyline points="20 6 9 17 4 12"/>';
}
---

<html lang="en">
	<head>
		<BaseHead title={`${title} — ${SITE_TITLE}`} description={description} image={heroImage} />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<Header />

		<main id="main-content" class="template-main">
			<Breadcrumbs crumbs={[{ label: 'Spreadsheets', href: '/spreadsheets' }, { label: title }]} />

			<section class="product-hero">
				<div class="product-image">
					<img src={heroImage} alt={`${title} preview`} width="960" height="640" id={`hero-img-${templateId}`} fetchpriority="high" />
				</div>
				<div class="product-info">
					{badge && <span class="badge product-badge">{badge}</span>}
					<h1 class="product-title">{title}</h1>
					<p class="product-desc">{description}</p>

					<div class="theme-toggle" id={`theme-toggle-${templateId}`}>
						<button class="theme-btn active" data-theme="dark">Dark</button>
						<button class="theme-btn" data-theme="light">Light</button>
					</div>

					{/* The price was in the Product JSON-LD but rendered nowhere, which
					    Google's structured data guidelines disallow: marked-up values
					    have to be visible to the reader. This is the same `price` the
					    schema emits, so the two cannot drift apart.

					    Deliberately bare. A sale is nearly always running on Etsy, so the
					    real price is usually below this one, but the caveat line that sat
					    here explained a discrepancy the visitor never experiences as a
					    problem: they reach the listing to find it cheaper than advertised,
					    never dearer. Announcing the sale also edges toward a discount
					    promise the site cannot keep in sync with the shop. */}
					<p class="product-price">${price.toFixed(2)}</p>

					<a
						href={darkListingUrl}
						class="btn btn-primary product-cta"
						id={`cta-${templateId}`}
						target="_blank"
						rel="noopener noreferrer"
						data-cta={`template_hero_cta:${id}`}
					>
						Get this template on Etsy
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
					</a>

					<div class="product-platforms">
						{platforms.map((p: string) => (
							<span class="badge">{platformLabels[p] ?? p}</span>
						))}
					</div>
				</div>
			</section>

			{(features.length > 0 || howItWorks.length > 0) && (
				<section class="product-details">
					<div class="details-list">
						{features.length > 0 && (
							<div class="detail-row">
								<h2>What's included</h2>
								<ul class="features-list">
									{features.map((f: string) => (
										<li>
											<span class="feature-icon">
												<svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={featureIcon(f)} />
											</span>
											<span>{f}</span>
										</li>
									))}
								</ul>
							</div>
						)}

						{howItWorks.map((row: { heading: string; body: string; image?: string; imageAlt?: string }) => (
							<div class="detail-row">
								<h2>{row.heading}</h2>
								<div class="howto-content">
									<p set:html={row.body} />
									{row.image && <img src={row.image} alt={row.imageAlt ?? row.heading} {...howToSizes.get(row.image) ?? {}} loading="lazy" decoding="async" />}
								</div>
							</div>
						))}
					</div>
				</section>
			)}

			{guide && (
				<section class="product-guide">
					<div class="prose" set:html={guide} />

					{/* Sits at the end of the guide, where a reader who has just worked
					    through ~900 words is as convinced as the page can make them.
					    Tracked separately from the hero so the two positions can be
					    compared in GA4 rather than blended into one number. */}
					<div class="product-cta-footer">
						<a
							href={darkListingUrl}
							class="btn btn-primary"
							target="_blank"
							rel="noopener noreferrer"
							data-cta={`template_footer_cta:${id}`}
						>
							Get this template on Etsy
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
						</a>
					</div>
				</section>
			)}

			{bundles && bundles.length > 0 && (
				<section class="product-bundles">
					<h2>Save with a bundle</h2>
					<div class="bundles-grid">
						{bundles.map((b: { name: string; darkUrl: string; lightUrl: string; image?: string }) => (
							<a
								href={withEtsyTracking(b.darkUrl)}
								class="bundle-card"
								data-dark-url={withEtsyTracking(b.darkUrl)}
								data-light-url={withEtsyTracking(b.lightUrl)}
								target="_blank"
								rel="noopener noreferrer"
								data-cta={`template_bundle_cta:${id}:${b.name}`}
							>
								{b.image && (
									<div class="bundle-thumb">
										<img src={b.image} alt={`${b.name} preview`} width="600" height="400" loading="lazy" />
									</div>
								)}
								<span class="bundle-text">
									<span class="bundle-name">{b.name}</span>
									<span class="bundle-link">View on Etsy <span class="arrow">&rarr;</span></span>
								</span>
							</a>
						))}
					</div>
				</section>
			)}

			{reviews && reviews.length > 0 && (
				<section class={`product-reviews${reviews.length > 1 ? ' is-multi' : ' is-single'}`} id={`reviews-${templateId}`}>
					<div class="reviews-quote-col">
						<div class="reviews-quote-stack">
							{reviews.map((r: { name: string; text: string }, i: number) => (
								<div class={`review-entry${i === 0 ? ' is-active' : ''}`} data-review-entry>
									<div class="review-stars" aria-label="5 out of 5 stars">
										{Array.from({ length: 5 }).map(() => (
											<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
										))}
									</div>
									<p class="reviews-quote" data-review-quote>{r.text}</p>
									<cite class="reviews-entry-name">{r.name}</cite>
								</div>
							))}
						</div>
						{reviews.length > 1 && (
							<span class="reviews-progress-track"><span class="reviews-progress-fill" data-review-progress></span></span>
						)}
						{reviews.length === 1 && (
							<a
								class="btn btn-secondary btn-sm reviews-etsy-link"
								href={etsyReviewsUrl}
								target="_blank"
								rel="noopener noreferrer"
								data-cta={`template_reviews_cta:${id}`}
							>
								See all Etsy reviews <span class="arrow">&rarr;</span>
							</a>
						)}
					</div>
					{reviews.length > 1 && (
						<div class="reviews-name-col">
							<span class="eyebrow reviews-eyebrow">What people are saying</span>
							<div class="reviews-nav">
								<button type="button" class="reviews-nav-btn" data-review-prev aria-label="Previous review">
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
								</button>
								<button type="button" class="reviews-nav-btn" data-review-next aria-label="Next review">
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
								</button>
								<span class="reviews-count" data-review-count>1 of {reviews.length}</span>
							</div>
						</div>
					)}
					{reviews.length > 1 && (
						<a
							class="btn btn-secondary btn-sm reviews-etsy-link"
							href={etsyReviewsUrl}
							target="_blank"
							rel="noopener noreferrer"
							data-cta={`template_reviews_cta:${id}`}
						>
							See all Etsy reviews <span class="arrow">&rarr;</span>
						</a>
					)}
				</section>
			)}

			{(linkedArticles.length > 0 || (faq && faq.length > 0)) && (
				<section class="product-extras">
					<div class="product-extras-inner">
						{linkedArticles.length > 0 && (
							<div class="product-articles">
								<h2>Related articles</h2>
								<ul class="product-articles-list">
									{linkedArticles.map((a: any) => (
										<li>
											<a href={`/articles/${a.id}/`}>{a.data.title}</a>
										</li>
									))}
								</ul>
							</div>
						)}

						{faq && faq.length > 0 && (
							<div class="faq">
								<h2 class="faq-heading">Frequently asked questions</h2>
								<div class="faq-list">
									{faq.map(({ question, answer }: { question: string; answer: string }) => (
										<details class="faq-item">
											<summary class="faq-q">
												<span>{question}</span>
												<svg class="faq-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<polyline points="6 9 12 15 18 9" />
												</svg>
											</summary>
											<div class="faq-a-wrap">
												<p class="faq-a">{answer}</p>
											</div>
										</details>
									))}
								</div>
							</div>
						)}

					</div>
				</section>
			)}

			{otherTemplates.length > 0 && (
				<section class="other-templates">
					<h2>More spreadsheets</h2>
					<div class="other-templates-grid">
						{otherTemplates.map((t) => (
							<a href={`/spreadsheets/${t.id}/`} class="template-card">
								<div class="template-thumb">
									<img src={t.data.midImage} alt={`${t.data.title} preview`} width="600" height="400" loading="lazy" />
									{t.data.badge && <span class="badge badge-overlay">{t.data.badge}</span>}
								</div>
								<h3 class="template-name">{t.data.title.replace(/ for (Google )?Sheets & Excel$/, '')}</h3>
								<p class="template-desc">{t.data.description}</p>
							</a>
						))}
					</div>
				</section>
			)}
		</main>
		<Footer />

		<script is:inline define:vars={{ templateId, darkListing: darkListingUrl, lightListing: lightListingUrl, heroImage, lightImage }}>
			const toggle = document.getElementById(`theme-toggle-${templateId}`);
			const cta = document.getElementById(`cta-${templateId}`);
			const heroImg = document.getElementById(`hero-img-${templateId}`);

			if (toggle && cta) {
				toggle.addEventListener('click', (e) => {
					const btn = e.target.closest('.theme-btn');
					if (!btn) return;

					toggle.querySelectorAll('.theme-btn').forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');

					const theme = btn.dataset.theme;
					cta.href = theme === 'light' ? lightListing : darkListing;

					if (heroImg && lightImage) {
						heroImg.src = theme === 'light' ? lightImage : heroImage;
					}

					document.querySelectorAll('.bundle-card').forEach((card) => {
						card.href = theme === 'light' ? card.dataset.lightUrl : card.dataset.darkUrl;
					});
				});
			}

			document.querySelectorAll('.faq-item').forEach((details) => {
				const summary = details.querySelector('summary');
				const wrap = details.querySelector('.faq-a-wrap');
				if (!summary || !wrap) return;

				summary.addEventListener('click', (e) => {
					e.preventDefault();
					if (details.open) {
						wrap.style.gridTemplateRows = '0fr';
						wrap.addEventListener('transitionend', () => {
							details.open = false;
							wrap.style.gridTemplateRows = '';
						}, { once: true });
					} else {
						details.open = true;
					}
				});
			});
		</script>

		{reviews && reviews.length > 1 && (
			<script is:inline define:vars={{ templateId }}>
				const reviewsSection = document.getElementById(`reviews-${templateId}`);
				const stackEl = reviewsSection.querySelector('.reviews-quote-stack');
				const entryEls = Array.from(reviewsSection.querySelectorAll('[data-review-entry]'));
				const progressFill = reviewsSection.querySelector('[data-review-progress]');
				const progressTrack = reviewsSection.querySelector('.reviews-progress-track');
				const countEl = reviewsSection.querySelector('[data-review-count]');
				const prevBtn = reviewsSection.querySelector('[data-review-prev]');
				const nextBtn = reviewsSection.querySelector('[data-review-next]');
				const mobileQuery = window.matchMedia('(max-width: 720px)');
				const DURATION = 6500;
				let activeIndex = 0;
				let elapsed = 0;
				let lastTick = performance.now();
				let manualMode = false;
				let inView = false;

				function syncStackHeight() {
					if (mobileQuery.matches) return;
					const max = Math.max(...entryEls.map((el) => el.offsetHeight));
					stackEl.style.height = `${max}px`;
				}

				function setActive(index) {
					activeIndex = (index + entryEls.length) % entryEls.length;
					elapsed = 0;
					lastTick = performance.now();
					if (progressFill) {
						progressFill.style.transition = 'none';
						progressFill.style.width = '0%';
					}
					if (progressTrack) {
						progressTrack.style.display = manualMode ? 'none' : 'block';
					}
					if (countEl) {
						countEl.textContent = `${activeIndex + 1} of ${entryEls.length}`;
					}
					entryEls.forEach((el, i) => el.classList.toggle('is-active', i === activeIndex));
				}

				function tick(now) {
					if (!manualMode && inView && !mobileQuery.matches) {
						elapsed += now - lastTick;
						const progress = Math.min(1, elapsed / DURATION);
						if (progressFill) {
							progressFill.style.transition = 'none';
							progressFill.style.width = `${progress * 100}%`;
						}
						if (progress >= 1) {
							setActive(activeIndex + 1);
						}
					}
					lastTick = now;
					requestAnimationFrame(tick);
				}

				prevBtn?.addEventListener('click', () => {
					manualMode = true;
					setActive(activeIndex - 1);
				});
				nextBtn?.addEventListener('click', () => {
					manualMode = true;
					setActive(activeIndex + 1);
				});

				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						inView = entry.isIntersecting;
						if (inView) lastTick = performance.now();
					});
				}, { threshold: 0.5 });
				observer.observe(reviewsSection);

				let resizeTimer;
				window.addEventListener('resize', () => {
					clearTimeout(resizeTimer);
					resizeTimer = setTimeout(syncStackHeight, 150);
				});

				setActive(0);
				syncStackHeight();
				if (document.fonts && document.fonts.ready) {
					document.fonts.ready.then(syncStackHeight);
				}
				requestAnimationFrame(tick);
			</script>
		)}
	</body>
</html>

<style>
	.template-main {
		max-width: calc(var(--max-width) + var(--space-md) * 2);
		margin: 0 auto;
		padding: var(--space-lg) var(--space-md) var(--space-2xl);
	}

	/* ——— Product hero ——— */

	.product-hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-xl);
		align-items: center;
		margin-bottom: var(--space-2xl);
	}

	/* The "right-positioned" hero PNGs are pre-cropped at their right edge
	   (the laptop deliberately runs off the frame), so the image must be
	   pinned flush to the panel's right edge: left-only padding + right
	   object-position. Centering it exposes the bare crop edge mid-panel. */
	.product-image {
		position: relative;
		aspect-ratio: 10 / 9;
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-bg-panel);
		padding: 1.5rem 0 1.5rem 1.5rem;
	}

	.product-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: right center;
	}

	.product-info {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
	}

	/* Look comes from .badge; this only sets the gap to the product title. */
	.product-badge {
		margin-bottom: var(--space-sm);
	}

	.product-title {
		font-size: clamp(1.5rem, 2.5vw + 0.5rem, 2.25rem);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--space-xs);
	}

	.product-desc {
		font-size: var(--text-body);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
		margin-bottom: var(--space-md);
	}

	/* ——— Theme toggle ——— */

	.theme-toggle {
		display: inline-flex;
		gap: 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		padding: 0.1875rem;
		margin-bottom: var(--space-md);
	}

	.theme-btn {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		font-weight: var(--weight-normal);
		color: var(--color-text-muted);
		background: none;
		border: none;
		border-radius: var(--radius-full);
		padding: 0.375rem 1rem;
		cursor: pointer;
		transition: color 0.15s, background 0.15s;
	}

	.theme-btn:hover {
		color: var(--color-text);
	}

	.theme-btn.active {
		color: var(--color-bg-surface);
		background: var(--color-btn);
	}

	/* ——— Price ——— */

	/* Sits directly above the CTA rather than up by the title: the amount and
	   the action it commits you to are one decision, and Gestalt proximity
	   groups them by being closer to each other than to anything else. */
	.product-price {
		margin: 0 0 var(--space-sm);
		font-size: var(--text-h3);
		letter-spacing: var(--tracking-snug);
		color: var(--color-text);
	}

	/* ——— CTA ——— */

	.product-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		justify-content: center;
		margin-bottom: var(--space-md);
	}

	.product-platforms {
		display: flex;
		gap: var(--space-xs);
	}

	/* Look comes from .badge — these are the same kind of chip as the
	   "Best Seller" badge above them, so they should not read differently. */

	/* ——— Details (What's included + How it works) ——— */

	.product-details {
		margin-bottom: var(--space-2xl);
		padding: var(--space-xl) 0 0;
		border-top: 1px solid var(--color-border);
	}

	.detail-row {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: var(--space-2xl);
		align-items: start;
		padding: var(--space-xl) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.detail-row:first-child {
		padding-top: 0;
	}

	.detail-row:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.detail-row h2 {
		font-size: var(--text-h2);
		margin: 0;
	}

	/* Every row keeps the side-heading grid. Stacking the text-only ones was
	   tried and reverted: it fixed the emptiness beside a short paragraph but
	   broke the scan. "What's included" stayed two-column while the how-it-
	   works rows under it went full width, so the eye lost the heading rail
	   exactly where the page starts explaining the product. Consistency down
	   the column beat the per-row fit. */

	/* Two rows of three rather than a six-item stack. Every template carries
	   exactly six features, so the grid always fills; `auto-fit` would still
	   cope if one ever ran five or seven, leaving a short last row instead of
	   a gap in the middle.

	   The row dividers the vertical list used are gone. They were reading the
	   list as a table of successive rows, which is wrong for a set of
	   unordered peers, and in a grid they would have drawn a line under three
	   unrelated items at once. Gestalt proximity does the grouping now: each
	   icon sits tight to its own label, and the gaps between cells are wider
	   than the gap inside one. */
	.features-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		/* Row gap is --space-xl against a --space-md column gap. The two rows
		   need to read as two, and a uniform gap let them run together into one
		   six-cell field. Deliberately a step up the scale rather than a one-off
		   60px: it lands close to the 1.5x this was aiming for and stays on the
		   spacing ramp. */
		gap: var(--space-xl) var(--space-md);
	}

	/* Icon above the label, both flush left, rather than the icon inline beside
	   it. The stack gives every cell the same left edge for the eye to run
	   down, and it lets the label wrap to three lines without the second and
	   third lines hanging under the icon. */
	.features-list li {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-sm);
		font-size: var(--text-body);
		line-height: var(--leading-normal);
		color: var(--color-text);
	}

	/* Same fill as the sky eyebrow. The tint is only guaranteed against the
	   primary text role, so the glyph is --color-text and not the link slate
	   the icon used inline: 13.4:1 rather than 6.8:1, and well past the 3:1
	   WCAG 1.4.11 asks of a meaningful graphic. */
	.feature-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		background: var(--tint-sky);
		color: var(--color-text);
	}

	/* Colour and the optical nudge that used to align it to the first line of
	   an inline label both belong to `.feature-icon` now: the glyph is centred
	   in the disc, and the disc sits above the text rather than beside it. */
	.check-icon {
		flex-shrink: 0;
	}

	.howto-content p {
		font-size: var(--text-body);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
		margin: 0;
	}

	.howto-content img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
		margin-top: var(--space-md);
	}

	/* ——— Buyer's guide ——— */

	/* Long-form prose, so it takes a reading measure rather than the full
	   product width. Everything above it on this page is a grid or a media
	   row that wants the whole column; body copy set to that width runs well
	   past a comfortable line length.

	   The measure is centred, not left-aligned. Every section above this one
	   is a `1fr 2fr` row with its heading left and its copy starting midway
	   across, so a left-aligned column of the same width leaves the entire
	   right half of the section empty and reads as a detail-row that failed
	   to render its second cell rather than as a new section. */
	.product-guide {
		margin-bottom: var(--space-2xl);
		padding-top: var(--space-xl);
		border-top: 1px solid var(--color-border);
	}

	.product-guide .prose {
		max-width: 68ch;
		margin-inline: auto;
	}

	/* `.prose h2` carries a 2em top margin for headings that follow body copy.
	   The first one here sits directly under the section's own rule, where
	   that margin doubles the gap the padding already set.

	   `:global()` is load-bearing. The guide's markup arrives through
	   `set:html`, so none of it carries the `data-astro-cid-*` attribute that
	   Astro appends to every element selector in a scoped rule. Written plain,
	   this compiles to `> [data-astro-cid-…]:first-child` and silently matches
	   nothing. Only the two class names either side of it are real elements in
	   this template; anything selecting *inside* the prose has to opt out of
	   scoping the same way. */
	.product-guide .prose > :global(:first-child) {
		margin-top: 0;
	}

	/* Shares the prose measure and its centring, so the button reads as the
	   end of the column it follows rather than as a new full-width band.

	   The rule and the spacing belong to this wrapper, never to the button:
	   a border-top on a `.btn` draws a line straight across the pill. */
	.product-cta-footer {
		max-width: 68ch;
		margin: var(--space-lg) auto 0;
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	/* Full width on mobile, hugging its text from 600px up — the same shape
	   the calculator product links take sitewide. */
	.product-cta-footer .btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
	}

	@media (min-width: 600px) {
		.product-cta-footer .btn {
			display: inline-flex;
		}
	}

	/* ——— Bundles ——— */

	.product-bundles {
		margin-bottom: var(--space-2xl);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	.product-bundles h2 {
		font-size: var(--text-h2);
		margin-bottom: var(--space-md);
	}

	.bundles-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-md);
	}

	/* Same treatment as .template-card in the "More spreadsheets" grid further
	   down this very page — a panel-filled thumbnail sitting directly on the
	   page, with its label underneath. There is no card chrome.

	   The card wrapper this replaced put three surfaces in conflict: a white
	   card, a panel image well inside it, and the warm page behind, with a
	   border under the thumbnail redrawing the edge the tone change already
	   drew. It read as a grey block with a white strip stuck to the bottom,
	   and it was the only product surface on the site wearing a card at all. */
	.bundle-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		text-decoration: none;
		color: inherit;
	}

	.bundle-thumb {
		width: 100%;
		aspect-ratio: 3 / 2;
		border-radius: var(--radius-md);
		background: var(--color-bg-panel);
		padding: 0.75rem 1.5rem;
		overflow: hidden;
		transition: background 0.15s ease;
	}

	.bundle-thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
	}

	/* Hover darkens the thumbnail's container, matching the template and tool
	   cards. Pointer devices only. */
	@media (hover: hover) {
		.bundle-card:hover .bundle-thumb {
			background: var(--color-bg-emphasis);
		}
	}

	.bundle-text {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
	}

	.bundle-name {
		font-size: var(--text-body);
		font-weight: var(--weight-normal);
		color: var(--color-text);
	}

	.bundle-link {
		font-size: var(--text-small);
		font-weight: var(--weight-normal);
		color: var(--color-link);
		white-space: nowrap;
	}

	/* ——— Related articles + FAQ panel (full-bleed) ——— */

	/* A page-coloured section with a rule on top, like every other section on
