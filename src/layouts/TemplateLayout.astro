	/* ——— Other templates ——— */

	.other-templates {
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	.other-templates h2 {
		font-size: var(--text-h2);
		margin-bottom: var(--space-md);
	}

	.other-templates-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-md);
