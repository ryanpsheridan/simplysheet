	.product-reviews.is-multi {
		grid-template-areas: "quote nav" "quote cta";
	}
	.product-reviews.is-multi .reviews-quote-col {
		grid-area: quote;
	}
	.product-reviews.is-multi .reviews-name-col {
		grid-area: nav;
	}
	.product-reviews.is-multi .reviews-etsy-link {
		grid-area: cta;
		align-self: start;
		margin-top: var(--space-xl);
	}
	.reviews-quote-col {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}
	.review-stars {
		display: flex;
		gap: 0.125rem;
		color: var(--color-text-heading);
		margin-bottom: var(--space-md);
	}
	.reviews-quote-stack {
		position: relative;
	}
	.review-entry {
		display: flex;
		flex-direction: column;
	}
	.product-reviews.is-multi .review-entry {
