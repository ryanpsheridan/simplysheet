	.template-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		text-decoration: none;
		color: inherit;
	}
	/* Hover darkens the thumbnail's gray container (matches the tool
	   thumbnail cards), leaving the name/badge text untouched. */
	@media (hover: hover) {
		.template-card:hover .template-thumb {
			background: var(--color-bg-emphasis);
		}
