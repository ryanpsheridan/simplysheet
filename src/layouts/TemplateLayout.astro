	}

	/* ——— FAQ (matches article layout) ——— */

	.faq-heading {
		font-size: var(--text-h2);
		margin-bottom: var(--space-md);
	}

	.faq-list {
		display: flex;
		flex-direction: column;
	}

	.faq-item {
		border-bottom: 1px solid var(--color-border);
