		font-weight: var(--weight-normal);
		color: var(--color-text);
		cursor: pointer;
		list-style: none;
		transition: color 0.15s;
	}

	.faq-q::-webkit-details-marker { display: none; }
	.faq-q::marker { display: none; content: ''; }

	.faq-arrow {
