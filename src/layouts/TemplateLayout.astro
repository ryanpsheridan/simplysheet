	   the one recessed slab on an otherwise flat page. */
	.product-extras {
		margin-top: var(--space-2xl);
		margin-bottom: var(--space-2xl);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	/* The rule above spans the page container; the content inside keeps a
	   narrower measure, because related links and FAQ answers are running text
	   and a 1280px line length is unreadable. */
	.product-extras-inner {
		max-width: var(--max-width-narrow);
		margin: 0 auto;
	}

	.product-articles + .faq {
		margin-top: var(--space-lg);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	.product-articles h2 {
		font-size: var(--text-h2);
		margin-bottom: var(--space-md);
	}


	.product-articles-list {
		list-style: none;
		padding: 0;
	}

	/* Matches `.faq-q` exactly: --space-md rows under a --space-md heading gap.
