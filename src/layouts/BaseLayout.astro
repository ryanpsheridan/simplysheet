---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} noindex={noindex} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<Header />
		<slot />
		<Footer />
		<script>
			// Smooth scroll is a motion effect, so honour the OS-level request
			// for less of it. Lenis has no built-in reduced-motion handling, and
			// hijacking the scroll wheel is exactly what that preference is
			// meant to switch off; skipping init leaves native scrolling intact.
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const { default: Lenis } = await import('lenis');

				const lenis = new Lenis({
					duration: 0.72,
					easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					smoothWheel: true,
				});

				const raf = (time: number) => {
					lenis.raf(time);
					requestAnimationFrame(raf);
				};
				requestAnimationFrame(raf);
			}
		</script>
	</body>
</html>

<style is:global>
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
</style>
