---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { LEGAL_UPDATED } from '../consts';

// The shell for /privacy/ and /terms/: the page hero, then one narrow reading
// column of prose, like About.
interface Props {
	title: string;
	metaTitle: string;
	description: string;
}

const { title, metaTitle, description } = Astro.props;
const updated = LEGAL_UPDATED.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
		{ '@type': 'ListItem', position: 2, name: title },
	],
};
---

<BaseLayout title={metaTitle} description={description}>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	<main id="main-content" class="band-main">
		<PageHero title={title} desc={`Last updated ${updated}`} crumbs={[{ label: title }]} />
		<article class="band band--flush-top">
			<div class="prose legal-prose">
				<slot />
			</div>
		</article>
	</main>
</BaseLayout>

<style>
	.legal-prose {
		max-width: var(--max-width-narrow);
		margin-inline: auto;
	}
	.legal-prose > :global(:first-child) {
		margin-top: 0;
	}
	.legal-prose :global(h2) {
		scroll-margin-top: var(--header-offset);
	}
</style>
