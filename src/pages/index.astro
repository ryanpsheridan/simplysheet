---
import BaseLayout from '../layouts/BaseLayout.astro';
import TagPills from '../components/TagPills.astro';
import SpreadsheetsToolsRows from '../components/SpreadsheetsToolsRows.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE, TAG_MAP } from '../consts';

const allArticles = (await getCollection('articles'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((article) => {
		const wordCount = article.body?.split(/\s+/).filter(Boolean).length ?? 0;
		const readTime = Math.max(1, Math.ceil(wordCount / 200));
		return { ...article, readTime };
	});

const featuredSlug = '50-30-20-budget-rule';
const featured = allArticles.find((a) => a.id === featuredSlug) ?? allArticles[0];
const rest = allArticles.filter((a) => a.id !== featured.id);

const latest = rest.slice(0, 9);

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: SITE_TITLE,
	alternateName: 'Simply Sheet Design',
	url: Astro.site?.toString(),
	logo: new URL('/images/logo-256px.jpg', Astro.site).toString(),
	description: SITE_DESCRIPTION,
	founder: {
		'@type': 'Person',
		name: 'Ryan Sheridan',
	},
	sameAs: ['https://simplysheetdesign.etsy.com'],
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	alternateName: 'Simply Sheet Design',
	url: Astro.site?.toString(),
	description: SITE_DESCRIPTION,
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
	},
};
---

<BaseLayout title={`${SITE_TITLE} — Budget Templates, Tools & Money Guides`} description={SITE_DESCRIPTION}>
	<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	<main id="main-content" class="home-main">
	<section class="hero">
		<div class="hero-inner">
			<div class="hero-text">
				<h1 class="hero-title">A simpler way to manage your personal finances.</h1>
				<p class="hero-desc">Whether you are paying off debt or navigating an irregular income, find the guidance and tools you need to organize your money, stay on track, and move forward with confidence.</p>
			</div>
			{featured && (
				<a href={`/articles/${featured.id}/`} class="hero-featured" data-cta="index_hero_featured_article">
					{(featured.data.cardImage || featured.data.image) && (
						<div class="hero-featured-thumb">
							<img src={featured.data.cardImage ?? featured.data.image} alt={featured.data.title} width="960" height="540" fetchpriority="high" />
						</div>
					)}
					<TagPills tags={featured.data.tags} tagMap={TAG_MAP} />
					<h2 class="hero-featured-title">{featured.data.title}</h2>
					<p class="hero-featured-meta">
						<span>{featured.readTime} min read</span>
					</p>
				</a>
			)}
		</div>
	</section>

	<div class="section-divider"></div>

	<section class="home-rows">
		<div class="home-rows-inner">
			<SpreadsheetsToolsRows only="tools" toolLimit={6} />
			{latest.length > 0 && (
				<div class="home-row">
					<div class="home-row-label">
						<h2 class="home-row-heading">Latest</h2>
					</div>
					<div class="home-row-items">
						{latest.map((article) => (
							<a href={`/articles/${article.id}/`} class="home-row-item" data-cta={`index_latest_article_card:${article.id}`}>
								{(article.data.cardImage || article.data.image) && (
									<div class="home-row-thumb">
										<img src={article.data.cardImage ?? article.data.image} alt={article.data.title} width="960" height="540" loading="lazy" />
									</div>
								)}
								<div class="home-row-text">
									<TagPills tags={article.data.tags} tagMap={TAG_MAP} />
									<h3 class="home-row-title">{article.data.title}</h3>
									<span class="home-row-meta">{article.readTime} min read</span>
								</div>
							</a>
						))}
						<div class="home-row-viewall">
							<a href="/articles/" class="btn btn-secondary" data-cta="index_latest_view_all">All articles <span class="arrow">&rarr;</span></a>
						</div>
					</div>
				</div>
			)}
		</div>
	</section>

	{/* Spreadsheets breaks out of the shared rows into its own full-bleed band.
	    Four identical label-left grids in a row is what made the page read as
	    one flat texture, and this is the surface the site actually sells from,
	    so it is the one that earns the break. Surface rather than panel: the
	    product thumbs and their Best Seller chip are both built to sit on
	    panel, and a panel band would swallow them. */}
	<section class="home-band">
		<div class="home-rows-inner">
			<SpreadsheetsToolsRows only="spreadsheets" templateLimit={6} />
		</div>
	</section>

	<section class="quiz-banner">
		<div class="quiz-banner-inner">
			<h2 class="quiz-banner-heading">Which budgeting style actually fits you?</h2>
			<p class="quiz-banner-desc">Seven questions about how you already handle money, and a method that suits it. No email, no sign-up.</p>
			<a href="/quiz/budgeting-style/" class="btn btn-primary btn-lg" data-cta="index_quiz_banner_cta">Take the 60-second quiz</a>
		</div>
	</section>

	<section class="about-brief" id="about-brief">
		<div class="about-brief-inner">
			<div class="about-brief-label">Creating a sustainable system</div>
			<div class="about-brief-content">
				<p class="about-brief-body" id="about-text">I spent years frustrated by complicated budgeting apps that didn't fit my life. After six years of refining my own spreadsheet systems, I realized that clarity comes from simplicity, not extra features. I combined my background in UX design with my passion for personal finance to build the tools I wish I had from the start.</p>
				<a href="/about/" class="btn btn-secondary about-brief-link" data-cta="index_about_brief_cta">Read the full story <span class="arrow">&rarr;</span></a>
			</div>
		</div>
	</section>
	</main>
</BaseLayout>

<style>
	/* The global `main` rule constrains width and adds section padding, which
	   suits the inner pages but not this one — the homepage sections are
	   full-bleed and carry their own padding. The element is here for the
	   landmark and the skip link target, so its own layout is neutralised. */
	.home-main {
		max-width: none;
		padding: 0;
	}

	/* ——— Hero (2-col) ——— */

	.hero {
		padding: var(--space-section) var(--space-md);
	}
	.hero-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 0.75fr 1fr;
		gap: var(--space-xl);
		align-items: center;
	}
	.hero-text {
		display: flex;
		flex-direction: column;
	}
	/* No `font-weight` here on purpose. Headings take --weight-semibold from the
	   shared h1–h6 rule in global.css; a local override on a heading class is the
	   bug the Manrope switch fixed twice. */
	.hero-title {
		font-size: var(--text-display);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text-heading);
		margin-bottom: var(--space-sm);
	}
	.hero-desc {
		font-size: var(--text-body);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
		margin: 0;
	}
	.hero-featured {
		display: flex;
		flex-direction: column;
		text-decoration: none;
	}
	.hero-featured-thumb {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-md);
		overflow: hidden;
		margin-bottom: var(--space-md);
	}
	.hero-featured-thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: var(--radius-md);
	}
	.hero-featured-title {
		font-size: var(--text-h3);
		line-height: var(--leading-snug);
		color: var(--color-text);
		margin-bottom: var(--space-xs);
	}
	.hero-featured-meta {
		font-size: var(--text-small);
		color: var(--color-text-muted);
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.375rem;
	}

	/* ——— Section divider ——— */

	.section-divider {
		max-width: var(--max-width);
		margin: 0 auto;
		border-top: 1px solid var(--color-border);
	}

	/* ——— Spreadsheets band ———
	   The one full-bleed break in the page's rhythm. Surface, not panel: the
	   product thumbs are themselves `--color-bg-panel` and their Best Seller
	   chip is a surface fill with a border, so a panel band would flatten
	   both. On the warm page ground a clean white plane reads as lifted. */

	.home-band {
		padding: var(--space-xl) var(--space-md);
		background: var(--color-bg-surface);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	/* ——— Quiz banner ——— */

	.quiz-banner {
		padding: var(--space-xl) var(--space-md);
		background: var(--color-bg-panel);
		border-bottom: 1px solid var(--color-border);
		text-align: center;
	}
	.quiz-banner-inner {
		max-width: 40rem;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xs);
	}
	/* Was --text-body in --color-text-secondary, which made the site's best
	   low-commitment entry point quieter than the card titles above it. */
	.quiz-banner-heading {
		font-size: var(--text-h2);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		color: var(--color-text-heading);
		margin: 0;
	}
	.quiz-banner-desc {
		font-size: var(--text-read);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-sm);
		max-width: 34em;
	}

	/* ——— About brief ——— */

	.about-brief {
		padding: clamp(5rem, 12vw, 8rem) var(--space-md);
		background: var(--color-bg);
		color: var(--color-text);
	}
	.about-brief-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: var(--space-xl);
		align-items: start;
	}
	.about-brief-label {
		font-size: var(--text-body);
		font-weight: var(--weight-normal);
		color: var(--color-text-muted);
		padding-top: 0.35em;
	}
	.about-brief-content {
		max-width: 38rem;
	}
	.about-brief-body {
		font-size: clamp(1.5rem, 2vw + 0.4rem, 1.75rem);
		font-weight: var(--weight-normal);
		line-height: 1.5;
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin: 0;
	}
	:global(.about-brief-body .word) {
		color: var(--color-border-strong);
		transition: color 0.15s ease;
	}
	:global(.about-brief-body .word.lit) {
		color: var(--color-text);
	}
	.about-brief-link {
		margin-top: var(--space-md);
	}

	/* ——— Responsive ——— */

	@media (max-width: 960px) {
		.hero-inner {
			grid-template-columns: 1fr;
		}
		.about-brief-inner {
			grid-template-columns: 1fr;
			gap: var(--space-md);
		}
	}
</style>

<script>
	const textEl = document.getElementById('about-text');
	if (textEl) {
		const raw = textEl.textContent || '';
		textEl.innerHTML = raw.split(/(\s+)/).map(part =>
			/\S/.test(part) ? `<span class="word">${part}</span>` : part
		).join('');

		const words = textEl.querySelectorAll<HTMLSpanElement>('.word');
		words.forEach((w, i) => {
			w.style.transitionDelay = `${i * 3}ms`;
		});
		const section = document.getElementById('about-brief');
		let ticking = false;

		function updateWords() {
			if (!section) return;
			const rect = section.getBoundingClientRect();
			const vh = window.innerHeight;
			const start = vh * 0.45;
			const end = vh * 0.15;
			const progress = Math.max(0, Math.min(1, (start - rect.top) / (start - end)));
			const litCount = Math.round(progress * words.length);
			words.forEach((w, i) => w.classList.toggle('lit', i < litCount));
		}

		window.addEventListener('scroll', () => {
			if (!ticking) {
				requestAnimationFrame(() => { updateWords(); ticking = false; });
				ticking = true;
			}
		}, { passive: true });
		updateWords();
	}
</script>
