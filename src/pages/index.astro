			aspect-ratio: 4 / 3;
			border-radius: var(--radius-lg);
		}
		.stage-img--front {
			width: 86%;
			left: 7%;
			bottom: 8%;
		}
		.stage-img--left,
		.stage-img--right {
			width: 58%;
