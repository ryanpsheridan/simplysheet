</style>

<script>
	// Tools stage: preview whichever row has hover or focus.
	const rows = document.querySelectorAll<HTMLAnchorElement>('.tools-item');
	const arts = document.querySelectorAll<SVGElement>('.tools-stage-art');
	function activate(id: string | undefined) {
		if (!id) return;
		rows.forEach((r) => r.classList.toggle('is-active', r.dataset.tool === id));
		arts.forEach((a) => a.classList.toggle('is-active', a.dataset.tool === id));
	}
	rows.forEach((row) => {
		row.addEventListener('mouseenter', () => activate(row.dataset.tool));
		row.addEventListener('focus', () => activate(row.dataset.tool));
	});

	// About brief: words light up as the section scrolls into view.
	const textEl = document.getElementById('about-text');
	if (textEl) {
		const raw = textEl.textContent || '';
		textEl.innerHTML = raw.split(/(\s+)/).map(part =>
			/\S/.test(part) ? `<span class="word">${part}</span>` : part
		).join('');

		const words = textEl.querySelectorAll<HTMLSpanElement>('.word');
		words.forEach((w, i) => {
			w.style.transitionDelay = `${i * 3}ms`;
		});
		const section = document.getElementById('about-brief');
		let ticking = false;

		function updateWords() {
			if (!section) return;
			const rect = section.getBoundingClientRect();
			const vh = window.innerHeight;
			const start = vh * 0.75;
			const end = vh * 0.3;
			const progress = Math.max(0, Math.min(1, (start - rect.top) / (start - end)));
			const litCount = Math.round(progress * words.length);
			words.forEach((w, i) => w.classList.toggle('lit', i < litCount));
		}

		window.addEventListener('scroll', () => {
			if (!ticking) {
				requestAnimationFrame(() => { updateWords(); ticking = false; });
				ticking = true;
			}
		}, { passive: true });
		updateWords();
	}
</script>
