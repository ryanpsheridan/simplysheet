---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ToolCard from '../components/ToolCard.astro';
import Faq from '../components/Faq.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE, templateName } from '../consts';
import { TOOLS, toolId } from '../data/tools';
import { getSortedArticles, toArticleCard } from '../utils/articles';
// The editorial theme test. Scoped to this page: see the file's header.
import '../styles/theme-editorial.css';

const allArticles = await getSortedArticles();

const featuredSlug = 'how-to-split-bills-with-different-incomes';
const featuredEntry = allArticles.find((a) => a.id === featuredSlug) ?? allArticles[0];
const featured = toArticleCard(featuredEntry);

// Two rows of three under the featured card. Keep it a multiple of 3.
const latest = allArticles.filter((a) => a.id !== featured.id).slice(0, 6).map(toArticleCard);

const templates = (await getCollection('templates')).sort((a, b) => a.data.order - b.data.order);

// The hero stage: the best seller's dark mockup in front of a light-theme
// product. Both are the uncropped midImage assets, centered, per the
// product-image rule.
const byId = (id: string) => templates.find((t) => t.id === id);
const stageFront = byId('budget-spreadsheet') ?? templates[0];
const stageBack = byId('savings-goals-tracker');

// Three real Etsy reviews from the templates collection, one per product,
// for the charcoal band. Matched on the opening words of the review rather
// than the name, since several are signed "Etsy buyer"; a pick that no
// longer matches simply drops out rather than showing a hand-typed quote.
const REVIEW_PICKS: [string, string][] = [
	['budget-spreadsheet', 'This budget template was exactly'],
	['couples-budget-spreadsheet', 'This has been very helpful'],
	['savings-goals-tracker', 'This product is a great way'],
];
const reviews = REVIEW_PICKS.flatMap(([id, opening]) => {
	const template = byId(id);
	const review = template?.data.reviews?.find((r) => r.text.startsWith(opening));
	return template && review ? [{ ...review, template }] : [];
});

const tools = TOOLS.slice(0, 6);

const steps = [
	{
		label: 'Step one',
		title: 'Pick the sheet that fits',
		desc: 'Start with the budget, or go straight to debt, savings, net worth, or a shared budget for two.',
	},
	{
		label: 'Step two',
		title: 'Get your own copy',
		desc: 'Make your own copy in Google Sheets, or open the Excel file if you would rather work offline.',
	},
	{
		label: 'Step three',
		title: 'Log as you go',
		desc: 'Enter your income and spending. Totals, progress bars, and charts update on their own.',
	},
];

const faq = [
	{
		question: 'Do the spreadsheets work in Google Sheets and Excel?',
		answer: 'Yes. Every template comes as a Google Sheets file you copy into your own Drive and an Excel (.xlsx) file you can download and use offline.',
	},
	{
		question: 'Do I need to know how to use spreadsheets?',
		answer: 'No. The templates are ready to use out of the box. Enter your income, start logging expenses, and the formulas and progress bars handle the rest.',
	},
	{
		question: 'How is a spreadsheet different from a budgeting app?',
		answer: 'You own your data. There is no subscription, no ads, and no company that can shut down and take your history with it, and you can see every formula doing the math.',
	},
	{
		question: 'Can I change the categories?',
		answer: 'Yes. Common categories come pre-filled, and you can rename, add, or remove any of them to match how you actually spend.',
	},
	{
		question: 'Are the calculators really free?',
		answer: 'Yes. Every calculator and quiz on the site is free to use, runs in your browser, and asks for no email or sign-up.',
	},
];

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: SITE_TITLE,
	alternateName: 'Simply Sheet Design',
	url: Astro.site?.toString(),
	logo: new URL('/images/logo-256px.jpg', Astro.site).toString(),
	description: SITE_DESCRIPTION,
	founder: {
		'@type': 'Person',
		name: 'Ryan Sheridan',
	},
	sameAs: ['https://simplysheetdesign.etsy.com'],
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	alternateName: 'Simply Sheet Design',
	url: Astro.site?.toString(),
	description: SITE_DESCRIPTION,
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
	},
};
---

<BaseLayout theme="editorial" title={`${SITE_TITLE} | Budget Templates, Tools & Money Guides`} description={SITE_DESCRIPTION}>
	<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	<main id="main-content" class="band-main home">

	{/* Hero: copy left, a textured stage bleeding off the right edge */}
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-copy">
			<a href="/tools/" class="hero-pill" data-cta="index_hero_pill:tools">
				<span class="hero-pill-tag">Free</span>
				{TOOLS.length} calculators, no sign-up
				<span class="hero-pill-arrow" aria-hidden="true"></span>
			</a>
			<h1 id="hero-title" class="hero-title">A simpler way to manage your personal finances.</h1>
			<p class="hero-desc">Budget spreadsheets for Google Sheets and Excel, free calculators, and plain-language guides for paying off debt, saving, and living on an irregular income.</p>
			<div class="hero-actions">
				<a href="/spreadsheets/" class="btn btn-primary btn-lg btn-arrow" data-cta="index_hero_cta:spreadsheets">Browse spreadsheets</a>
				<a href="/tools/" class="btn btn-secondary btn-lg" data-cta="index_hero_cta:tools">Try a free calculator</a>
			</div>
			<p class="hero-note">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.75 2.75L16.5 9"/></svg>
				Works in Google Sheets and Excel
			</p>
		</div>

		{stageFront?.data.midImage && (
			<a href={`/spreadsheets/${stageFront.id}/`} class="hero-stage" data-cta={`index_showcase:${stageFront.id}`} aria-label={`${templateName(stageFront.data.title)}: view template`}>
				<span class="stage-field stage-field--sky" aria-hidden="true"></span>
				<span class="stage-field stage-field--ink" aria-hidden="true"></span>
				<span class="stage-field stage-field--rings" aria-hidden="true"></span>
				{stageBack?.data.midImageLight && (
					<img class="stage-img stage-img--back" src={stageBack.data.midImageLight} alt={`${templateName(stageBack.data.title)} in the light theme`} width="2000" height="1200" loading="lazy" />
				)}
				<img class="stage-img stage-img--front" src={stageFront.data.midImage} alt={`${templateName(stageFront.data.title)} in the dark theme`} width="2000" height="1200" fetchpriority="high" />
			</a>
		)}
	</section>

	{/* Intro: one statement and three plain facts */}
	<section class="band intro" aria-labelledby="intro-heading">
		<div class="band-inner">
			<h2 id="intro-heading" class="intro-title">Budget spreadsheets that actually get used.</h2>
			<ul class="intro-points">
				<li>
					<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="6" width="22" height="20" rx="2.5"/><path d="M5 12h22M5 19h22M13 12v14"/></svg>
					<span>Works in <strong>Google Sheets</strong> and <strong>Excel</strong>, online or off</span>
				</li>
				<li>
					<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.5 5H26v8.5L14.5 25 5 15.5z"/><circle cx="21.5" cy="9.5" r="1.5"/></svg>
					<span><strong>One-time purchase</strong>, with no subscription and no ads</span>
				</li>
				<li>
					<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="16" cy="16" r="10"/><path d="M16 6a10 10 0 0 0 0 20z" fill="currentColor"/></svg>
					<span><strong>Dark and light themes</strong> in every template</span>
				</li>
			</ul>
		</div>
	</section>

	{/* Statement into the charcoal review band */}
	{reviews.length > 0 && (
		<section class="reviews" aria-labelledby="reviews-heading">
			<p class="statement" aria-hidden="true">Own the math</p>
			<div class="band band--inverse reviews-band">
				<div class="band-inner">
					<h2 id="reviews-heading" class="reviews-title">From buyers on Etsy</h2>
					<ul class="reviews-list">
						{reviews.map((r) => (
							<li class="review">
								<blockquote class="review-quote">
									<p>&ldquo;{r.text}&rdquo;</p>
								</blockquote>
								<p class="review-by">
									<span class="review-name">{r.name}</span>
									<a href={`/spreadsheets/${r.template.id}/`} class="review-product" data-cta={`index_review_product:${r.template.id}`}>{templateName(r.template.data.title)}</a>
								</p>
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>
	)}

	{/* Spreadsheets */}
	<section class="band" aria-labelledby="spreadsheets-heading">
		<div class="band-inner">
			<SectionHead
				id="spreadsheets-heading"
				title="Spreadsheets built for one job each"
				desc="A budget, a debt tracker, a savings tracker, and more. Each one does its job well rather than trying to do everything."
				href="/spreadsheets/"
				linkLabel="All spreadsheets"
				cta="index_spreadsheets_view_all"
			/>
			<ProductGrid templates={templates} layout="bento" ctaPrefix="index_spreadsheets_card" />
		</div>
	</section>

	{/* How it works: three steps on one line */}
	<section class="band band--surface" aria-labelledby="steps-heading">
		<div class="band-inner">
			<SectionHead
				id="steps-heading"
				align="center"
				title="Set up in an afternoon. Keep it for years."
				desc="No bank logins, no app to learn. A spreadsheet you own, doing the math for you."
			/>
			<ol class="steps">
				{steps.map((step, i) => (
					<li class="step" style={`--step-tint: var(${['--tint-sky', '--tint-lavender', '--tint-sand'][i]})`}>
						<span class="step-label">{step.label}</span>
						<h3 class="step-title">{step.title}</h3>
						<p class="step-desc">{step.desc}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	{/* Free tools */}
	<section class="band" aria-labelledby="tools-heading">
		<div class="band-inner">
			<header class="display-head">
				<p class="kicker">Free tools</p>
				<h2 id="tools-heading" class="display-title">The math you keep putting off, done in a minute</h2>
				<div class="display-foot">
					<p class="display-desc">Calculators and quick assessments that run in your browser. No email, no sign-up.</p>
					<a href="/tools/" class="text-link" data-cta="index_tools_view_all">All {TOOLS.length} tools <span class="arrow">&rarr;</span></a>
				</div>
			</header>
			<div class="tools">
				{/* Decorative preview of whichever row has hover or focus. Every row
				    is a complete link on its own, and below 960px this is dropped. */}
				<div class="tools-stage" aria-hidden="true">
					{tools.map((tool, i) => (
						<svg class:list={['tools-stage-art', { 'is-active': i === 0 }]} data-tool={toolId(tool)} viewBox="0 0 240 160" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={tool.illustration} />
					))}
				</div>
				<div class="tools-list">
					{tools.map((tool, i) => (
						<ToolCard tool={tool} variant="row" active={i === 0} cta={`index_tools_item:${toolId(tool)}`} />
					))}
				</div>
			</div>
		</div>
	</section>

	{/* Quiz: the brand field, a big line, and a preview of question one */}
	<section class="quiz-band" aria-labelledby="quiz-heading">
		<div class="quiz-inner">
			<div class="quiz-copy">
				<p class="kicker">Budgeting style quiz</p>
				<h2 id="quiz-heading" class="quiz-title">Not sure where to start?</h2>
				<p class="quiz-desc">Seven questions about how you already handle money, and a budgeting style that suits it. No email, no sign-up.</p>
				<a href="/quiz/budgeting-style/" class="btn btn-primary btn-lg btn-arrow" data-cta="index_quiz_banner_cta">Take the 60-second quiz</a>
			</div>
			<div class="quiz-card" aria-hidden="true">
				<span class="window-dots"><i></i><i></i><i></i></span>
				<p class="quiz-card-count">Question 1 of 7</p>
				<p class="quiz-card-q">What is the first thing you do after getting paid?</p>
				<ul class="quiz-card-opts">
					<li>Move money into savings and bills right away</li>
					<li>Check my deposit, then move on</li>
					<li>Think about what I want to buy</li>
					<li>Try not to think about it</li>
				</ul>
			</div>
		</div>
	</section>

	{/* Articles */}
	<section class="band" aria-labelledby="articles-heading">
		<div class="band-inner">
			<SectionHead
				id="articles-heading"
				title="Guides that get to the point"
				desc="Straight answers on budgeting, debt, and saving, written by someone who runs these numbers every month."
				href="/articles/"
				linkLabel="All articles"
				cta="index_latest_view_all"
			/>
			<div class="home-featured">
				<ArticleCard article={featured} variant="feature" cta="index_featured_article" />
			</div>
			<div class="card-grid">
				{latest.map((article) => (
					<ArticleCard article={article} desc={false} cta={`index_latest_article_card:${article.id}`} />
				))}
			</div>
		</div>
	</section>

	{/* About note, on charcoal */}
	<section class="band band--inverse about-brief" id="about-brief" aria-label="About Simply Sheets">
		<div class="band-inner about-brief-inner">
			<p class="about-brief-body" id="about-text">I spent years frustrated by complicated budgeting apps that didn't fit my life. After six years of refining my own spreadsheet systems, I realized that clarity comes from simplicity, not extra features. I combined my background in UX design with my passion for personal finance to build the tools I wish I had from the start.</p>
			<a href="/about/" class="btn btn-inverse btn-lg btn-arrow about-brief-link" data-cta="index_about_brief_cta">Read the full story</a>
		</div>
	</section>

	{/* FAQ */}
	<section class="band">
		<div class="band-inner">
			<Faq
				layout="split"
				title="Questions before you start"
				desc="The short answers. Each spreadsheet page covers its own template in more detail."
				items={faq}
			/>
		</div>
	</section>

	{/* Closing: a window card on the textured field */}
	<section class="closing" aria-labelledby="closing-heading">
		<div class="closing-card">
			<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
			<h2 id="closing-heading" class="closing-title">A budget you own, for good.</h2>
			<p class="closing-desc">Pay once and keep it. Every template works in Google Sheets and Excel, in a dark or light theme.</p>
			<div class="closing-actions">
				<a href="/spreadsheets/" class="btn btn-primary btn-lg btn-arrow" data-cta="index_closing_cta:spreadsheets">Browse spreadsheets</a>
				<a href="/tools/" class="btn btn-secondary btn-lg" data-cta="index_closing_cta:tools">Try a free calculator</a>
			</div>
		</div>
	</section>
	</main>
</BaseLayout>

<style>
	/* Homepage-only layout. Tokens, buttons, cards, header, and footer for the
	   editorial theme live in src/styles/theme-editorial.css. */

	.home {
		/* The gutter every full-bleed piece measures from: the content column
		   is 75rem, centered, never closer than --space-md to the screen edge. */
		--gutter: max(var(--space-md), calc((100vw - var(--max-width-content)) / 2));
	}

	/* Shared texture layers for the stages. */
	.stage-field,
	.hero-stage::after,
	.quiz-band::after,
	.closing::before {
		pointer-events: none;
	}

	/* Hero */

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: clamp(var(--space-lg), 5vw, 5rem);
		align-items: center;
		padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 7rem) var(--gutter);
	}
	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-width: 0;
	}
	.hero-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: var(--space-lg);
		padding: 0.3125rem 0.75rem 0.3125rem 0.3125rem;
		border-radius: var(--radius-full);
		background: var(--color-bg-panel);
		font-size: 0.875rem;
		color: var(--color-text);
		text-decoration: none;
		transition: background-color var(--duration-fast) var(--ease-out);
	}
	.hero-pill:hover {
		background: var(--color-bg-emphasis);
		color: var(--color-text);
	}
	.hero-pill-tag {
		padding: 0.1875rem 0.5rem;
		border-radius: var(--radius-full);
		background: var(--color-brand);
		font-size: 0.8125rem;
		font-weight: var(--weight-medium);
	}
	.hero-pill-arrow {
		width: 0.875rem;
		height: 0.875rem;
		background-color: currentColor;
		-webkit-mask: var(--glyph-arrow) center / contain no-repeat;
		mask: var(--glyph-arrow) center / contain no-repeat;
		transition: transform var(--duration-base) var(--ease-out);
	}
	.hero-pill:hover .hero-pill-arrow {
		transform: translateX(2px);
	}
	.hero-title {
		font-size: var(--text-hero);
		line-height: var(--leading-display);
		letter-spacing: var(--tracking-hero);
		margin: 0;
		max-width: 9.5em;
		text-wrap: balance;
	}
	.hero-desc {
		font-size: var(--text-lead);
		line-height: 1.4;
		letter-spacing: -0.01em;
		margin: var(--space-md) 0 0;
		max-width: 30rem;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		margin-top: var(--space-lg);
	}
	.hero-note {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: var(--space-md) 0 0;
		font-size: 0.875rem;
		color: var(--color-text-secondary);
	}

	/* The stage: a collage of fields (sky, halftone ink, paper rings) under
	   two mockups, bleeding off the right edge of the screen. Both mockups
	   are midImage assets, centered in their boxes. */
	.hero-stage {
		position: relative;
		display: block;
		aspect-ratio: 1 / 0.92;
		border-radius: var(--radius-xl) 0 0 var(--radius-xl);
		background: var(--paper);
		overflow: hidden;
		isolation: isolate;
	}
	.hero-stage::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 3;
		background: var(--grain);
		opacity: 0.28;
		mix-blend-mode: multiply;
	}
	.stage-field {
		position: absolute;
		z-index: 0;
	}
	.stage-field--sky {
		left: 0;
		top: 10%;
		width: 46%;
		height: 62%;
		background:
			radial-gradient(80% 60% at 30% 20%, rgba(255, 255, 255, 0.45), transparent 70%),
			var(--tint-sky);
	}
	.stage-field--ink {
		right: 0;
		top: 0;
		width: 60%;
		height: 56%;
		background:
			radial-gradient(circle, rgba(176, 224, 255, 0.55) 1.1px, transparent 1.5px) 0 0 / 7px 7px,
			radial-gradient(70% 90% at 80% 0%, #3A4A5C, transparent 70%),
			#232323;
		-webkit-mask-image: linear-gradient(200deg, #000 35%, rgba(0, 0, 0, 0.85) 60%, rgba(0, 0, 0, 0.6));
		mask-image: linear-gradient(200deg, #000 35%, rgba(0, 0, 0, 0.85) 60%, rgba(0, 0, 0, 0.6));
	}
	.stage-field--rings {
		right: -12%;
		bottom: -26%;
		width: 70%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: repeating-radial-gradient(
			circle at 50% 50%,
			transparent 0 2.25rem,
			rgba(var(--shadow-rgb), 0.09) 2.25rem calc(2.25rem + 1.5px),
			transparent calc(2.25rem + 1.5px) 3rem
		);
	}
	.stage-img {
		position: absolute;
		height: auto;
		object-fit: contain;
		object-position: center;
		transition: transform var(--duration-slow) var(--ease-out);
	}
	.stage-img--front {
		z-index: 2;
		width: 84%;
		left: 6%;
		bottom: 9%;
		filter: drop-shadow(0 28px 40px rgba(var(--shadow-rgb), 0.28));
	}
	.stage-img--back {
		z-index: 1;
		width: 60%;
		right: 2%;
		top: 9%;
		opacity: 0.96;
	}
	@media (hover: hover) {
		.hero-stage:hover .stage-img--front { transform: translateY(-6px); }
		.hero-stage:hover .stage-img--back { transform: translate(6px, -4px); }
	}

	/* Intro */

	.intro {
		padding-top: 0;
	}
	.intro-title {
		font-size: var(--text-section);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		max-width: 11em;
		margin: 0 0 clamp(2.5rem, 5vw, 4rem);
	}
	.intro-points {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-md);
	}
	.intro-points li {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		font-size: 1rem;
		color: var(--color-text);
	}
	.intro-points svg {
		width: 2rem;
		height: 2rem;
		flex-shrink: 0;
	}
	.intro-points strong {
		font-weight: var(--weight-semibold);
	}

	/* Statement + reviews */

	.statement {
		margin: 0;
		padding: 0 var(--space-md);
		font-family: var(--font-heading);
		font-size: clamp(3.5rem, 11.5vw, 10rem);
		line-height: 0.9;
		letter-spacing: -0.05em;
		text-align: center;
		color: var(--color-text);
		/* The descender-free line sits on the band's top edge. */
		transform: translateY(0.1em);
	}
	.reviews-band {
