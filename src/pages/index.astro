---
import BaseLayout from '../layouts/BaseLayout.astro';
import TagPills from '../components/TagPills.astro';
import SpreadsheetsToolsRows from '../components/SpreadsheetsToolsRows.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE, TAG_MAP } from '../consts';

const allArticles = (await getCollection('articles'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((article) => {
		const wordCount = article.body?.split(/\s+/).filter(Boolean).length ?? 0;
		const readTime = Math.max(1, Math.ceil(wordCount / 200));
		return { ...article, readTime };
	});

const featuredSlug = '50-30-20-budget-rule';
const featured = allArticles.find((a) => a.id === featuredSlug) ?? allArticles[0];
const rest = allArticles.filter((a) => a.id !== featured.id);

// The hero rail is four uniform rows: the pinned featured article, then the
// next three. Latest starts after them — otherwise the same headlines appear
// twice on one screen.
const heroArticles = [featured, ...rest.slice(0, 3)];
const latest = rest.slice(3, 9);

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: SITE_TITLE,
	alternateName: 'Simply Sheet Design',
	url: Astro.site?.toString(),
	logo: new URL('/images/logo-256px.jpg', Astro.site).toString(),
	description: SITE_DESCRIPTION,
	founder: {
		'@type': 'Person',
		name: 'Ryan Sheridan',
	},
	sameAs: ['https://simplysheetdesign.etsy.com'],
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	alternateName: 'Simply Sheet Design',
	url: Astro.site?.toString(),
	description: SITE_DESCRIPTION,
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
	},
};
---

<BaseLayout title={`${SITE_TITLE} — Budget Templates, Tools & Money Guides`} description={SITE_DESCRIPTION}>
	<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	<main id="main-content" class="home-main">
	<section class="hero">
		<div class="hero-inner">
			<div class="hero-text">
				<h1 class="hero-title">Budget spreadsheets that actually get used.</h1>
				<p class="hero-desc">Plain-English guides, free calculators, and Google Sheets and Excel templates for people who have tried a budgeting app and quit by March.</p>
				<div class="hero-actions">
					<a href="/spreadsheets/" class="btn btn-primary btn-arrow" data-cta="index_hero_primary_cta">Browse the spreadsheets</a>
					{/* Tools, not the quiz: the header CTA and the banner further
					    down both already point at the quiz, and a third link to it
					    here would spend the hero's one secondary slot on a
					    destination the page sells twice over. This way the first
					    screen offers all three of the site's surfaces — buy,
					    calculate, read — with the articles in the rail beside it. */}
					<a href="/tools/" class="btn btn-secondary" data-cta="index_hero_secondary_cta">Try a free calculator</a>
				</div>
			</div>
			<ul class="hero-rail" aria-label="Featured articles">
				{heroArticles.map((article) => (
					<li>
						<a href={`/articles/${article.id}/`} data-cta={`index_hero_article:${article.id}`}>
							<span class="hero-rail-thumb">
								<img src={article.data.cardImage ?? article.data.image} alt={article.data.title} width="960" height="540" />
							</span>
							<span class="hero-rail-title">{article.data.title}</span>
							<span class="hero-rail-meta">{article.readTime} min</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<div class="section-divider"></div>

	<section class="home-rows">
		<div class="home-rows-inner">
			{latest.length > 0 && (
				<div class="home-row">
					<div class="home-row-label">
						<h2 class="home-row-heading">Latest</h2>
					</div>
					<div class="home-row-items">
						{latest.map((article) => (
							<a href={`/articles/${article.id}/`} class="home-row-item" data-cta={`index_latest_article_card:${article.id}`}>
								{(article.data.cardImage || article.data.image) && (
									<div class="home-row-thumb">
										<img src={article.data.cardImage ?? article.data.image} alt={article.data.title} width="960" height="540" loading="lazy" />
									</div>
								)}
								<div class="home-row-text">
									<TagPills tags={article.data.tags} tagMap={TAG_MAP} />
									<h3 class="home-row-title">{article.data.title}</h3>
									<span class="home-row-meta">{article.readTime} min read</span>
								</div>
							</a>
						))}
						<div class="home-row-viewall">
							<a href="/articles/" class="btn btn-secondary" data-cta="index_latest_view_all">All articles <span class="arrow">&rarr;</span></a>
						</div>
					</div>
				</div>
			)}
			<SpreadsheetsToolsRows only="tools" />
		</div>
	</section>

	{/* Spreadsheets breaks out of the shared rows into its own full-bleed band.
	    Four identical label-left grids in a row is what made the page read as
	    one flat texture, and this is the surface the site actually sells from,
	    so it is the one that earns the break. Surface rather than panel: the
	    product thumbs and their Best Seller chip are both built to sit on
	    panel, and a panel band would swallow them. */}
	<section class="home-band">
		<div class="home-rows-inner">
			<SpreadsheetsToolsRows only="spreadsheets" />
		</div>
	</section>

	<section class="quiz-banner">
		<div class="quiz-banner-inner">
			<h2 class="quiz-banner-heading">Which budgeting style actually fits you?</h2>
			<p class="quiz-banner-desc">Seven questions about how you already handle money, and a method that suits it. No email, no sign-up.</p>
			<a href="/quiz/budgeting-style/" class="btn btn-primary btn-lg" data-cta="index_quiz_banner_cta">Take the 60-second quiz</a>
		</div>
	</section>

	<section class="about-brief" id="about-brief">
		<div class="about-brief-inner">
			<div class="about-brief-label">Creating a sustainable system</div>
			<div class="about-brief-content">
				<p class="about-brief-body" id="about-text">I spent years frustrated by complicated budgeting apps that didn't fit my life. After six years of refining my own spreadsheet systems, I realized that clarity comes from simplicity, not extra features. I combined my background in UX design with my passion for personal finance to build the tools I wish I had from the start.</p>
				<a href="/about/" class="btn btn-secondary about-brief-link" data-cta="index_about_brief_cta">Read the full story <span class="arrow">&rarr;</span></a>
			</div>
		</div>
	</section>
	</main>
</BaseLayout>

<style>
	/* The global `main` rule constrains width and adds section padding, which
	   suits the inner pages but not this one — the homepage sections are
	   full-bleed and carry their own padding. The element is here for the
	   landmark and the skip link target, so its own layout is neutralised. */
	.home-main {
		max-width: none;
		padding: 0;
	}

	/* ——— Hero (2-col) ——— */

	.hero {
		padding: var(--space-section) var(--space-md);
	}
	/* `align-items: start`, never `center`. The text column is much shorter
	   than the article column beside it, so centring split the difference into
	   two equal voids above and below it — 318px of nothing across a 513px
	   row. Both columns start at the same line instead. */
	.hero-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-xl);
		align-items: start;
	}
	/* Children stay stretched (the flex default). `align-items: start` here
	   shrink-wraps every child to fit-content, which makes the mobile rule
	   that widens the buttons to 100% resolve against a fit-content parent
	   and quietly do nothing. */
	.hero-text {
		display: flex;
		flex-direction: column;
	}
	.hero-title {
		font-size: var(--text-display);
		font-weight: var(--weight-normal);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text-heading);
		margin-bottom: var(--space-sm);
	}
	/* Reading copy, not UI text: this is the one paragraph on the page a
	   stranger actually reads, and on a phone it is most of the first screen,
	   so it takes the token that steps up there. */
	.hero-desc {
		font-size: var(--text-read);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
		margin: 0;
		max-width: 34em;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-lg);
	}

	/* ——— Hero rail ———
	   Four uniform rows rather than one big card over three bare links. The
	   featured article keeps the first slot but not a different shape, so the
	   column reads as a list of ways in and the headlines — not one large
	   gradient — carry it. The thumbnails are deliberately small: they anchor
	   each row and give the stack a rhythm without competing with the H1. */

	.hero-rail {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border-hairline);
	}
	.hero-rail a {
		display: grid;
		grid-template-columns: 5rem minmax(0, 1fr) auto;
		gap: var(--space-sm);
		align-items: center;
		padding: var(--space-sm) 0;
		border-bottom: 1px solid var(--color-border-hairline);
		text-decoration: none;
		color: var(--color-text);
	}
	.hero-rail-thumb {
		display: block;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-bg-panel);
	}
	.hero-rail-thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	/* Two lines, then clamp. Headlines here run long enough to make a third
	   line likely once the column narrows, and an uneven stack of 2- and
	   4-line rows loses the rhythm the dividers are there to give it. */
	.hero-rail-title {
		font-size: var(--text-body);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.hero-rail-meta {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		white-space: nowrap;
	}
	@media (hover: hover) {
		.hero-rail a:hover .hero-rail-title {
			color: var(--color-link-hover);
			text-decoration: underline;
			text-underline-offset: 0.2em;
		}
	}

	/* ——— Section divider ——— */

	.section-divider {
		max-width: var(--max-width);
		margin: 0 auto;
		border-top: 1px solid var(--color-border);
	}

	/* ——— Spreadsheets band ———
	   The one full-bleed break in the page's rhythm. Surface, not panel: the
	   product thumbs are themselves `--color-bg-panel` and their Best Seller
	   chip is a surface fill with a border, so a panel band would flatten
	   both. On the warm page ground a clean white plane reads as lifted. */

	.home-band {
		padding: var(--space-xl) var(--space-md);
		background: var(--color-bg-surface);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	/* ——— Quiz banner ——— */

	.quiz-banner {
		padding: var(--space-xl) var(--space-md);
		background: var(--color-bg-panel);
		border-bottom: 1px solid var(--color-border);
		text-align: center;
	}
	.quiz-banner-inner {
		max-width: 40rem;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xs);
	}
	/* Was --text-body in --color-text-secondary, which made the site's best
	   low-commitment entry point quieter than the card titles above it. */
	.quiz-banner-heading {
		font-size: var(--text-h2);
		font-weight: var(--weight-normal);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		color: var(--color-text-heading);
		margin: 0;
	}
	.quiz-banner-desc {
		font-size: var(--text-read);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-sm);
		max-width: 34em;
	}

	/* ——— About brief ——— */

	.about-brief {
		padding: clamp(5rem, 12vw, 8rem) var(--space-md);
		background: var(--color-bg);
		color: var(--color-text);
	}
	.about-brief-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: var(--space-xl);
		align-items: start;
	}
	.about-brief-label {
		font-size: var(--text-body);
		font-weight: var(--weight-normal);
		color: var(--color-text-muted);
		padding-top: 0.35em;
	}
	.about-brief-content {
		max-width: 38rem;
	}
	.about-brief-body {
		font-size: clamp(1.5rem, 2vw + 0.4rem, 1.75rem);
		font-weight: var(--weight-normal);
		line-height: 1.5;
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin: 0;
	}
	:global(.about-brief-body .word) {
		color: var(--color-border-strong);
		transition: color 0.15s ease;
	}
	:global(.about-brief-body .word.lit) {
		color: var(--color-text);
	}
	.about-brief-link {
		margin-top: var(--space-md);
	}

	/* ——— Responsive ——— */

	@media (max-width: 960px) {
		.hero-inner {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}
		.about-brief-inner {
			grid-template-columns: 1fr;
			gap: var(--space-md);
		}
	}

	@media (max-width: 600px) {
		/* The thumbnail shrinks and the read time drops under the headline
		   rather than sitting beside it: held out to the right edge, it cost
		   the headline about a fifth of an already narrow column and pushed
		   every row into an ellipsis. */
		.hero-rail a {
			grid-template-columns: 4rem minmax(0, 1fr);
			gap: var(--space-2xs) var(--space-sm);
		}
		.hero-rail-thumb {
			grid-row: span 2;
			align-self: center;
		}
		.hero-rail-meta {
			grid-column: 2;
		}
		/* Both buttons keep `.btn`'s centred content when they stretch. Pinning
		   the arrow disc to the right edge with `space-between` was tried and
		   reverted: it left the primary's label hard left while the secondary
		   below it stayed centred, and stranded the disc a hundred pixels from
		   the words it belongs to. `.calc-product-link`, the site's other
		   full-width button, centres for the same reason.

		   `.btn-arrow` trades away its right padding so the disc can sit snug
		   inside a content-width pill; stretched to full width there is no
		   right edge to hug, so the symmetric padding comes back or the
		   centred group sits visibly off-centre. */
		.hero-actions .btn {
			width: 100%;
		}
		/* No padding override needed: `.btn`'s shorthand in the 960px block
		   already resets `.btn-arrow`'s clipped right padding (same
		   specificity, later in source order), so the stretched pill is
		   symmetric on its own. Don't add one back. */
	}
</style>

<script>
	const textEl = document.getElementById('about-text');
	if (textEl) {
		const raw = textEl.textContent || '';
		textEl.innerHTML = raw.split(/(\s+)/).map(part =>
			/\S/.test(part) ? `<span class="word">${part}</span>` : part
		).join('');

		const words = textEl.querySelectorAll<HTMLSpanElement>('.word');
		words.forEach((w, i) => {
			w.style.transitionDelay = `${i * 3}ms`;
		});
		const section = document.getElementById('about-brief');
		let ticking = false;

		function updateWords() {
			if (!section) return;
			const rect = section.getBoundingClientRect();
			const vh = window.innerHeight;
			const start = vh * 0.45;
			const end = vh * 0.15;
			const progress = Math.max(0, Math.min(1, (start - rect.top) / (start - end)));
			const litCount = Math.round(progress * words.length);
			words.forEach((w, i) => w.classList.toggle('lit', i < litCount));
		}

		window.addEventListener('scroll', () => {
			if (!ticking) {
				requestAnimationFrame(() => { updateWords(); ticking = false; });
				ticking = true;
			}
		}, { passive: true });
		updateWords();
	}
</script>
