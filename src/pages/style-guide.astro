---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';

const calcThumbs = [
	{
		name: '50/30/20 Budget Calculator',
		desc: 'Split take-home pay into needs, wants, and savings.',
		url: '/tools/50-30-20-budget-calculator/',
		svg: `
			<line x1="40" y1="35" x2="40" y2="125" stroke-width="1" opacity="0.25"/>
			<line x1="40" y1="55" x2="170" y2="55" stroke-width="3" opacity="0.9"/>
			<line x1="40" y1="80" x2="130" y2="80" stroke-width="3" opacity="0.6"/>
			<line x1="40" y1="105" x2="95" y2="105" stroke-width="3" opacity="0.4"/>
			<circle cx="170" cy="55" r="7" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="170" cy="55" r="2.5" fill="currentColor" stroke="none"/>
			<circle cx="130" cy="80" r="6" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="130" cy="80" r="2.2" fill="currentColor" stroke="none"/>
			<circle cx="95" cy="105" r="5" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="95" cy="105" r="2" fill="currentColor" stroke="none"/>
		`,
	},
	{
		name: 'Biweekly & Weekly Paycheck Calculator',
		desc: 'Budget around real paydays, including the extra one.',
		url: '/tools/biweekly-paycheck-calculator/',
		svg: `
			<rect x="40" y="30" width="160" height="100" rx="8" stroke-width="1.5" opacity="0.3"/>
			<line x1="70" y1="18" x2="70" y2="38" stroke-width="1.5" opacity="0.4"/>
			<line x1="170" y1="18" x2="170" y2="38" stroke-width="1.5" opacity="0.4"/>
			<line x1="40" y1="55" x2="200" y2="55" stroke-width="1" opacity="0.25"/>
			<path d="M55 100 L85 92 L115 78 L145 66 L175 60" stroke-width="1" stroke-dasharray="3 3" opacity="0.35"/>
			<circle cx="55" cy="100" r="4" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="55" cy="100" r="1.5" fill="currentColor" stroke="none"/>
			<circle cx="85" cy="92" r="4" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="85" cy="92" r="1.5" fill="currentColor" stroke="none"/>
			<circle cx="115" cy="78" r="7" opacity="0.2" fill="currentColor" stroke="none"/>
			<circle cx="115" cy="78" r="2.5" fill="currentColor" stroke="none"/>
			<circle cx="145" cy="66" r="4" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="145" cy="66" r="1.5" fill="currentColor" stroke="none"/>
			<circle cx="175" cy="60" r="4" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="175" cy="60" r="1.5" fill="currentColor" stroke="none"/>
		`,
	},
	{
		name: 'Bill Split Calculator',
		desc: 'Split shared bills fairly by income, not just in half.',
		url: '/tools/bill-split-calculator/',
		svg: `
			<circle cx="95" cy="80" r="38" stroke-width="1.5" opacity="0.5"/>
			<circle cx="145" cy="80" r="38" stroke-width="1.5" opacity="0.5"/>
			<line x1="120" y1="32" x2="120" y2="128" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6"/>
			<line x1="60" y1="80" x2="110" y2="20" stroke-width="1" opacity="0.25"/>
			<circle cx="95" cy="80" r="4" opacity="0.2" fill="currentColor" stroke="none"/>
			<circle cx="95" cy="80" r="1.6" fill="currentColor" stroke="none"/>
			<circle cx="145" cy="80" r="4" opacity="0.2" fill="currentColor" stroke="none"/>
			<circle cx="145" cy="80" r="1.6" fill="currentColor" stroke="none"/>
		`,
	},
	{
		name: 'Debt Strategy Comparison',
		desc: 'See snowball and avalanche side by side.',
		url: '/tools/debt-snowball-vs-avalanche-calculator/',
		svg: `
			<line x1="50" y1="130" x2="200" y2="130" stroke-width="1" opacity="0.2"/>
			<path d="M50 40 C 70 75, 95 110, 150 130" stroke-width="2" opacity="0.9"/>
			<path d="M50 40 C 130 42, 180 70, 200 130" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.5"/>
			<circle cx="50" cy="40" r="6" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="50" cy="40" r="2.2" fill="currentColor" stroke="none"/>
			<circle cx="150" cy="130" r="7" opacity="0.2" fill="currentColor" stroke="none"/>
			<circle cx="150" cy="130" r="2.5" fill="currentColor" stroke="none"/>
			<circle cx="200" cy="130" r="5" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="200" cy="130" r="2" fill="currentColor" stroke="none"/>
		`,
	},
	{
		name: 'Emergency Fund Calculator',
		desc: 'Know exactly how many months of coverage you need.',
		url: '/tools/emergency-fund-calculator/',
		svg: `
			<rect x="70" y="30" width="100" height="110" rx="12" stroke-width="1.5" opacity="0.4"/>
			<line x1="70" y1="70" x2="170" y2="70" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.4"/>
			<line x1="70" y1="90" x2="170" y2="90" stroke-width="2" opacity="0.9"/>
			<line x1="176" y1="40" x2="184" y2="40" stroke-width="1" opacity="0.35"/>
			<line x1="176" y1="55" x2="184" y2="55" stroke-width="1" opacity="0.35"/>
			<line x1="176" y1="70" x2="184" y2="70" stroke-width="1" opacity="0.35"/>
			<line x1="176" y1="85" x2="184" y2="85" stroke-width="1" opacity="0.35"/>
			<circle cx="170" cy="90" r="6" opacity="0.2" fill="currentColor" stroke="none"/>
			<circle cx="170" cy="90" r="2.2" fill="currentColor" stroke="none"/>
		`,
	},
	{
		name: 'Sinking Fund Calculator',
		desc: 'Hit a savings goal by a set date, one month at a time.',
		url: '/tools/sinking-fund-calculator/',
		svg: `
			<circle cx="120" cy="80" r="45" stroke-width="1.5" opacity="0.2"/>
			<circle cx="120" cy="80" r="30" stroke-width="1.5" opacity="0.3"/>
			<circle cx="120" cy="80" r="15" stroke-width="1.5" opacity="0.4"/>
			<line x1="120" y1="80" x2="120" y2="55" stroke-width="2" opacity="0.85"/>
			<circle cx="120" cy="80" r="3" fill="currentColor" stroke="none"/>
			<circle cx="120" cy="55" r="4" opacity="0.2" fill="currentColor" stroke="none"/>
			<circle cx="120" cy="55" r="1.6" fill="currentColor" stroke="none"/>
			<circle cx="120" cy="35" r="7" opacity="0.25" fill="currentColor" stroke="none"/>
			<circle cx="120" cy="35" r="2.5" fill="currentColor" stroke="none"/>
		`,
	},
	{
		name: 'Expense Tracking Readiness',
		desc: "Find out if you've tracked enough to build a budget.",
		url: '/tools/expense-tracking-readiness/',
		svg: `
			<rect x="55" y="25" width="130" height="115" rx="8" stroke-width="1.5" opacity="0.3"/>
			<rect x="100" y="18" width="40" height="14" rx="4" stroke-width="1.5" opacity="0.4"/>
			<line x1="80" y1="55" x2="155" y2="55" stroke-width="1" opacity="0.25"/>
			<line x1="80" y1="80" x2="155" y2="80" stroke-width="1" opacity="0.25"/>
			<line x1="80" y1="105" x2="130" y2="105" stroke-width="1" stroke-dasharray="3 3" opacity="0.3"/>
			<path d="M62 55 L66 59 L74 49" stroke-width="1.5" opacity="0.9"/>
			<path d="M62 80 L66 84 L74 74" stroke-width="1.5" opacity="0.9"/>
			<circle cx="68" cy="105" r="5" stroke-width="1.2" opacity="0.35" fill="none"/>
		`,
	},
	{
		name: 'Sinking Fund Assessment',
		desc: 'Figure out where an expense actually belongs.',
		url: '/tools/sinking-fund-assessment/',
		svg: `
			<circle cx="65" cy="80" r="7" opacity="0.2" fill="currentColor" stroke="none"/>
			<circle cx="65" cy="80" r="2.5" fill="currentColor" stroke="none"/>
			<path d="M72 76 C 110 55, 140 45, 175 40" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.45"/>
			<path d="M72 84 C 110 105, 140 115, 175 120" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.45"/>
			<line x1="72" y1="80" x2="185" y2="80" stroke-width="2" opacity="0.9"/>
			<circle cx="175" cy="40" r="5" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="175" cy="40" r="2" fill="currentColor" stroke="none"/>
			<circle cx="175" cy="120" r="5" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="175" cy="120" r="2" fill="currentColor" stroke="none"/>
			<circle cx="185" cy="80" r="7" opacity="0.25" fill="currentColor" stroke="none"/>
			<circle cx="185" cy="80" r="2.5" fill="currentColor" stroke="none"/>
		`,
	},
	{
		name: 'Find Your Budgeting Style',
		desc: 'A 60-second quiz to find your money personality.',
		url: '/quiz/budgeting-style/',
		svg: `
			<line x1="120" y1="80" x2="120" y2="35" stroke-width="1" stroke-dasharray="4 4" opacity="0.3"/>
			<line x1="120" y1="80" x2="165" y2="80" stroke-width="1" stroke-dasharray="4 4" opacity="0.3"/>
			<line x1="120" y1="80" x2="120" y2="125" stroke-width="1" stroke-dasharray="4 4" opacity="0.3"/>
			<line x1="120" y1="80" x2="75" y2="80" stroke-width="2" opacity="0.9"/>
			<circle cx="120" cy="80" r="3" fill="currentColor" stroke="none"/>
			<circle cx="120" cy="35" r="4" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="120" cy="35" r="1.6" fill="currentColor" stroke="none"/>
			<circle cx="165" cy="80" r="4" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="165" cy="80" r="1.6" fill="currentColor" stroke="none"/>
			<circle cx="120" cy="125" r="4" opacity="0.15" fill="currentColor" stroke="none"/>
			<circle cx="120" cy="125" r="1.6" fill="currentColor" stroke="none"/>
			<circle cx="75" cy="80" r="7" opacity="0.25" fill="currentColor" stroke="none"/>
			<circle cx="75" cy="80" r="2.5" fill="currentColor" stroke="none"/>
		`,
	},
];

const allArticles = (await getCollection('articles'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const sampleArticles = allArticles.slice(0, 3).map((a) => {
	const wordCount = a.body?.split(/\s+/).filter(Boolean).length ?? 0;
	const readTime = Math.max(1, Math.ceil(wordCount / 200));
	return { ...a, readTime };
});

const templates = (await getCollection('templates'))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 2)
	.map((t) => ({
		name: t.data.title.replace(/ for (Google )?Sheets & Excel$/, ''),
		desc: t.data.description,
		url: `/spreadsheets/${t.id}/`,
		image: t.data.heroImage,
		badge: t.data.badge,
	}));

const TAG_MAP: Record<string, string> = {
	'expense-tracking': 'Expense Tracking',
	'couples-budgeting': 'Couples Budgeting',
	'debt-payoff': 'Debt Payoff',
	'savings-goals': 'Savings Goals',
	'irregular-income': 'Irregular Income',
	'net-worth': 'Net Worth',
	'budgeting-styles': 'Budgeting Styles',
};

const colors = [
	{ token: '--color-text',           label: 'Text',           hex: '#1A1A1A' },
	{ token: '--color-text-secondary', label: 'Text Secondary', hex: '#5C5C5C' },
	{ token: '--color-text-muted',     label: 'Text Muted',     hex: '#8A8A8A' },
	{ token: '--color-link',           label: 'Link',           hex: '#5C5C5C' },
	{ token: '--color-link-hover',     label: 'Link Hover',     hex: '#000000' },
	{ token: '--color-btn',            label: 'Button',         hex: '#000000' },
	{ token: '--color-btn-hover',      label: 'Button Hover',   hex: '#333333' },
	{ token: '--color-bg',             label: 'Background',     hex: '#FFFFFF' },
	{ token: '--color-bg-surface',     label: 'Surface',        hex: '#FFFFFF' },
	{ token: '--color-bg-panel',       label: 'Panel',          hex: '#F2F2F2' },
	{ token: '--color-bg-emphasis',    label: 'Emphasis',       hex: '#ECECEC' },
	{ token: '--color-bg-inverse',     label: 'Inverse',        hex: '#000000' },
	{ token: '--color-border',         label: 'Border',         hex: '#E0E0E0' },
];

const typeScale = [
	{ token: '--text-display', label: 'Display',  sample: 'Practical budgeting help' },
	{ token: '--text-h1',      label: 'H1',       sample: 'Page heading' },
	{ token: '--text-h2',      label: 'H2',       sample: 'Section heading' },
	{ token: '--text-h3',      label: 'H3',       sample: 'Subsection heading' },
	{ token: '--text-body-lg', label: 'Body Lg',  sample: 'Introductory paragraph text at a comfortable reading size.' },
	{ token: '--text-body',    label: 'Body',     sample: 'Standard paragraph text for articles and general content.' },
	{ token: '--text-small',   label: 'Small',    sample: 'Captions, labels, metadata' },
	{ token: '--text-xs',      label: 'XS',       sample: 'Fine print, timestamps' },
];

const spacingScale = [
	{ token: '--space-2xs', label: '2xs', px: '4' },
	{ token: '--space-xs',  label: 'xs',  px: '8' },
	{ token: '--space-sm',  label: 'sm',  px: '16' },
	{ token: '--space-md',  label: 'md',  px: '24' },
	{ token: '--space-lg',  label: 'lg',  px: '40' },
	{ token: '--space-xl',  label: 'xl',  px: '64' },
	{ token: '--space-2xl', label: '2xl', px: '96' },
];

// Explored but not shipped: tool thumbnails (article-style mesh background with
// the tool's own UI cropped into the bottom-right). The tools index and
// "More free tools" lists kept the icon treatment; these are kept for reference.
const toolThumbnails = [
	{ name: '50/30/20 Budget Calculator',            src: '/images/tool-thumb-50-30-20-budget-calculator.svg' },
	{ name: 'Biweekly & Weekly Paycheck Calculator', src: '/images/tool-thumb-biweekly-paycheck-calculator.svg' },
	{ name: 'Debt Strategy Comparison',              src: '/images/tool-thumb-debt-snowball-vs-avalanche-calculator.svg' },
	{ name: 'Emergency Fund Calculator',             src: '/images/tool-thumb-emergency-fund-calculator.svg' },
	{ name: 'Sinking Fund Calculator',               src: '/images/tool-thumb-sinking-fund-calculator.svg' },
	{ name: 'Expense Tracking Readiness',            src: '/images/tool-thumb-expense-tracking-readiness.svg' },
	{ name: 'Sinking Fund Assessment',               src: '/images/tool-thumb-sinking-fund-assessment.svg' },
	{ name: 'Find Your Budgeting Style',             src: '/images/tool-thumb-budgeting-style-quiz.svg' },
];
---

<BaseLayout title={`Style Guide — ${SITE_TITLE}`} description="Living reference for Simply Sheets components, tokens, and patterns." noindex>
	<div class="guide">

		<header class="guide-header">
			<h1>Style Guide</h1>
			<p class="guide-intro">Living reference for every component, token, and pattern in the design system.</p>
		</header>

		<!-- ============ COLORS ============ -->
		<section class="guide-section">
			<h2 class="section-title">Colors</h2>
			<div class="color-grid">
				{colors.map((c) => (
					<div class="color-card">
						<div class="color-swatch" style={`background-color: var(${c.token})`} />
						<div class="color-info">
							<span class="color-label">{c.label}</span>
							<code class="color-token">{c.token}</code>
							<span class="color-hex">{c.hex}</span>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- ============ TYPE SCALE ============ -->
		<section class="guide-section">
			<h2 class="section-title">Type Scale</h2>
			<div class="type-list">
				{typeScale.map((t) => (
					<div class="type-row">
						<div class="type-meta">
							<span class="type-label">{t.label}</span>
							<code class="type-token">{t.token}</code>
						</div>
						<div class="type-sample" style={`font-size: var(${t.token})`}>
							{t.sample}
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- ============ FONT WEIGHTS ============ -->
		<section class="guide-section">
			<h2 class="section-title">Font Weights</h2>
			<div class="weight-list">
				<p style="font-weight: var(--weight-normal)">400 Normal — The quick brown fox jumps over the lazy dog</p>
				<p style="font-weight: var(--weight-medium)">500 Medium — The quick brown fox jumps over the lazy dog</p>
				<p style="font-weight: var(--weight-semibold)">600 Semibold — The quick brown fox jumps over the lazy dog</p>
				<p style="font-weight: var(--weight-bold)">700 Bold — The quick brown fox jumps over the lazy dog</p>
			</div>
		</section>

		<!-- ============ SPACING ============ -->
		<section class="guide-section">
			<h2 class="section-title">Spacing Scale</h2>
			<div class="spacing-list">
				{spacingScale.map((s) => (
					<div class="spacing-row">
						<code class="spacing-token">{s.token}</code>
						<span class="spacing-px">{s.px}px</span>
						<div class="spacing-bar" style={`width: var(${s.token})`} />
					</div>
				))}
			</div>
		</section>

		<!-- ============ HEADLINE TREATMENTS ============ -->
		<section class="guide-section">
			<h2 class="section-title">Headline Treatments</h2>
			<p class="section-desc">Hero headlines use the display size. Section headings use H2.</p>

			<div class="headline-demo">
				<h1 class="demo-display">Practical budgeting help for people who use <span class="accent">Google Sheets and Excel</span></h1>
			</div>

			<div class="headline-demo">
				<h2 class="demo-h2">How do you budget when your <span class="accent">income changes every month</span></h2>
			</div>
		</section>

		<!-- ============ ARTICLE LIST ============ -->
		<section class="guide-section">
			<h2 class="section-title">Article List</h2>
			<p class="section-desc">Articles are displayed as a clean list with thin dividers between items.</p>

			<ul class="article-list">
				<li>
					<a href="#" class="article-card">
						<h3 class="article-title">How to budget when your income changes every month</h3>
						<p class="article-desc">A straightforward approach to budgeting on irregular income — freelancers, gig workers, commission earners.</p>
						<p class="article-date"><FormattedDate date={new Date('2026-06-23')} /></p>
					</a>
				</li>
				<li>
					<a href="#" class="article-card">
						<h3 class="article-title">The 15-minute weekly budget check-in</h3>
						<p class="article-desc">You don't need to track every coffee. Once a week, sit down for 15 minutes, enter your totals, and move on.</p>
						<p class="article-date"><FormattedDate date={new Date('2026-06-16')} /></p>
					</a>
				</li>
			</ul>
		</section>

		<!-- ============ CARDS: EDITORIAL (HOMEPAGE) ============ -->
		<section class="guide-section">
			<h2 class="section-title">Article Card — Editorial</h2>
			<p class="section-desc">Used on the homepage. Thumbnail image on top with text below — no containing card or border. Uses the <code>cardImage</code> SVG.</p>
			<div class="card-demo-grid card-demo-3col">
				{sampleArticles.map((article) => (
					<a href={`/articles/${article.id}/`} class="editorial-card">
						{(article.data.cardImage || article.data.image) && (
							<div class="editorial-card-thumb">
								<img src={article.data.cardImage ?? article.data.image} alt={article.data.title} width="960" height="540" loading="lazy" />
							</div>
						)}
						{(article.data.tags ?? []).length > 0 && (
							<div class="demo-card-tags">
								{(article.data.tags ?? []).map((tag: string) => (
									<span class="demo-card-tag">{TAG_MAP[tag] ?? tag}</span>
								))}
							</div>
						)}
						<h3 class="editorial-card-title">{article.data.title}</h3>
						<p class="editorial-card-desc">{article.data.description}</p>
						<p class="editorial-card-meta">
							<FormattedDate date={article.data.pubDate} />
							<span>&middot;</span>
							<span>{article.readTime} min read</span>
						</p>
					</a>
				))}
			</div>
		</section>

		<!-- ============ CARDS: CONTAINED (ARTICLES INDEX) ============ -->
		<section class="guide-section">
			<h2 class="section-title">Article Card — Contained</h2>
			<p class="section-desc">Used on the articles index page. Thumbnail + text inside a bordered card with subtle hover shadow. Uses <code>cardImage</code> SVG.</p>
			<div class="card-demo-grid card-demo-3col">
				{sampleArticles.map((article) => (
					<a href={`/articles/${article.id}/`} class="contained-card">
						{(article.data.cardImage || article.data.image) && (
							<div class="contained-card-thumb">
								<img src={article.data.cardImage ?? article.data.image} alt={article.data.title} width="960" height="540" loading="lazy" />
							</div>
						)}
						<div class="contained-card-body">
							{(article.data.tags ?? []).length > 0 && (
								<div class="demo-card-tags">
									{(article.data.tags ?? []).map((tag: string) => (
										<span class="demo-card-tag">{TAG_MAP[tag] ?? tag}</span>
									))}
								</div>
							)}
							<h3 class="contained-card-title">{article.data.title}</h3>
							<p class="contained-card-desc">{article.data.description}</p>
							<p class="contained-card-meta">
								<FormattedDate date={article.data.pubDate} />
								<span>&middot;</span>
								<span>{article.readTime} min read</span>
							</p>
						</div>
					</a>
				))}
			</div>
		</section>


		<!-- ============ CALCULATOR THUMBNAILS ============ -->
		<section class="guide-section">
			<h2 class="section-title">Calculator Thumbnail — Line Art (WIP)</h2>
			<p class="section-desc">Second pass: bespoke illustrations (not scaled-up nav icons) built from the same grid-snapped hairline language as the article wireframes — dashed secondary paths, compound node markers, no gradient or color. Light mode, left-aligned title + one-line description below the illustration, matching a directory-card layout.</p>
			<div class="calc-thumb-grid">
				{calcThumbs.map((item) => (
					<a href={item.url} class="calc-thumb-card">
