---
import { readFileSync, readdirSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ToolCard from '../components/ToolCard.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import EmergencyFundCalculator from '../components/EmergencyFundCalculator.astro';
import TagPills from '../components/TagPills.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, TAG_MAP } from '../consts';
import { TOOLS, toolId } from '../data/tools';
import { getSortedArticles, toArticleCard } from '../utils/articles';

// A living reference that renders the real components, never look-alike demo
// markup, so it cannot drift from the site. Token values are read from
// tokens.css at build time for the same reason: the hex under each swatch
// used to be a hand-typed string, and three of them had gone stale.

const tokensCss = readFileSync(path.resolve('src/styles/tokens.css'), 'utf8');
const rootBlock = tokensCss.slice(0, tokensCss.indexOf('@media'));
const tokenValue = (name: string) =>
	rootBlock.match(new RegExp(`${name}:\\s*([^;]+);`))?.[1].trim().replace(/\s+/g, ' ') ?? '';

const colorTokens = [
	['--color-text', 'Text'],
	['--color-text-secondary', 'Text secondary'],
	['--color-text-muted', 'Text muted'],
	['--color-link', 'Link'],
	['--color-btn', 'Button'],
	['--color-btn-hover', 'Button hover'],
	['--color-bg', 'Page'],
	['--color-bg-surface', 'Surface'],
	['--color-bg-panel', 'Panel'],
	['--color-bg-emphasis', 'Emphasis'],
	['--color-bg-inverse', 'Inverse'],
	['--color-border-hairline', 'Border hairline'],
	['--color-border', 'Border'],
	['--color-border-strong', 'Border strong'],
	['--tint-sky', 'Brand sky'],
	['--tint-lavender', 'Brand lavender'],
].map(([token, label]) => ({ token, label, value: tokenValue(token) }));

const gradientTokens = [
	['--gradient-glow', 'Glow', 'The homepage showcase stage.'],
	['--gradient-media', 'Media', 'Behind every product mockup.'],
	['--gradient-brand', 'Brand', 'CtaBanner. Ink text only.'],
	['--gradient-ink', 'Ink', 'Tool illustration stages.'],
];

const typeScale = [
	['--text-hero', 'Hero', 'A simpler way to budget'],
	['--text-display', 'Display', 'Page hero title'],
	['--text-section', 'Section', 'Band heading'],
	['--text-h1', 'H1', 'Page heading'],
	['--text-h2', 'H2', 'Content block heading'],
	['--text-h3', 'H3', 'Subsection heading'],
	['--text-h4', 'H4', 'Card title'],
	['--text-body-lg', 'Body lg', 'Standfirst under a hero headline.'],
	['--text-read', 'Read', 'Reading copy. 16px, 18px on a phone.'],
	['--text-body', 'Body', 'UI text: buttons, nav, labels.'],
	['--text-small', 'Small', 'Card descriptions and captions'],
	['--text-xs', 'XS', 'Meta, read time, fine print'],
];

const spacingScale = ['--space-2xs', '--space-xs', '--space-sm', '--space-md', '--space-lg', '--space-xl', '--space-2xl'];

const radii = [
	['--radius-sm', 'Code, skip link'],
	['--radius-md', 'Prose images'],
	['--radius-card', 'Every card and card media'],
	['--radius-inset', 'Media inset in a framed card'],
	['--radius-xl', 'Stages and banners'],
	['--radius-full', 'Buttons, badges, pills'],
];

const articles = (await getSortedArticles()).map(toArticleCard);
const [featuredSample, ...restSamples] = articles;
const gridSamples = restSamples.slice(0, 3);
const compactSamples = restSamples.slice(3, 6);

const templates = (await getCollection('templates')).sort((a, b) => a.data.order - b.data.order);

const faqSplitSample = [
	{ question: 'What does the stack layout look like?', answer: 'Heading over the list, for a narrow reading column. Articles, calculators, and template pages use it.' },
	{ question: 'And the split layout?', answer: 'A sticky heading and intro on the left and the list on the right, for a full-width band. The homepage uses it.' },
];
const faqStackSample = [
	{ question: 'Where does the stack layout go?', answer: 'Under an article, a calculator, or a template page, usually with class="content-block".' },
	{ question: 'Can answers contain links?', answer: 'Yes, with the html prop. Calculator pages pass it because their answers link to articles.' },
];

// Current article cards (v3) and the archived dark mesh set (v2), straight
// from public/images, so every file that exists is shown.
const imagesDir = path.resolve('public/images');
const listCards = (prefix: string) =>
	readdirSync(imagesDir)
		.filter((f) => f.startsWith(prefix) && f.endsWith('.svg'))
		.sort()
		.map((f) => ({ file: f, src: `/images/${f}`, name: f.replace(prefix, '').replace(/\.svg$/, '') }));
const v3Cards = listCards('card-v3-');
const v2Cards = listCards('card-v2-');

// Explored but not shipped: tool thumbnails with the tool's UI cropped into a
// mesh background.
const toolThumbnails = [
	{ name: '50/30/20 Budget Calculator', src: '/images/tool-thumb-50-30-20-budget-calculator.svg' },
	{ name: 'Biweekly & Weekly Paycheck Calculator', src: '/images/tool-thumb-biweekly-paycheck-calculator.svg' },
	{ name: 'Debt Strategy Comparison', src: '/images/tool-thumb-debt-snowball-vs-avalanche-calculator.svg' },
	{ name: 'Emergency Fund Calculator', src: '/images/tool-thumb-emergency-fund-calculator.svg' },
	{ name: 'Sinking Fund Calculator', src: '/images/tool-thumb-sinking-fund-calculator.svg' },
	{ name: 'Expense Tracking Readiness', src: '/images/tool-thumb-expense-tracking-readiness.svg' },
	{ name: 'Sinking Fund Assessment', src: '/images/tool-thumb-sinking-fund-assessment.svg' },
	{ name: 'Find Your Budgeting Style', src: '/images/tool-thumb-budgeting-style-quiz.svg' },
];
---

<BaseLayout title={`Style Guide | ${SITE_TITLE}`} description="Living reference for Simply Sheets components, tokens, and patterns." noindex>
	<main id="main-content" class="band-main guide">

		<header class="band guide-header">
			<div class="band-inner">
				<h1>Style guide</h1>
				<p class="guide-lede">The design system as it actually renders. Everything below is the real component or the real token, so this page cannot drift from the site. Pages are assembled from bands, section heads, and cards; a new page should need no new card or grid CSS of its own.</p>
				<nav class="guide-toc" aria-label="Style guide sections">
					<a href="#foundations">Foundations</a>
					<a href="#components">Components</a>
					<a href="#article-cards">Article thumbnails</a>
					<a href="#archive">Archive</a>
				</nav>
			</div>
		</header>

		<!-- ================= FOUNDATIONS ================= -->
		<section class="band band--surface" id="foundations">
			<div class="band-inner">
				<SectionHead title="Foundations" desc="Tokens from src/styles/tokens.css. Use a token, never a literal, in any component." />

				<h3 class="guide-label">Color</h3>
				<div class="swatches">
					{colorTokens.map((c) => (
						<div class="swatch">
							<div class="swatch-chip" style={`background: var(${c.token})`}></div>
							<span class="swatch-name">{c.label}</span>
							<code>{c.token}</code>
							<span class="swatch-value">{c.value}</span>
						</div>
					))}
				</div>

				<h3 class="guide-label">Gradients</h3>
				<div class="swatches swatches--wide">
					{gradientTokens.map(([token, label, use]) => (
						<div class="swatch">
							<div class="swatch-chip swatch-chip--tall" style={`background: var(${token})`}></div>
							<span class="swatch-name">{label}</span>
							<code>{token}</code>
							<span class="swatch-value">{use}</span>
						</div>
					))}
				</div>

				<h3 class="guide-label">Type</h3>
				<p class="guide-note">Manrope for headings and UI, DM Sans for reading copy. Every heading is <code>--weight-semibold</code> from the shared rule; hierarchy comes from size and tracking.</p>
				<div class="type-list">
					{typeScale.map(([token, label, sample]) => (
						<div class="type-row">
							<div class="type-meta"><span>{label}</span><code>{token}</code></div>
							<div class:list={['type-sample', { 'type-sample--heading': !['--text-body-lg', '--text-read', '--text-body', '--text-small', '--text-xs'].includes(token) }]} style={`font-size: var(${token})`}>{sample}</div>
						</div>
					))}
				</div>

				<h3 class="guide-label">Spacing</h3>
				<div class="spacing-list">
					{spacingScale.map((token) => (
						<div class="spacing-row">
							<code>{token}</code>
							<span class="spacing-bar" style={`width: var(${token})`}></span>
							<span class="swatch-value">{tokenValue(token)}</span>
						</div>
					))}
					<div class="spacing-row">
						<code>--space-band</code>
						<span class="spacing-bar" style="width: var(--space-band)"></span>
						<span class="swatch-value">{tokenValue('--space-band')}, a band's vertical padding</span>
					</div>
				</div>

				<h3 class="guide-label">Radius</h3>
				<div class="radii">
					{radii.map(([token, use]) => (
						<div class="radius" style={`border-radius: var(${token})`}>
							<code>{token}</code>
							<span>{use}</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- ================= COMPONENTS ================= -->
		<section class="band" id="components">
			<div class="band-inner">
				<SectionHead title="Components" desc="Every reusable piece, rendered live. Each lives in src/components; the card anatomy and layout primitives live in global.css." />

				<h3 class="guide-label">Bands</h3>
				<p class="guide-note">A page is a stack of full-bleed <code>.band</code> sections, each with a <code>.band-inner</code> held to <code>--max-width-content</code>. Bands alternate the page ground with <code>.band--surface</code>; that alternation, not rules, separates chapters. <code>.band--flush-top</code> continues the band above it (a grid under a <code>PageHero</code>). The <code>main</code> element that holds bands takes <code>.band-main</code>.</p>

				<h3 class="guide-label">PageHero</h3>
				<p class="guide-note">The centered opener on every top-level page, over the faint rings: <code>size="hero"</code> on the homepage, <code>size="page"</code> everywhere else. Breadcrumbs center inside it; with breadcrumbs, the whole hero left-aligns below 600px. Slots: <code>before</code> (badge, glyph), default (buttons, filter tabs), <code>after</code> (the homepage stage). See the top of any hub page.</p>

				<h3 class="guide-label">SectionHead</h3>
				<div class="demo">
					<SectionHead title="Split: title left, the rest right" desc="The default. Collapses to one column at 960px." href="#components" linkLabel="Text link" />
				</div>
				<div class="demo">
					<SectionHead align="center" title="Centered" desc="For a band that introduces a single centered block, like the homepage steps." />
				</div>

				<h3 class="guide-label">Buttons</h3>
				<div class="demo demo--row">
					<a href="#components" class="btn btn-primary">Primary</a>
					<a href="#components" class="btn btn-brand">Brand</a>
					<a href="#components" class="btn btn-secondary">Secondary</a>
					<a href="#components" class="btn btn-ghost">Ghost</a>
				</div>
				<div class="demo demo--row">
					<a href="#components" class="btn btn-primary btn-arrow">Primary arrow</a>
					<a href="#components" class="btn btn-secondary btn-arrow">Secondary arrow</a>
					<a href="#components" class="btn btn-primary btn-sm">Small</a>
					<a href="#components" class="btn btn-primary btn-lg">Large</a>
				</div>
				<p class="guide-note"><code>.btn-arrow</code> marks a destination rather than a form control. For a quiet "view all" link in a heading or under a list, use <code>.text-link</code> instead: <a href="#components" class="text-link">All articles <span class="arrow">&rarr;</span></a></p>

				<h3 class="guide-label">Badges and eyebrows</h3>
				<div class="demo demo--row">
					<span class="badge">Best Seller</span>
					<span class="badge">Google Sheets</span>
					<TagPills tags={['expense-tracking', 'savings-goals']} tagMap={TAG_MAP} />
				</div>
				<div class="demo">
					<p class="eyebrow eyebrow-badge">Recommended template</p>
					<p class="guide-note">An eyebrow looks like a badge but owns its own line and editorializes; a badge states a fact. Four eyebrows sitewide, never on a band heading.</p>
				</div>

				<h3 class="guide-label">ArticleCard</h3>
				<p class="guide-note"><code>variant="feature"</code> for the one pinned article, <code>grid</code> for listings, <code>compact</code> for "Related articles" in a reading column. Build the data with <code>toArticleCard()</code>.</p>
				<div class="demo">
					<ArticleCard article={featuredSample} variant="feature" cta="style_guide" />
				</div>
				<div class="demo card-grid">
					{gridSamples.map((a) => <ArticleCard article={a} cta="style_guide" />)}
				</div>
				<div class="demo demo--narrow card-list">
					{compactSamples.map((a) => <ArticleCard article={a} variant="compact" cta="style_guide" />)}
				</div>

				<h3 class="guide-label">ProductCard and ProductGrid</h3>
				<p class="guide-note">Always framed, always the uncropped <code>midImage</code> centered on <code>--gradient-media</code>. <code>ProductGrid layout="bento"</code> alternates spans narrow/wide, wide/narrow, half/half; <code>layout="grid"</code> is plain columns. A single card can be built from overrides, as the template page's bundles are.</p>
				<div class="demo">
					<ProductGrid templates={templates} layout="bento" ctaPrefix="style_guide" />
				</div>
				<div class="demo card-grid card-grid--2">
					<ProductCard template={templates[0]} cta="style_guide" />
					<ProductCard href="#components" image={templates[1].data.midImageLight} name="Override example" desc={false} linkLabel="View on Etsy" cta="style_guide" />
				</div>

				<h3 class="guide-label">ToolCard</h3>
				<p class="guide-note"><code>card</code> puts the tool's line art on the ink stage; <code>row</code> is a list row with its kind badge (homepage, "More free tools").</p>
				<div class="demo card-grid">
					{TOOLS.slice(0, 3).map((t) => <ToolCard tool={t} cta="style_guide" />)}
				</div>
				<div class="demo demo--narrow tool-rows">
					{TOOLS.slice(3, 6).map((t) => <ToolCard tool={t} variant="row" cta={`style_guide:${toolId(t)}`} />)}
				</div>

				<h3 class="guide-label">Faq</h3>
				<p class="guide-note">One component for every FAQ; it also emits the FAQPage JSON-LD (off here with <code>schema={'{false}'}</code>). <code>stack</code> for reading columns, <code>split</code> for bands.</p>
				<div class="demo">
					<Faq items={faqSplitSample} layout="split" title="Split layout" desc="Sticky intro on the left." schema={false} id="faq-demo-split" />
				</div>
				<div class="demo demo--narrow">
					<Faq items={faqStackSample} title="Stack layout" schema={false} id="faq-demo-stack" />
				</div>

				<h3 class="guide-label">Tool frame</h3>
				<p class="guide-note">Every calculator and assessment carries <code>.tool-frame</code> on its own root, so it is contained the same way in an article and on its tool page: a border, a thin panel rim drawn with an inset shadow, and the tool on a white sheet inside. The product link below it stays outside the frame. The live Emergency Fund Calculator:</p>
				<div class="demo demo--narrow">
					<EmergencyFundCalculator />
				</div>

				<h3 class="guide-label">CtaBanner</h3>
				<div class="demo">
					<CtaBanner title="The closing call to action" desc="One heading, one line, one button, on the brand gradient." href="#components" label="Primary action" cta="style_guide" />
				</div>
			</div>
		</section>

		<!-- ================= ARTICLE THUMBNAILS ================= -->
		<section class="band band--surface" id="article-cards">
			<div class="band-inner">
				<SectionHead title="Article thumbnails" desc="The current set (v3). Each is generated by scripts/generate-article-cards.mjs from the article's wireframe and its first tag's hue family: a light tinted field, a white highlight, a tint bloom, faint rings, and the wireframe in ink." />
				<div class="thumbs">
					{v3Cards.map((c) => (
						<figure class="thumb">
							<img src={c.src} alt={`${c.name} article card`} width="960" height="540" loading="lazy" />
							<figcaption>{c.file}</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

		<!-- ================= ARCHIVE ================= -->
		<section class="band" id="archive">
			<div class="band-inner">
				<SectionHead title="Archive" desc="Retired styles kept for reference and possible reuse. Nothing on the live site links to these." />

				<h3 class="guide-label">Article thumbnails: dark mesh (v2)</h3>
				<p class="guide-note">The previous article cards: a saturated per-article gradient, four blurred glows, grain, a soft ring motif, and the same wireframe in white. Replaced by v3; the files stay in <code>public/images/card-v2-*.svg</code>, and the wireframes were lifted from them unchanged.</p>
				<div class="thumbs">
					{v2Cards.map((c) => (
						<figure class="thumb">
							<img src={c.src} alt={`${c.name} archived article card`} width="960" height="540" loading="lazy" />
							<figcaption>{c.file}</figcaption>
						</figure>
					))}
				</div>

				<h3 class="guide-label">Article card: gradient overlay</h3>
				<p class="guide-note">A v2 image as a full-bleed background with a white text panel over it. Used on the homepage before the editorial cards.</p>
				<div class="card-grid">
					{gridSamples.map((a) => (
						<a href={`/articles/${a.id}/`} class="gradient-card">
							{a.image && (
								<div class="gradient-card-thumb">
									<img src={a.image.replace('/card-v3-', '/card-v2-')} alt={a.title} width="960" height="540" loading="lazy" />
								</div>
							)}
							<div class="gradient-card-body">
								<h4 class="gradient-card-title">{a.title}</h4>
								<p class="gradient-card-desc">{a.desc}</p>
								<p class="gradient-card-meta">{a.readTime} min read</p>
							</div>
						</a>
					))}
				</div>

				<h3 class="guide-label">Tool thumbnails: UI preview</h3>
				<p class="guide-note">A mesh background with the tool's own UI cropped into the corner. Explored for the tools index; not shipped.</p>
				<div class="thumbs">
					{toolThumbnails.map((t) => (
						<figure class="thumb">
							<img src={t.src} alt={`${t.name} thumbnail preview`} width="960" height="540" loading="lazy" />
							<figcaption>{t.name}</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	/* Only this page's documentation chrome. Every demo above is a real
	   component styled by its own rules. */

	.guide-header {
		padding-bottom: var(--space-xl);
	}
	.guide-header h1 {
		font-size: var(--text-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--space-sm);
	}
	.guide-lede {
		font-size: var(--text-body-lg);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
		max-width: 44rem;
		margin: 0 0 var(--space-md);
	}
	.guide-toc {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
	}
	.guide-toc a {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		color: var(--color-text);
		text-decoration: none;
		padding: 0.4rem 0.9rem;
		border-radius: var(--radius-full);
		box-shadow: inset 0 0 0 1px var(--color-border);
	}
	.guide-toc a:hover {
		background: var(--color-bg-panel);
	}

	.guide-label {
		font-size: var(--text-h3);
		margin: var(--space-xl) 0 var(--space-sm);
	}
	.guide-note {
		font-size: var(--text-small);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
		max-width: 46rem;
		margin: 0 0 var(--space-md);
	}
	.guide-note code,
	.swatch code,
	.type-meta code,
	.spacing-row code,
	.radius code {
		font-size: 0.8125rem;
		padding: 1px 5px;
		background: var(--color-bg-panel);
		border-radius: var(--radius-sm);
	}

	.demo {
		margin-bottom: var(--space-lg);
	}
	.demo--row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm);
	}
	.demo--narrow {
		max-width: var(--max-width-narrow);
	}
	.tool-rows {
		border-top: 1px solid var(--color-border);
	}

	/* ——— Swatches ——— */

	.swatches {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
		gap: var(--space-md);
	}
	.swatches--wide {
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
	}
	.swatch {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		font-size: var(--text-xs);
	}
	.swatch-chip {
		height: 4rem;
		border-radius: var(--radius-card);
		box-shadow: inset 0 0 0 1px rgba(var(--shadow-rgb), 0.08);
		margin-bottom: var(--space-2xs);
	}
	.swatch-chip--tall {
		height: 7rem;
	}
	.swatch-name {
		font-family: var(--font-sans);
		font-weight: var(--weight-medium);
		color: var(--color-text);
	}
	.swatch-value {
		color: var(--color-text-muted);
		font-size: var(--text-xs);
	}

	/* ——— Type, spacing, radius ——— */

	.type-list {
		border-top: 1px solid var(--color-border);
	}
	.type-row {
		display: grid;
		grid-template-columns: 11rem 1fr;
		gap: var(--space-md);
		align-items: baseline;
		padding: var(--space-sm) 0;
		border-bottom: 1px solid var(--color-border);
	}
	.type-meta {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}
	.type-sample {
		line-height: var(--leading-snug);
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.type-sample--heading {
		font-family: var(--font-heading);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
	}

	.spacing-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}
	.spacing-row {
		display: grid;
		grid-template-columns: 9rem auto 1fr;
		gap: var(--space-sm);
		align-items: center;
	}
	.spacing-bar {
		display: block;
		height: 0.75rem;
		border-radius: var(--radius-full);
		background: var(--tint-sky);
	}

	.radii {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
