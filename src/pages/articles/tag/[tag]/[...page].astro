---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import TopicFilterTabs from '../../../../components/TopicFilterTabs.astro';
import ArticleGrid from '../../../../components/ArticleGrid.astro';
import Pagination from '../../../../components/Pagination.astro';
import { ALL_TAGS, ARTICLES_PAGE_SIZE as PAGE_SIZE, TAG_MAP, pageTitle as buildTitle } from '../../../../consts';
import { getSortedArticles, toArticleCard, type ArticleCardData } from '../../../../utils/articles';

export const getStaticPaths = (async ({ paginate }) => {
	const sorted = await getSortedArticles();
	const usedTags = new Set(sorted.flatMap((a) => a.data.tags ?? []));
	const visibleTags = ALL_TAGS.filter((t) => usedTags.has(t.slug));

	return visibleTags.flatMap((tag) => {
		const tagged = sorted
			.filter((a) => a.data.tags?.includes(tag.slug))
			.map(toArticleCard);
		return paginate(tagged, { pageSize: PAGE_SIZE, params: { tag: tag.slug } });
	});
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { page } = Astro.props as { page: Page<ArticleCardData> };
const tagLabel = TAG_MAP[tag as string] ?? tag;

const allArticles = await getCollection('articles');
const usedTags = new Set(allArticles.flatMap((a) => a.data.tags ?? []));
const visibleTags = ALL_TAGS.filter((t) => usedTags.has(t.slug));

const all = (await getSortedArticles())
	.filter((a) => a.data.tags?.includes(tag as string))
	.map(toArticleCard);

const pageTitle = page.currentPage === 1
	? buildTitle(`${tagLabel} Articles, Tips & Guides`)
	: buildTitle(`${tagLabel} Articles, Tips & Guides: Page ${page.currentPage}`);
const pageDescription = `Guides and practical advice on ${tagLabel.toLowerCase()}, with straightforward writing to help you manage your money without the stress.`;

const crumbs = page.currentPage === 1
	? [{ label: 'Articles', href: '/articles/' }, { label: tagLabel }]
	: [{ label: 'Articles', href: '/articles/' }, { label: tagLabel, href: `/articles/tag/${tag}/` }, { label: `Page ${page.currentPage}` }];

const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: pageTitle,
	description: pageDescription,
	url: Astro.url.toString(),
};

const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	itemListElement: page.data.map((article, i) => ({
		'@type': 'ListItem',
		position: (page.currentPage - 1) * PAGE_SIZE + i + 1,
		url: new URL(`/articles/${article.id}/`, Astro.site).toString(),
		name: article.title,
	})),
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

	<main id="main-content" class="band-main">
		<PageHero title={`${tagLabel} Articles`} desc={pageDescription} crumbs={crumbs}>
			<TopicFilterTabs tags={visibleTags} activeSlug={tag as string} centered />
		</PageHero>

		<section class="band band--flush-top">
			<div class="band-inner">
				<ArticleGrid articles={page.data} all={all} />
				<Pagination currentPage={page.currentPage} lastPage={page.lastPage} basePath={`/articles/tag/${tag}`} />
			</div>
		</section>
	</main>
</BaseLayout>
