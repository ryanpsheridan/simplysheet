---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import TopicFilterTabs from '../../components/TopicFilterTabs.astro';
import ArticleGrid from '../../components/ArticleGrid.astro';
import Pagination from '../../components/Pagination.astro';
import { ALL_TAGS, ARTICLES_PAGE_SIZE as PAGE_SIZE, ETSY_SHOP_URL, withEtsyTracking, pageTitle as buildTitle } from '../../consts';
import { getSortedArticles, toArticleCard, type ArticleCardData } from '../../utils/articles';

export const getStaticPaths = (async ({ paginate }) => {
	const articles = (await getSortedArticles()).map(toArticleCard);
	return paginate(articles, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<ArticleCardData> };

const allArticles = await getCollection('articles');
const usedTags = new Set(allArticles.flatMap((a) => a.data.tags ?? []));
const visibleTags = ALL_TAGS.filter((t) => usedTags.has(t.slug));

const all = (await getSortedArticles()).map(toArticleCard);

const pageTitle = page.currentPage === 1
	? buildTitle('Budgeting & Personal Finance Articles')
	: buildTitle(`Budgeting & Personal Finance Articles: Page ${page.currentPage}`);
const pageDescription = page.currentPage === 1
	? 'Straightforward writing about budgeting, spreadsheets, and managing your money without the stress.'
	: `More budgeting and money management articles, page ${page.currentPage} of ${page.lastPage}.`;

const crumbs = page.currentPage === 1
	? [{ label: 'Articles' }]
	: [{ label: 'Articles', href: '/articles/' }, { label: `Page ${page.currentPage}` }];

const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: pageTitle,
	description: pageDescription,
	url: Astro.url.toString(),
};

const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	itemListElement: page.data.map((article, i) => ({
		'@type': 'ListItem',
		position: (page.currentPage - 1) * PAGE_SIZE + i + 1,
		url: new URL(`/articles/${article.id}/`, Astro.site).toString(),
		name: article.title,
	})),
};

// Four products under the grid, in the site's own order. They link to the
// internal template pages like every other product card (each page carries
// its own tracked Etsy CTA); the banner below is the one direct Etsy link.
const templates = (await getCollection('templates'))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 4);
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

	<main id="main-content" class="band-main">
		<PageHero
			title="Articles"
			desc="Straightforward writing about budgeting, spreadsheets, and managing your money without the stress."
			crumbs={crumbs}
		>
			<TopicFilterTabs tags={visibleTags} activeSlug="all" centered />
		</PageHero>

		<section class="band band--flush-top">
			<div class="band-inner">
				<ArticleGrid articles={page.data} all={all} />
				<Pagination currentPage={page.currentPage} lastPage={page.lastPage} basePath="/articles" />
			</div>
		</section>

		<section class="band band--surface" aria-labelledby="resources-heading">
			<div class="band-inner">
				<SectionHead
					id="resources-heading"
					title="Spreadsheets to put the reading to work"
					desc="The templates these articles are built around, for Google Sheets and Excel."
					href="/spreadsheets/"
					linkLabel="All spreadsheets"
					cta="articles_index_all_spreadsheets"
				/>
				<ProductGrid templates={templates} columns={4} ctaPrefix="articles_index_product_card" />
			</div>
		</section>

		<section class="band">
			<CtaBanner
				title="Browse the whole shop"
				desc="Every template and bundle, in dark and light themes, on Etsy."
				href={withEtsyTracking(ETSY_SHOP_URL)}
				label="Explore all on Etsy"
				cta="articles_index_explore_all_cta"
				external
			/>
		</section>
	</main>
</BaseLayout>
