---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BudgetingStyleQuiz from '../../components/BudgetingStyleQuiz.astro';
import { SITE_TITLE } from '../../consts';

const title = "What's Your Budgeting Style? Free Quiz";
const description = 'Take our 60-second quiz to uncover your unique money personality and get one actionable tip to reach your goals faster.';
---

<BaseLayout title={`${title} — ${SITE_TITLE}`} description={description}>
	<main>
		<Breadcrumbs crumbs={[{ label: 'Budgeting Style Quiz' }]} />
		<article>
			<header class="quiz-header">
				<h1>Find Your Budgeting Style</h1>
				<p class="quiz-intro">Take our 60-second quiz to uncover your unique money personality and get one actionable tip to reach your goals faster.</p>
			</header>

			<BudgetingStyleQuiz />

			<section class="quiz-why">
				<h2>Why Your Budget Type Matters</h2>
				<p>A one-size-fits-all budget rarely works. Understanding your natural financial tendencies helps you build a system that sticks, so you can stop stressing and start reaching your goals.</p>
			</section>

			<div class="quiz-article-link">
				<a href="/articles/budgeting-styles/" class="quiz-article-card">
					<div class="quiz-article-thumb">
						<img src="/images/card-v2-budgeting-styles.svg" alt="The 4 Budgeting Styles" width="960" height="540" loading="lazy" />
					</div>
					<div class="quiz-article-link-text">
						<span class="quiz-article-link-label">Related article</span>
						<h2 class="quiz-article-link-title">The 4 Budgeting Styles: Which One Are You?</h2>
						<p class="quiz-article-link-desc">Learn what each budgeting style looks like, what trips each one up, and how to build a system that works with your natural tendencies.</p>
					</div>
				</a>
			</div>

			<div class="quiz-callout">
				<p class="quiz-callout-text">No matter your type, the right spreadsheet can help you stay on track. Browse all of our <a href="/spreadsheets/">budget templates</a> to find the one that fits how you manage money.</p>
			</div>
		</article>
	</main>
</BaseLayout>

<style>
	main {
		max-width: calc(var(--max-width-narrow) + var(--space-md) * 2);
	}
	.quiz-header {
		margin-bottom: var(--space-sm);
	}
	.quiz-header h1 {
		font-size: var(--text-h1);
	}
	.quiz-intro {
		font-size: var(--text-body);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
	}
	.quiz-callout {
		margin-top: var(--space-xl);
		padding: var(--space-md);
		background: var(--color-bg-emphasis);
		border-radius: var(--radius-md);
	}
	.quiz-callout-text {
		font-size: var(--text-small);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
		margin: 0;
	}
	.quiz-callout-text a {
		font-weight: var(--weight-normal);
	}
	.quiz-article-link {
		margin-top: var(--space-xl);
		max-width: 24rem;
	}
	.quiz-article-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		text-decoration: none;
		color: inherit;
	}
	@media (hover: hover) {
		.quiz-article-card:hover .quiz-article-thumb {
			background: var(--color-bg-emphasis);
		}
	}
	.quiz-article-thumb {
		position: relative;
		width: 100%;
		aspect-ratio: 3 / 2;
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-bg-panel);
		padding: 1.5rem;
		transition: background 0.15s ease;
	}
	.quiz-article-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: var(--radius-sm);
		display: block;
	}
	.quiz-article-link-label {
		display: block;
		font-size: var(--text-small);
		font-weight: var(--weight-normal);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-text-muted);
		margin-bottom: var(--space-2xs);
	}
	.quiz-article-link-title {
		font-family: var(--font-heading);
		font-size: 1.1rem;
		font-weight: var(--weight-normal);
		line-height: 1.3;
		color: var(--color-text);
		margin: 0 0 var(--space-xs) 0;
	}
	.quiz-article-link-desc {
		font-size: var(--text-small);
		line-height: 1.5;
		color: var(--color-text-secondary);
		margin: 0;
	}
	.quiz-why {
		margin-top: var(--space-xl);
	}
	.quiz-why h2 {
		font-size: var(--text-h2);
		margin-bottom: var(--space-sm);
	}
	.quiz-why p {
		font-size: var(--text-body);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
	}
</style>
