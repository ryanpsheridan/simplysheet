---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import ToolCard from '../../components/ToolCard.astro';
import { pageTitle } from '../../consts';
import { TOOLS } from '../../data/tools';

const title = 'Free Budgeting Calculators & Tools';
const description = 'Free calculators and assessments to help you manage your money. Compare debt payoff strategies, find your ideal budget split, and more.';

const calculators = TOOLS.filter((t) => t.group === 'calculator');
const assessments = TOOLS.filter((t) => t.group === 'assessment');

// Mirrors the CollectionPage + ItemList pair the /articles/ hub already emits,
// so every listing hub describes itself the same way to crawlers.
const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: title,
	description,
	url: Astro.url.toString(),
};

const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	itemListElement: TOOLS.map((tool, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		url: new URL(tool.url, Astro.site).toString(),
		name: tool.name,
	})),
};
---

<BaseLayout title={pageTitle(title)} description={description}>
	<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
	<main id="main-content" class="band-main">
		<PageHero
			title="Free tools"
			desc="Free calculators and assessments to help you make clearer decisions about your money. They run in your browser, with no email or sign-up."
			crumbs={[{ label: 'Tools' }]}
		/>

		<section class="band band--flush-top" aria-labelledby="calculators-heading">
			<div class="band-inner">
				<SectionHead id="calculators-heading" title="Calculators" desc="Run your own numbers: budget splits, paychecks, debt payoff, savings targets, and splitting bills." />
				<div class="card-grid">
					{calculators.map((tool) => <ToolCard tool={tool} />)}
				</div>
			</div>
		</section>

		<section class="band band--surface" aria-labelledby="assessments-heading">
			<div class="band-inner">
				<SectionHead id="assessments-heading" title="Assessments" desc="A few quick questions, and a straight answer about where you stand." />
				<div class="card-grid">
					{assessments.map((tool) => <ToolCard tool={tool} />)}
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
