---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { getCollection } from 'astro:content';
import { ETSY_SHOP_URL, withEtsyTracking, pageTitle } from '../../consts';

const title = 'Budget Templates for Google Sheets & Excel';
const description = 'Ready-made spreadsheet templates to track your budget, pay off debt, and hit savings goals. Available for Google Sheets and Microsoft Excel.';

const templates = (await getCollection('templates'))
	.sort((a, b) => a.data.order - b.data.order);

// Mirrors the CollectionPage + ItemList pair the /articles/ hub already emits,
// so both listing hubs describe themselves the same way to crawlers.
const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: title,
	description,
	url: Astro.url.toString(),
};

const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	itemListElement: templates.map((template, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		url: new URL(`/spreadsheets/${template.id}/`, Astro.site).toString(),
		name: template.data.title,
	})),
};
---

<BaseLayout title={pageTitle(title)} description={description}>
	<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
	<main id="main-content" class="band-main">
		<PageHero
			title={title}
			desc="Simple, visual spreadsheets designed to help you understand where your money goes and stay on track. No subscriptions, no apps, just a spreadsheet you own."
			crumbs={[{ label: 'Spreadsheets' }]}
		/>

		<section class="band band--flush-top">
			<div class="band-inner">
				<ProductGrid templates={templates} columns={2} level="h2" ctaPrefix="spreadsheets_index_card" />
			</div>
		</section>

		<section class="band band--flush-top">
			<CtaBanner
				title="Looking for a bundle?"
				desc="Every template, both themes, and the money-saving bundles live in the Etsy shop."
				href={withEtsyTracking(ETSY_SHOP_URL)}
				label="Browse all on Etsy"
				cta="spreadsheets_index_etsy_link"
				external
			/>
		</section>
	</main>
</BaseLayout>
