---
import { getEntry } from 'astro:content';

interface Props {
	slug: string;
	variant?: 'card' | 'interstitial' | 'row' | 'mini';
	label?: string;
}

const { slug, variant = 'card', label } = Astro.props;

const template = await getEntry('templates', slug);
if (!template) {
	throw new Error(`ProductPromo: no template found for slug "${slug}"`);
}

const { title, description, badge, midImage } = template.data;
const name = title.replace(/ for (Google )?Sheets & Excel$/, '');
const url = `/spreadsheets/${slug}/`;
const alt = `${name} preview`;
const image = midImage;
---

{variant === 'interstitial' && (
	<div class="article-promo">
		<a href={url} class="article-promo-thumb" data-cta={`product_promo_thumb:${slug}:interstitial`}>
			<img src={image} alt={alt} width="600" height="400" loading="lazy" />
		</a>
		<div class="article-promo-content">
			{label && <p class="eyebrow interstitial-label">{label}</p>}
			<div class="product-text">
				{/* One label, not two. When an article supplies its own `label` the
				    eyebrow already says why this product is here, and stacking the
				    template's generic badge under it just repeats the job in a
				    second style. The article's framing is the more specific of the
				    two, so it wins and the badge stands down. */}
				{!label && badge && <span class="badge product-badge">{badge}</span>}
				<h3 class="product-name">{name}</h3>
				<p class="product-desc">{description}</p>
			</div>
			<a href={url} class="btn btn-secondary product-cta" data-cta={`product_promo_cta:${slug}:interstitial`}>View template <span class="arrow">&rarr;</span></a>
		</div>
	</div>
)}

{variant === 'card' && (
	<a href={url} class="product-card" data-cta={`product_promo_card:${slug}`}>
		<div class="product-card-thumb">
			<img src={image} alt={alt} width="600" height="400" loading="lazy" />
		</div>
		{badge && <span class="badge product-card-badge">{badge}</span>}
		<h3 class="product-card-name">{name}</h3>
		<p class="product-card-desc">{description}</p>
	</a>
)}

{variant === 'mini' && (
	<aside class="promo-mini">
		<p class="eyebrow promo-mini-label">{label ?? 'Recommended template'}</p>
		<a href={url} class="promo-mini-link" data-cta={`product_promo_mini:${slug}`}>{name} <span class="arrow">&rarr;</span></a>
	</aside>
)}

{variant === 'row' && (
	<div class="product-row">
		<a href={url} class="product-thumb" data-cta={`product_promo_thumb:${slug}:row`}>
			<img src={image} alt={alt} width="600" height="400" loading="lazy" />
		</a>
		<div class="product-content">
			<div class="product-text">
				{badge && <span class="badge product-badge">{badge}</span>}
				<h3 class="product-name">{name}</h3>
				<p class="product-desc">{description}</p>
			</div>
			<a href={url} class="btn btn-secondary product-cta" data-cta={`product_promo_cta:${slug}:row`}>View template <span class="arrow">&rarr;</span></a>
		</div>
	</div>
)}
