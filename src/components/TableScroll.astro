---
// Wraps every .prose table in a .table-scroll-wrap and gives it the scroll
// rail (styles in global.css). Shared by ArticleLayout and CalculatorLayout so
// a table on either kind of page gets the same affordance on a phone.
---

<script>
	/* :not(.calc-table) is load-bearing. Calculator tables opt out of
	   scrolling on purpose — they set display:table + table-layout:fixed so
	   their columns stay aligned inside an article — and wrapping one gave
	   it the wrap's mobile right-bleed while leaving it unable to scroll.
	   The result was a table 24px wider than the column, pinned flush to
	   the screen edge with its last header clipped and no way to reach it. */
	document.querySelectorAll<HTMLTableElement>('.prose table:not(.calc-table)').forEach((table) => {
		const wrap = document.createElement('div');
		wrap.className = 'table-scroll-wrap';
		table.parentNode?.insertBefore(wrap, table);
		wrap.appendChild(table);

		const rail = document.createElement('div');
		rail.className = 'table-scroll-rail';
		const thumb = document.createElement('span');
		thumb.className = 'table-scroll-thumb';
		rail.appendChild(thumb);
		wrap.appendChild(rail);

		function updateOverflow() {
			const max = table.scrollWidth - table.clientWidth;
			const scrollable = max > 4;
			wrap.classList.toggle('is-scrollable', scrollable);
			if (!scrollable) return;

			// Thumb width is the visible fraction, so its size states how much
			// table there is. Translation is expressed in multiples of the
			// thumb's own width, which is what a percentage transform resolves
			// against.
			const visible = table.clientWidth / table.scrollWidth;
			const travelled = table.scrollLeft / max;
			thumb.style.width = `${visible * 100}%`;
			thumb.style.transform = `translateX(${travelled * (100 / visible - 100)}%)`;
		}
		updateOverflow();
		window.addEventListener('resize', updateOverflow, { passive: true });
		table.addEventListener('scroll', updateOverflow, { passive: true });
	});
</script>
