---
import ArticleCard from './ArticleCard.astro';
import type { ArticleCardData } from '../utils/articles';

// The articles listing grid with search and sort.
//
// The default view is the statically rendered, really paginated page of cards
// (good for SEO, AEO, and no-JS). Search and non-default sort span every page,
// so they switch to a client view built from `all`: every card in scope
// (all articles, or all articles for the current tag), rendered on the server
// with the same ArticleCard into an inert <template>. The script filters and
// orders those nodes and clones them in. There is no client-side copy of the
// card markup to keep in sync; the card is the card.
//
// Clearing search and resetting sort to "Newest first" restores the original
// static markup exactly, including whichever page the visitor is on.
interface Props {
	/** This page's articles, newest first. */
	articles: ArticleCardData[];
	/** Every article in scope, newest first. */
	all: ArticleCardData[];
}

const { articles, all } = Astro.props;
---

<div class="article-grid">
	<div class="article-grid-toolbar">
		<div class="filter-search">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
			<input type="search" id="search-input" class="search-input" placeholder="Search articles" aria-label="Search articles" />
		</div>
		<div class="filter-select-wrap">
			<select id="sort-select" class="filter-select" aria-label="Sort articles">
				<option value="newest">Newest first</option>
				<option value="oldest">Oldest first</option>
				<option value="title">Title A–Z</option>
			</select>
			<svg class="filter-select-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
		</div>
	</div>

	<div class="card-grid" id="article-list">
		{articles.map((article) => (
			<ArticleCard article={article} level="h2" cta={`articles_grid_item:${article.id}`} />
		))}
	</div>

	<p class="no-results" hidden>No articles match your search.</p>

	<template id="articles-all">
		{all.map((article) => (
			<ArticleCard article={article} level="h2" cta={`articles_grid_item:${article.id}`} />
		))}
	</template>
</div>

<script>
	const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
	const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
	const list = document.getElementById('article-list');
	const noResults = document.querySelector<HTMLParagraphElement>('.no-results');
	const pagination = document.querySelector<HTMLElement>('.pagination');
	const source = document.getElementById('articles-all') as HTMLTemplateElement | null;

	const originalHTML = list?.innerHTML ?? '';
	const allCards = source ? Array.from(source.content.querySelectorAll<HTMLAnchorElement>('a.card')) : [];

	function applyFilterAndSort() {
		if (!list) return;
		const query = (searchInput?.value ?? '').trim().toLowerCase();
		const sort = sortSelect?.value ?? 'newest';

		if (!query && sort === 'newest') {
			list.innerHTML = originalHTML;
			if (noResults) noResults.hidden = true;
			if (pagination) pagination.style.display = '';
			return;
		}

		if (pagination) pagination.style.display = 'none';

		const matches = allCards.filter((card) => {
			if (!query) return true;
			const title = (card.dataset.title ?? '').toLowerCase();
			const desc = (card.dataset.desc ?? '').toLowerCase();
			return title.includes(query) || desc.includes(query);
		});

		matches.sort((a, b) => {
			if (sort === 'title') return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
			const da = Number(a.dataset.date), db = Number(b.dataset.date);
			return sort === 'oldest' ? da - db : db - da;
		});

		list.replaceChildren(...matches.map((card) => card.cloneNode(true)));
		if (noResults) noResults.hidden = matches.length > 0;
	}

	searchInput?.addEventListener('input', applyFilterAndSort);
	sortSelect?.addEventListener('change', applyFilterAndSort);
</script>

<style>
	/* ——— Toolbar (search + sort) ——— */

	.article-grid-toolbar {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-sm);
		margin-bottom: var(--space-lg);
	}

	/* Search and sort are the same kind of control, so they share one field
	   treatment: surface fill, default border, pill radius like every other
	   control on the page. */
	.filter-search,
	.filter-select {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		color: var(--color-text);
		background: var(--color-bg-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		transition: border-color var(--duration-fast) var(--ease-out);
	}
	.filter-search {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		flex: 0 1 22rem;
		min-width: 0;
		padding: 0.625rem 1rem;
		color: var(--color-text-muted);
	}
	.filter-search:hover {
		border-color: var(--color-border-strong);
	}
	.filter-search:focus-within {
		border-color: var(--color-text-muted);
	}
	.filter-search svg {
		flex-shrink: 0;
	}
	.search-input {
		flex: 1;
		min-width: 0;
		width: 100%;
		font: inherit;
		color: var(--color-text);
		background: none;
		border: none;
		outline: none;
	}
	.search-input::placeholder {
		color: var(--color-text-muted);
	}

	.filter-select-wrap {
		position: relative;
		display: flex;
		align-items: center;
	}
	.filter-select {
		appearance: none;
		padding: 0.625rem 2.5rem 0.625rem 1rem;
		cursor: pointer;
	}
	.filter-select:hover,
	.filter-select:focus-visible {
		border-color: var(--color-text-muted);
		outline: none;
	}
	.filter-select-chevron {
		position: absolute;
		right: 1rem;
		pointer-events: none;
		color: var(--color-text-muted);
	}

	.no-results {
		font-size: var(--text-small);
		color: var(--color-text-muted);
		padding: var(--space-lg) 0;
	}

	@media (max-width: 600px) {
		.filter-search {
			flex-basis: 100%;
		}
	}
</style>
