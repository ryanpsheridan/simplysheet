---
interface Props {
	showHeader?: boolean;
}
const { showHeader = true } = Astro.props;

const id = `debt-${Math.random().toString(36).slice(2, 8)}`;

// Single source of truth for the example portfolio, passed into the
// client-side payoff simulation via define:vars below.
const DEBTS = [
	{ name: 'Credit Card', balance: 3000, apr: 0.24 },
	{ name: 'Auto Loan', balance: 5000, apr: 0.07 },
	{ name: 'Student Loan', balance: 2000, apr: 0.05 },
];
---

<div class="visualizer" id={id}>
	{showHeader && (
		<>
			<h2 class="debt-title">Debt Payoff Strategy Calculator</h2>
			<p class="debt-subtitle">Most people know that paying more than the minimum helps. Based on a sample $10,000 total debt, drag the slider below to find out how much of a difference an extra monthly payment can make.</p>
		</>
	)}

	<div class="slider-group">
		<label class="slider-label" for={`${id}-range`}>Extra monthly payment <span class="slider-label-context">(based on $10,000 total debt)</span></label>
		<div class="slider-amount" id={`${id}-amount`}>$200</div>
		<input
			type="range"
			id={`${id}-range`}
			class="slider-input"
			min="0"
			max="1000"
			step="50"
			value="200"
		/>
		<div class="slider-range-labels">
			<span>$0</span>
			<span>$1,000</span>
		</div>
	</div>

	<div class="compare-card">
		<div class="compare-row">
			<div class="compare-meta">
				<span class="compare-method">Avalanche</span>
				<span class="compare-badge">Highest rate first</span>
				<span class="compare-best" id={`${id}-aval-best`} hidden>Best value</span>
			</div>
			<div class="compare-track">
				<div class="compare-fill compare-fill--avalanche" id={`${id}-aval`}></div>
			</div>
			<div class="compare-metrics-row">
				<span class="compare-metrics-cost">Interest paid: <span class="compare-metrics-value" id={`${id}-aval-interest`}>$0</span></span>
			</div>
		</div>
		<div class="compare-row">
			<div class="compare-meta">
				<span class="compare-method">Snowball</span>
				<span class="compare-badge">Smallest balance first</span>
				<span class="compare-best" id={`${id}-snow-best`} hidden>Best value</span>
			</div>
			<div class="compare-track">
				<div class="compare-fill compare-fill--snowball" id={`${id}-snow`}></div>
			</div>
			<div class="compare-metrics-row">
				<span class="compare-metrics-cost">Interest paid: <span class="compare-metrics-value" id={`${id}-snow-interest`}>$0</span></span>
			</div>
		</div>
	</div>

	<p class="compare-summary" id={`${id}-summary`}></p>

	<p class="compare-note">Estimated using typical interest rates — actual results may vary.</p>
</div>
<div class="calc-cta-divider"></div>
<a href="/spreadsheets/debt-payoff-tracker/" class="calc-product-link">Track your debt payoff <span class="arrow">&rarr;</span></a>

<style>
	/* No card, border, or fill — the visualizer sits directly in the page column. */
	.visualizer {
		margin: calc(var(--space-lg) * 2) 0 var(--space-lg);
	}

	/* ——— Self-contained title + context ——— */

	.debt-title {
		font-size: var(--text-h3);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin: 0 0 var(--space-xs);
	}

	.debt-subtitle {
		font-size: var(--text-small);
		color: var(--color-text-secondary);
		line-height: var(--leading-normal);
		margin: 0 0 var(--space-lg);
	}

	/* ——— Slider ——— */

	.slider-group {
		margin-bottom: var(--space-lg);
	}

	.slider-label {
		display: block;
		font-size: var(--text-small);
		font-weight: var(--weight-normal);
		color: var(--color-text-secondary);
		margin-bottom: var(--space-2xs);
	}

	.slider-label-context {
		font-size: var(--text-xs);
		font-weight: var(--weight-normal);
		color: var(--color-text-muted);
	}

	.slider-amount {
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: var(--weight-normal);
		color: var(--color-text);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--space-md);
	}

	.slider-input {
		display: block;
		width: 100%;
		height: 6px;
		-webkit-appearance: none;
		appearance: none;
		background: var(--color-border);
		border-radius: 3px;
		outline: none;
		cursor: pointer;
	}
	/* Thumb hit box is 44x44 (WCAG touch target minimum) even though the
	   visible dot stays 22px — the extra hit area is transparent, drawn via
	   the radial-gradient stops below, with a drop-shadow (not box-shadow)
	   so the shadow follows the visible dot's alpha shape, not the full box. */
	.slider-input::-webkit-slider-thumb {
		-webkit-appearance: none;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			var(--color-btn) 0 9px,
			var(--color-bg-surface) 9px 11px,
			transparent 11px 100%
		);
		filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.15));
		cursor: pointer;
	}
	.slider-input::-moz-range-thumb {
		width: 44px;
		height: 44px;
		border: none;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			var(--color-btn) 0 9px,
			var(--color-bg-surface) 9px 11px,
			transparent 11px 100%
		);
		filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.15));
		cursor: pointer;
	}

	.slider-range-labels {
		display: flex;
		justify-content: space-between;
		font-size: var(--text-xs);
		color: var(--color-text-secondary);
		margin-top: var(--space-2xs);
	}

	/* ——— Comparison: no card — sits flush on the page like the rest of the site ——— */

	.compare-card {
		margin-bottom: var(--space-sm);
	}

	.compare-row {
		margin-bottom: var(--space-lg);
	}
	.compare-row:last-of-type {
		margin-bottom: 0;
	}

	.compare-meta {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		margin-bottom: 0.75rem;
	}

	.compare-method {
		font-size: var(--text-small);
		font-weight: var(--weight-normal);
		color: var(--color-text);
	}

	.compare-badge {
		display: inline-block;
		font-size: 0.6875rem;
		font-weight: var(--weight-normal);
		color: var(--color-text);
		background: var(--color-bg-panel);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		padding: 0.125rem 0.5rem;
	}

	/* Neutral, not a judgment color — avalanche and snowball are both
	   presented as equally valid strategies elsewhere on the site, so this
	   only states which one is cheaper in dollar terms right now, styled
	   the same as the other method badge rather than a green "winner". */
	.compare-best {
		display: inline-block;
		font-size: 0.6875rem;
		font-weight: var(--weight-semibold);
		color: var(--color-text);
		background: var(--color-bg-panel);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		padding: 0.125rem 0.5rem;
	}
	.compare-best[hidden] {
		display: none;
	}

	.compare-track {
		height: 6px;
		background: var(--color-bg-panel);
		border-radius: 3px;
		overflow: hidden;
	}

	.compare-fill {
		height: 100%;
		border-radius: 3px;
		transition: width 0.25s ease-out;
	}

	.compare-fill--avalanche {
		background: var(--color-debt-avalanche);
	}

	.compare-fill--snowball {
		background: var(--color-debt-snowball);
	}

	.compare-metrics-row {
		margin-top: var(--space-xs);
	}

	.compare-metrics-cost {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}
	.compare-metrics-value {
		font-weight: var(--weight-semibold);
		color: var(--color-text);
	}

	/* Total months faster is identical for both strategies at any slider
	   position (it depends only on total extra payment, not payoff order),
	   so it's stated once here instead of duplicated under each bar. */
	.compare-summary {
		font-size: var(--text-small);
		color: var(--color-text);
		line-height: var(--leading-normal);
		margin: var(--space-md) 0 0;
	}

	.compare-note {
		font-size: var(--text-xs);
		color: var(--color-text-secondary);
		margin: var(--space-sm) 0 0;
		line-height: var(--leading-normal);
	}

	/* ——— Product link ——— */

	.calc-cta-divider {
		margin-top: var(--space-lg);
	}
	.calc-product-link {
		display: block;
		width: fit-content;
		color: var(--color-accent-info);
		margin-top: var(--space-md);
		margin-bottom: var(--space-lg);
		font-size: 0.875rem;
		text-decoration: none;
	}
	.calc-product-link:hover {
		text-decoration: underline;
	}
	.calc-product-link .arrow {
		display: inline-block;
		transition: transform 0.15s ease;
	}
	.calc-product-link:hover .arrow {
		transform: translateX(2px);
	}

	/* ——— Responsive ——— */

	@media (max-width: 767px) {
		.visualizer {
			margin-top: calc(var(--space-md) * 2);
		}
	}
</style>

<script is:inline define:vars={{ id, DEBTS }}>
(function () {
	var slider = document.getElementById(id + '-range');
	var amountEl = document.getElementById(id + '-amount');
	var avalEl = document.getElementById(id + '-aval');
	var snowEl = document.getElementById(id + '-snow');
	var avalInterestEl = document.getElementById(id + '-aval-interest');
	var snowInterestEl = document.getElementById(id + '-snow-interest');
	var avalBestEl = document.getElementById(id + '-aval-best');
	var snowBestEl = document.getElementById(id + '-snow-best');
	var summaryEl = document.getElementById(id + '-summary');

	// Minimum payments aren't part of the displayed table (it only shows
	// balance + APR), so estimate a typical 2.5%-of-balance minimum per debt.
	var MIN_PAYMENT_RATE = 0.025;
	var debts = DEBTS.map(function (d) {
		return { balance: d.balance, apr: d.apr, minPayment: d.balance * MIN_PAYMENT_RATE };
	});

	// Avalanche (highest rate first) and snowball (smallest balance first)
	// disagree here: the Credit Card is both the highest-rate and a
	// mid-size balance, so the two methods genuinely attack in a different
	// order — that's what makes the comparison meaningful.
	var AVALANCHE_ORDER = debts.slice().sort(function (a, b) { return b.apr - a.apr; });
	var SNOWBALL_ORDER = debts.slice().sort(function (a, b) { return a.balance - b.balance; });

	// Simulates paying down `order` (a priority-sorted list of debts) with a
	// fixed monthly budget of (sum of minimums + extra), redirecting every
	// dollar beyond minimums to the highest-priority debt still owing —
	// exactly how the snowball/avalanche methods work in practice. Returns
	// total interest paid and months to $0 across all debts.
	function simulate(order, extra) {
		var sim = order.map(function (d) {
			return { balance: d.balance, apr: d.apr, minPayment: d.minPayment };
		});
		var totalInterest = 0;
		var months = 0;
		var MAX_MONTHS = 600; // 50-year safety cap

		while (months < MAX_MONTHS && sim.some(function (d) { return d.balance > 0.01; })) {
			months++;

			sim.forEach(function (d) {
				if (d.balance > 0) {
					var interest = d.balance * (d.apr / 12);
					totalInterest += interest;
					d.balance += interest;
				}
			});

			var budget = extra;
			sim.forEach(function (d) { if (d.balance > 0) budget += d.minPayment; });

			var target = sim.find(function (d) { return d.balance > 0; });
			sim.forEach(function (d) {
				if (d !== target && d.balance > 0) {
					var pay = Math.min(d.minPayment, d.balance);
					d.balance -= pay;
					budget -= pay;
				}
			});

			// Apply everything left to the priority target, cascading any
			// leftover to the next debt(s) in line the same month.
			while (budget > 0.01) {
				var next = sim.find(function (d) { return d.balance > 0.01; });
				if (!next) break;
				var pay = Math.min(budget, next.balance);
				next.balance -= pay;
				budget -= pay;
			}
		}

		return { interest: totalInterest, months: months };
	}

	function formatCurrency(n) {
		return '$' + Math.round(n).toLocaleString('en-US');
	}

	// Reference point for the summary line below: total interest and months
	// to debt-free with $0 extra (order doesn't matter at $0 — there's
	// nothing yet to redirect between debts).
	var BASELINE = simulate(AVALANCHE_ORDER, 0);

	// Fixed reference for both bars: interest paid with $0 extra (the same
	// baseline the summary line below compares against). Scaling both bars
	// to this shared, unmoving denominator — instead of to whichever
	// strategy costs more at the current slider value — keeps them on a
	// consistent scale as the slider moves, and lets the cheaper strategy's
	// bar actually read as shorter instead of always filling relative to
	// the pricier one.
	var baselineInterest = BASELINE.interest || 1;

	function update() {
		var extra = parseInt(slider.value, 10);
		amountEl.textContent = '$' + extra.toLocaleString('en-US');

		var aval = simulate(AVALANCHE_ORDER, extra);
		var snow = simulate(SNOWBALL_ORDER, extra);

		avalEl.style.width = Math.min(100, aval.interest / baselineInterest * 100) + '%';
		snowEl.style.width = Math.min(100, snow.interest / baselineInterest * 100) + '%';

		avalInterestEl.textContent = formatCurrency(aval.interest);
		snowInterestEl.textContent = formatCurrency(snow.interest);

		// Compare rounded dollar amounts, not raw floats: floating-point
		// summation order can leave sub-cent noise between two amounts that
		// are genuinely tied (e.g. at $0 extra, where payoff order can't
		// matter), which would otherwise flag a "Best value" difference the
		// displayed numbers don't actually show.
		var avalRounded = Math.round(aval.interest);
		var snowRounded = Math.round(snow.interest);
		avalBestEl.hidden = !(avalRounded < snowRounded);
		snowBestEl.hidden = !(snowRounded < avalRounded);

		// Total months faster is identical for both strategies at any given
		// extra payment (it depends only on the total payment, not payoff
		// order), so it's stated once rather than duplicated per strategy.
		var monthsFaster = BASELINE.months - aval.months;
		summaryEl.textContent = extra > 0
			? 'Paying an extra ' + formatCurrency(extra) + '/month gets you debt-free '
				+ monthsFaster + (monthsFaster === 1 ? ' month' : ' months')
				+ ' faster than making minimum payments only.'
			: 'Drag the slider to see how an extra monthly payment speeds up your payoff.';
	}

	slider.addEventListener('input', update);
	update();
})();
</script>
