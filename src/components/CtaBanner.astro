---
// The closing call to action on a page: a warm panel card on the textured
// collage field (--texture-field, the same as the homepage's closing card),
// one heading, one line, one button. The text sits on the panel, never on
// the texture.
//
// Place it inside a band (`<section class="band"><CtaBanner .../></section>`);
// the banner sets its own width.
interface Props {
	title: string;
	desc?: string;
	href: string;
	label: string;
	/** data-cta for the button. */
	cta: string;
	/** Opens in a new tab, with the external-link glyph instead of the arrow. */
	external?: boolean;
	level?: 'h2' | 'h3';
}

const { title, desc, href, label, cta, external = false, level = 'h2' } = Astro.props;
const Title = level;
---

<div class="cta-banner textured">
<div class="cta-banner-card">
	<Title class="cta-banner-title">{title}</Title>
	{desc && <p class="cta-banner-desc">{desc}</p>}
	{external ? (
		<a href={href} class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer" data-cta={cta}>
			{label}
			<svg class="arrow external-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
		</a>
	) : (
		<a href={href} class="btn btn-primary btn-lg btn-arrow" data-cta={cta}>{label}</a>
	)}
</div>
</div>

<style>
	.cta-banner {
		max-width: var(--max-width-content);
		margin: 0 auto;
		padding: clamp(2.5rem, 7vw, 5.5rem) var(--space-md);
		border-radius: var(--radius-xl);
		background: var(--texture-field);
		display: grid;
		place-items: center;
	}
	.cta-banner-card {
		width: 100%;
		max-width: 40rem;
		padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 5vw, 3rem);
		border-radius: var(--radius-xl);
		background: var(--color-bg-panel);
		box-shadow: 0 30px 80px -30px rgba(var(--shadow-rgb), 0.35);
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.cta-banner-title {
		font-size: var(--text-section);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin: 0 0 var(--space-sm);
		text-wrap: balance;
	}
	.cta-banner-desc {
		font-size: var(--text-lead);
		line-height: 1.4;
		color: var(--color-text-secondary);
		max-width: 32rem;
		margin: 0 0 var(--space-lg);
	}
</style>
