---
// The heading that opens a band: an h2, then one row under it with the
// description on the left and the "View all" style link on the right.
//
// Everything hangs off the content column's two edges: the title and the
// description start on the left edge, the link ends on the right edge, so
// the head lines up with whatever grid sits below it. (It used to split the
// title and description into two columns of its own, which lined up with
// nothing under it.)
//
//   align  start (default) | center (stacked and centered; no link row)
//   size   section (--text-section, default) | display (--text-display, for
//          the one or two sections on a page that open big)
//   kicker an optional plain label above the title ("Free tools")
interface Props {
	title: string;
	desc?: string;
	href?: string;
	linkLabel?: string;
	/** data-cta for the link. */
	cta?: string;
	align?: 'start' | 'center';
	size?: 'section' | 'display';
	kicker?: string;
	id?: string;
	level?: 'h1' | 'h2';
}

const { title, desc, href, linkLabel, cta, align = 'start', size = 'section', kicker, id, level = 'h2' } = Astro.props;
const Title = level;
const hasFoot = Boolean(desc || href);
---

<header class:list={['section-head', `section-head--${align}`, `section-head--${size}`]}>
	{kicker && <p class="kicker">{kicker}</p>}
	<Title id={id} class="section-title">{title}</Title>
	{hasFoot && (
		<div class="section-head-foot">
			{desc && <p class="section-desc">{desc}</p>}
			{href && (
				<a href={href} class="text-link" data-cta={cta}>{linkLabel} <span class="arrow">&rarr;</span></a>
			)}
		</div>
	)}
</header>

<style>
	.section-head {
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}
	/* No font-weight: headings take the regular weight from the shared rule. */
	.section-title {
		font-size: var(--text-section);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin: 0;
		max-width: 16em;
		text-wrap: balance;
	}
	.section-head--display .section-title {
		font-size: var(--text-display);
		line-height: var(--leading-display);
		letter-spacing: var(--tracking-hero);
		max-width: 13em;
	}
	.section-head--display {
		margin-bottom: clamp(3rem, 6vw, 5rem);
	}
	.section-head-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-sm) var(--space-lg);
		margin-top: var(--space-md);
	}
	.section-head--display .section-head-foot {
		margin-top: var(--space-lg);
	}
	.section-desc {
		font-size: var(--text-lead);
		line-height: 1.4;
		letter-spacing: -0.01em;
		color: var(--color-text-secondary);
		margin: 0;
		max-width: 34rem;
		text-wrap: pretty;
	}
	/* The link sits on the right edge; when it wraps under the description on
	   a phone it starts on the left like everything else. */
	.section-head-foot .text-link {
		flex-shrink: 0;
	}

	.section-head--center {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.section-head--center .section-head-foot {
		flex-direction: column;
		align-items: center;
		gap: var(--space-sm);
	}
</style>
