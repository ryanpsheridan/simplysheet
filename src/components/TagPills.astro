---
interface Props {
	tags?: string[];
	tagMap: Record<string, string>;
}

const { tags = [], tagMap } = Astro.props;
const visible = tags.slice(0, 2);
---

{visible.length > 0 && (
	<div class="tag-pills">
		{visible.map((slug) => (
			<span class="badge">{tagMap[slug] ?? slug}</span>
		))}
	</div>
)}

<style>
	.tag-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: var(--space-sm);
	}

	/* The pills themselves are .badge — see global.css. Only the row layout is
	   local, so the tag chips and every other chip on the site stay identical
	   by construction rather than by two rules being kept in sync by hand. */
</style>
