---
interface Props {
	tags?: string[];
	tagMap: Record<string, string>;
}

const { tags = [], tagMap } = Astro.props;
const visible = tags.slice(0, 2);
---

{visible.length > 0 && (
	<div class="tag-pills">
		{visible.map((slug) => (
			<span class="tag-pill">{tagMap[slug] ?? slug}</span>
		))}
	</div>
)}

<style>
	.tag-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: var(--space-sm);
	}

	/* Emphasis fill and primary text, not panel fill and secondary text. On the
	   old pure-white page a panel-filled chip had a clear edge; against the
	   warm off-white page it sits only a shade off its own background and the
	   secondary text on top made it read as disabled rather than as a label.
	   Emphasis separates from the page, and the darker text stops it fading. */
	.tag-pill {
		display: inline-block;
		background: var(--color-bg-emphasis);
		color: var(--color-text);
		font-size: 0.8125rem;
		font-weight: var(--weight-medium);
		line-height: 1;
		padding: 0.4375rem 0.875rem;
		border-radius: var(--radius-full);
		white-space: nowrap;
	}
</style>
