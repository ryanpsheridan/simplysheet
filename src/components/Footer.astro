---
import { getEntry } from 'astro:content';
import { ETSY_SHOP_URL, withEtsyTracking } from '../consts';

const year = new Date().getFullYear();
const budgetSpreadsheet = await getEntry('templates', 'budget-spreadsheet');
const promoUrl = withEtsyTracking(`${budgetSpreadsheet!.data.darkListing}?coupon=SAVENOW`);
---

<footer>
	<p class="footer-promo-bar">
		New to budgeting? Start with our best-selling <a href={promoUrl} class="footer-promo-link" data-cta="footer_promo_banner">Budget Spreadsheet</a> on Etsy and save 30% this week.
	</p>
	<div class="footer-inner">
		<div class="footer-top">
			<div class="footer-brand">
				<a href="/" class="footer-logo-link">
					<img src="/images/logo-svg.svg" alt="Simply Sheets logo" class="footer-logo" width="28" height="30" />
					<span>Simply Sheets</span>
				</a>
				<p class="footer-tagline">Budget spreadsheets that actually get used.</p>
			</div>

			<nav class="footer-nav" aria-label="Footer navigation">
				<div class="footer-col">
					<p class="footer-heading">Site</p>
					<ul>
						<li><a href="/" data-cta="footer_link:home">Home</a></li>
						<li><a href="/articles/" data-cta="footer_link:articles">Articles</a></li>
						<li><a href="/tools/" data-cta="footer_link:tools">Tools</a></li>
						<li><a href="/quiz/budgeting-style/" data-cta="footer_link:budgeting_quiz">Budgeting Style Quiz</a></li>
						<li><a href="/about/" data-cta="footer_link:about">About</a></li>
					</ul>
				</div>
				<div class="footer-col">
					<p class="footer-heading">Spreadsheets</p>
					<ul>
						<li><a href="/spreadsheets/budget-spreadsheet/" data-cta="footer_link:budget-spreadsheet">Budget Spreadsheet</a></li>
						<li><a href="/spreadsheets/couples-budget-spreadsheet/" data-cta="footer_link:couples-budget-spreadsheet">Couples Budget</a></li>
						<li><a href="/spreadsheets/debt-payoff-tracker/" data-cta="footer_link:debt-payoff-tracker">Debt Payoff Tracker</a></li>
						<li><a href="/spreadsheets/savings-goals-tracker/" data-cta="footer_link:savings-goals-tracker">Savings Goals Tracker</a></li>
						<li><a href="/spreadsheets/" class="footer-view-all" data-cta="footer_link:spreadsheets_view_all">View all</a></li>
					</ul>
				</div>
				<div class="footer-col">
					<p class="footer-heading">Shop</p>
					<ul>
						<li><a href={withEtsyTracking(ETSY_SHOP_URL)} data-cta="footer_etsy_link">Etsy Store</a></li>
					</ul>
				</div>
			</nav>
		</div>

		<div class="footer-bottom">
			<p>&copy; {year} Simply Sheets</p>
		</div>
	</div>
</footer>

<style>
	footer {
		/* Inverse surface: --color-bg-inverse-deep background with text flipped
		   to the light end of the ramp. --color-bg-inverse-deep rather than
		   --color-bg-inverse (the text/button ink color) because that value
		   reads as dark gray rather than black at full-footer scale — see its
		   definition in tokens.css. --footer-fg-secondary/muted are color-mixed
		   from --color-bg rather than pulled from the light-mode
		   secondary/muted tokens, which are calibrated for light surfaces and
		   read too dark here. Both clear WCAG AA against this background
		   (8.68:1 and 5.42:1), preserving the same text/secondary/muted
		   contrast ordering as the light-mode ramp. */
		--footer-fg: var(--color-bg);
		--footer-fg-secondary: color-mix(in srgb, var(--color-bg) 68%, var(--color-bg-inverse-deep));
		--footer-fg-muted: color-mix(in srgb, var(--color-bg) 52%, var(--color-bg-inverse-deep));
		--footer-divider: color-mix(in srgb, var(--color-bg) 18%, var(--color-bg-inverse-deep));

		padding: var(--space-xl) var(--space-md) var(--space-lg);
		background: var(--color-bg-inverse-deep);
	}

	.footer-promo-bar {
		max-width: var(--max-width);
		margin: calc(var(--space-xl) * -1) auto var(--space-xl);
		padding: var(--space-sm) 0;
		border-bottom: 1px solid var(--footer-divider);
		text-align: center;
		font-size: var(--text-small);
		color: var(--footer-fg);
		font-weight: var(--weight-normal);
	}
	.footer-promo-link {
		/* --tint-sky rather than --color-accent-info: the site's link/UI blue
		   is calibrated for light surfaces and only clears 3.68:1 here, below
		   AA. --tint-sky was already built to sit on dark ink (14.2:1 there) and
		   clears this background with the same margin (12.76:1). */
		color: var(--tint-sky);
		font-weight: var(--weight-normal);
		text-decoration: underline;
	}
	.footer-promo-link:hover {
		color: var(--footer-fg);
	}
	.footer-inner {
		max-width: var(--max-width);
		margin: 0 auto;
	}

	/* ——— Top section ——— */

	.footer-top {
		display: flex;
		justify-content: space-between;
		gap: var(--space-xl);
		padding-bottom: var(--space-lg);
		border-bottom: 1px solid var(--footer-divider);
	}

	/* ——— Brand column ——— */

	.footer-brand {
		flex-shrink: 0;
	}
	.footer-logo-link {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		/* Pinned to --font-logo, not --font-heading: the wordmark keeps its own
		   face when --font-sans changes site-wide. */
		font-family: var(--font-logo);
		font-size: 1.2rem;
		font-weight: var(--weight-normal);
		color: var(--footer-fg);
		text-decoration: none;
		letter-spacing: -0.02em;
		line-height: 1.29;
	}
	.footer-logo {
		display: block;
		width: 24px;
		height: 26px;
	}
	.footer-tagline {
		margin-top: var(--space-xs);
		font-size: var(--text-small);
		color: var(--footer-fg-muted);
	}

	/* ——— Nav columns ——— */

	.footer-nav {
		display: flex;
		gap: var(--space-xl);
	}
	.footer-col ul {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}
	.footer-heading {
		font-size: var(--text-small);
		font-weight: var(--weight-normal);
		color: var(--footer-fg);
		margin-bottom: var(--space-xs);
	}
	.footer-col a {
		font-size: var(--text-small);
		color: var(--footer-fg-secondary);
		text-decoration: none;
		transition: color 0.15s;
	}
	.footer-col a:hover {
		color: var(--footer-fg);
	}
	.footer-view-all {
		margin-top: var(--space-2xs);
	}

	/* ——— Bottom bar ——— */

	.footer-bottom {
		padding-top: var(--space-md);
	}
	.footer-bottom p {
		font-size: var(--text-small);
		color: var(--footer-fg-muted);
		margin: 0;
	}

	/* ——— Responsive ——— */

	@media (max-width: 768px) {
		.footer-top {
			flex-direction: column;
			gap: var(--space-lg);
		}
		.footer-nav {
			gap: var(--space-lg);
			flex-wrap: wrap;
		}
	}

	@media (max-width: 480px) {
		.footer-nav {
			flex-direction: column;
			gap: var(--space-md);
		}
	}
</style>
