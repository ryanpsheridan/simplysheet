---
import type { CollectionEntry } from 'astro:content';
import ProductCard from './ProductCard.astro';

// A grid of ProductCards for a list of templates, in equal columns: 3 by
// default, `columns` 2 or 4. Every card in a row is the same width. A bento
// layout (alternating narrow and wide spans) used to live here and was
// dropped: uneven cards read as a ranking of the products, which they aren't.
//
// Each card's data-cta is `${ctaPrefix}:${template.id}`.
interface Props {
	templates: CollectionEntry<'templates'>[];
	ctaPrefix: string;
	columns?: 2 | 3 | 4;
	level?: 'h2' | 'h3';
}

const { templates, ctaPrefix, columns = 3, level = 'h3' } = Astro.props;
---

<div
	class:list={[
		'card-grid',
		{ 'card-grid--2': columns === 2 },
		{ 'card-grid--4': columns === 4 },
	]}
>
	{templates.map((t) => (
		<ProductCard template={t} level={level} cta={`${ctaPrefix}:${t.id}`} />
	))}
</div>
