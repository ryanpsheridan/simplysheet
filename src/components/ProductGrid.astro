---
import type { CollectionEntry } from 'astro:content';
import ProductCard from './ProductCard.astro';
import CardRail from './CardRail.astro';

// ProductCards for a list of templates, in one of two layouts:
//
//   grid  equal columns: 3 by default, `columns` 2 or 4. Every card in a row
//         is the same width.
//   rail  a CardRail: one row running off the right edge of the screen, with
//         previous/next buttons (`label` names it, `railCta` tags them). A bento
// layout (alternating narrow and wide spans) used to live here and was
// dropped: uneven cards read as a ranking of the products, which they aren't.
//
// Each card's data-cta is `${ctaPrefix}:${template.id}`.
interface Props {
	templates: CollectionEntry<'templates'>[];
	ctaPrefix: string;
	layout?: 'grid' | 'rail';
	columns?: 2 | 3 | 4;
	level?: 'h2' | 'h3';
	/** rail only: accessible name for the row. */
	label?: string;
	/** rail only: data-cta prefix for the previous/next buttons. */
	railCta?: string;
}

const { templates, ctaPrefix, layout = 'grid', columns = 3, level = 'h3', label = 'Spreadsheets', railCta } = Astro.props;
---

{layout === 'rail' ? (
	<CardRail label={label} cta={railCta}>
		{templates.map((t) => (
			<ProductCard template={t} level={level} cta={`${ctaPrefix}:${t.id}`} />
		))}
	</CardRail>
) : (

<div
	class:list={[
		'card-grid',
		{ 'card-grid--2': columns === 2 },
		{ 'card-grid--4': columns === 4 },
	]}
>
	{templates.map((t) => (
		<ProductCard template={t} level={level} cta={`${ctaPrefix}:${t.id}`} />
	))}
</div>
)}
