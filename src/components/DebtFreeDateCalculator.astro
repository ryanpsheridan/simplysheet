---
const id = `dfcalc-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="calc" id={id} data-multi="false">
	<div class="debt-header" aria-hidden="true">
		<span>Debt name</span>
		<span>Balance</span>
		<span>Rate</span>
		<span>Monthly payment</span>
		<span class="debt-header-actions"></span>
	</div>

	<div class="debt-rows" data-role="rows">
		<div class="debt-row" data-row data-muted="false">
			<div class="debt-field">
				<label class="calc-label">Debt name</label>
				<input type="text" class="debt-input" data-role="name" placeholder="Debt name (optional)" autocomplete="off" aria-label="Debt name (optional)" />
			</div>
			<div class="debt-field">
				<label class="calc-label">Balance</label>
				<div class="calc-field">
					<span class="calc-prefix">$</span>
					<input type="text" class="calc-input" data-role="balance" inputmode="decimal" placeholder="0" autocomplete="off" aria-label="Balance" />
				</div>
			</div>
			<div class="debt-field">
				<label class="calc-label">Interest rate</label>
				<div class="calc-field">
					<input type="text" class="calc-input" data-role="rate" inputmode="decimal" placeholder="0" autocomplete="off" aria-label="Interest rate" />
					<span class="calc-suffix">%</span>
				</div>
			</div>
			<div class="debt-field">
				<label class="calc-label">Monthly payment</label>
				<div class="calc-field">
					<span class="calc-prefix">$</span>
					<input type="text" class="calc-input" data-role="payment" inputmode="decimal" placeholder="0" autocomplete="off" aria-label="Monthly payment" />
				</div>
			</div>
			<div class="debt-row-head">
				<span class="debt-row-title" data-role="row-title">Debt 1</span>
				<div class="debt-row-actions">
					<button type="button" class="debt-action" data-action="mute" aria-pressed="false" aria-label="Hide this debt from the calculation">
						<svg class="icon-eye" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
						<svg class="icon-eye-off" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.5 18.5 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
					</button>
					<button type="button" class="debt-action" data-action="remove" aria-label="Remove this debt">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
					</button>
				</div>
			</div>
		</div>
	</div>

	<button type="button" class="debt-add" data-action="add"><span class="debt-add-plus" aria-hidden="true">+</span> Add another debt</button>

	<div class="calc-highlight" data-role="highlight" hidden>
		<span class="calc-highlight-label">You'll be debt-free in</span>
		<span class="calc-highlight-value" data-role="date">&mdash;</span>
		<span class="calc-highlight-math" data-role="timespan"></span>
	</div>

	<div class="calc-stats" data-role="summary" hidden>
		<div class="calc-stat">
			<span class="calc-stat-label">Total debt</span>
			<span class="calc-stat-value" data-role="summary-total">$0</span>
		</div>
		<div class="calc-stat">
			<span class="calc-stat-label">Debts included</span>
			<span class="calc-stat-value" data-role="summary-count">0</span>
		</div>
		<div class="calc-stat">
			<span class="calc-stat-label">Total monthly payments</span>
			<span class="calc-stat-value" data-role="summary-payments">$0</span>
		</div>
		<div class="calc-stat" data-role="row-interest">
			<span class="calc-stat-label">Total interest paid</span>
			<span class="calc-stat-value" data-role="interest">$0</span>
		</div>
		<div class="calc-stat" data-role="row-total-paid">
			<span class="calc-stat-label">Total payments made</span>
			<span class="calc-stat-value" data-role="total-paid">$0</span>
		</div>
	</div>

	<p class="calc-note" data-role="empty">Enter at least one debt's balance and monthly payment above to see your debt-free date.</p>
	<p class="calc-note" data-role="all-muted" hidden>All your debts are hidden. Click the eye icon on a debt to include it again.</p>
	<p class="calc-warning" data-role="warning" hidden>These payments won't pay off this debt within 50 years. Increase a monthly payment to see a payoff date.</p>

	<p class="calc-note">Debts are paid off highest interest rate first, with each payment that frees up rolling to the next debt. Estimate assumes rates and payments stay the same &mdash; actual results may vary.</p>
</div>
<div class="calc-cta-divider"></div>
<a href="/spreadsheets/debt-payoff-tracker/" class="calc-product-link">Track your debt payoff <span class="arrow">&rarr;</span></a>

<style>
	/* No card, border, or fill — the calculator sits directly in the page column,
	   same as every other calculator on the site. */
	.calc {
		margin: calc(var(--space-lg) * 2) 0 var(--space-lg);

		/* One source of truth for the row grid so the desktop column headers and
		   every debt row stay aligned. The actions column only exists once there
		   are two or more debts — with a single debt there is nothing to hide or
		   remove, so reserving a gutter for it would just leave dead space. */
		--debt-cols: 1.3fr 1fr 0.8fr 1fr;
	}
	.calc[data-multi="true"] {
		--debt-cols: 1.3fr 1fr 0.8fr 1fr 3.75rem;
	}

	/* ——— Desktop column headers ——— */

	.debt-header {
		display: grid;
		grid-template-columns: var(--debt-cols);
		gap: var(--space-sm);
		margin-bottom: var(--space-xs);
	}
	.debt-header span {
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
		color: var(--color-text-secondary);
	}
	/* No actions column below two debts, so its (empty) header cell would
	   otherwise wrap onto a second grid row. */
	.calc:not([data-multi="true"]) .debt-header-actions {
		display: none;
	}

	/* ——— Rows ——— */

	.debt-rows {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.debt-row {
		display: grid;
		grid-template-columns: var(--debt-cols);
		gap: var(--space-sm);
		align-items: end;
		transition: opacity 0.15s;
	}

	/* Muted debts stay filled in but are excluded from the calculation —
	   dimming (rather than clearing their fields) makes it obvious at a
	   glance without losing the entered numbers. */
	.debt-row[data-muted="true"] {
		opacity: 0.4;
	}

	/* min-width: 0 overrides the grid item's automatic min sizing, which
	   otherwise ignores .debt-input's width: 100% and sizes this track off
	   the bare input's intrinsic min-content instead — collapsing this
	   column relative to the other fields, which avoid the issue via
	   min-width: 0 on their own flex-item inputs (.calc-input below). */
	.debt-field {
		min-width: 0;
	}

	/* On desktop the column headers already label every field, so the per-field
	   labels only show in the mobile stack. */
	.calc-label {
		display: none;
		font-size: var(--text-small);
		font-weight: var(--weight-normal);
		color: var(--color-text);
		margin-bottom: var(--space-xs);
	}

	/* ——— Inputs ——— */

	.debt-input {
		width: 100%;
		height: 2.75rem;
		box-sizing: border-box;
		font-family: var(--font-sans);
		font-size: var(--text-body);
		padding: 0.625rem 0.75rem;
		color: var(--color-text);
		background: var(--color-bg-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		outline: none;
		transition: border-color 0.15s;
	}
	.debt-input:focus {
		border-color: var(--color-link);
	}
	.debt-input::placeholder {
		color: var(--color-text-muted);
	}

	.calc-field {
		display: flex;
		align-items: center;
		height: 2.75rem;
		box-sizing: border-box;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: var(--color-bg-surface);
		transition: border-color 0.15s;
	}
	.calc-field:focus-within {
		border-color: var(--color-link);
	}
	.calc-prefix,
	.calc-suffix {
		padding: 0 0.75rem;
		font-size: var(--text-body);
		color: var(--color-text-muted);
		user-select: none;
	}
	.calc-prefix {
		padding-right: 0;
	}
	.calc-input {
		flex: 1;
		min-width: 0;
		border: none;
		outline: none;
		font-family: var(--font-sans);
		font-size: var(--text-body);
		padding: 0.625rem 0.75rem 0.625rem 0.25rem;
		color: var(--color-text);
		background: transparent;
	}
	.calc-suffix ~ .calc-input,
	.calc-input:first-child {
		padding-left: 0.75rem;
	}
	.calc-input::placeholder {
		color: var(--color-text-muted);
	}

	/* ——— Row head: title + hide/remove controls ———
	   Part of the row's own flow (a header line above the fields on mobile, the
	   last grid column on desktop) rather than floated over the top of a field.
	   Hidden entirely while there is only one debt: with nothing to compare it
	   against, there is nothing to hide or remove. */

	.debt-row-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		height: 2.75rem;
	}
	.calc:not([data-multi="true"]) .debt-row-head {
		display: none;
	}
	.debt-row-title {
		display: none;
		font-size: var(--text-small);
		font-weight: var(--weight-semibold);
		color: var(--color-text);
		white-space: nowrap;
	}
	.debt-row-actions {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
	}
	.debt-action {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0;
		line-height: 1;
		color: var(--color-text-secondary);
		background: var(--color-bg-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		cursor: pointer;
		transition: color 0.15s, border-color 0.15s;
	}
	.debt-action:hover {
		color: var(--color-text);
		border-color: var(--color-text-muted);
	}

	.debt-action .icon-eye-off {
		display: none;
	}
	.debt-row[data-muted="true"] .debt-action .icon-eye {
		display: none;
	}
	.debt-row[data-muted="true"] .debt-action .icon-eye-off {
		display: block;
	}
	.debt-row[data-muted="true"] [data-action="mute"] {
		color: var(--color-text);
		border-color: var(--color-text-muted);
	}

	/* ——— Add row button ——— */

	.debt-add {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		margin-top: var(--space-md);
		padding: 0.5rem 1rem;
		font-family: var(--font-heading);
		font-size: var(--text-xs);
		font-weight: var(--weight-normal);
		line-height: 1;
		color: var(--color-text);
		background: transparent;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		cursor: pointer;
		transition: border-color 0.15s, background 0.15s;
	}
	.debt-add:hover {
		border-color: var(--color-text);
	}
	.debt-add[hidden] {
		display: none;
	}
	.debt-add-plus {
		font-size: var(--text-small);
	}

	/* ——— Results: the one card in the layout, reserved for the hero result ——— */

	.calc-highlight {
		display: flex;
		flex-direction: column;
		margin-top: var(--space-lg);
		padding: var(--space-md);
		background: var(--color-bg-panel);
		border-radius: var(--radius-md);
	}
	.calc-highlight[hidden] {
		display: none;
	}
	.calc-highlight-label {
		display: block;
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text);
		margin-bottom: var(--space-2xs);
	}
	.calc-highlight-value {
		display: block;
		font-size: var(--text-h1);
		font-weight: var(--weight-normal);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin-bottom: var(--space-2xs);
	}
	.calc-highlight-math {
		display: block;
		font-size: var(--text-small);
		color: var(--color-text-secondary);
	}
	.calc-highlight-math:empty {
		display: none;
	}

	/* ——— Supporting numbers: flush label/value rows, same pattern as the
	   group bill split calculator ——— */

	.calc-stats {
		display: flex;
		flex-direction: column;
		margin-top: var(--space-lg);
	}
	.calc-stats[hidden] {
		display: none;
	}
	.calc-stat {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-md);
		padding: var(--space-sm) 0;
		border-top: 1px solid var(--color-border);
	}
	.calc-stat[hidden] {
		display: none;
	}
	.calc-stat-label {
		font-size: var(--text-xs);
		color: var(--color-text-secondary);
	}
	.calc-stat-value {
		/* Smaller than the hero value on purpose — these are supporting numbers, not the answer */
		font-size: var(--text-small);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	/* ——— Notes and warnings ——— */

	.calc-note,
	.calc-warning {
		font-size: var(--text-xs);
		color: var(--color-text-secondary);
		margin: var(--space-md) 0 0;
		line-height: var(--leading-normal);
	}
	.calc-note[hidden],
	.calc-warning[hidden] {
		display: none;
	}
	.calc-warning {
		color: var(--color-accent-critical);
	}

	/* ——— Responsive ——— */

	@media (max-width: 767px) {
		.calc {
			margin-top: calc(var(--space-md) * 2);
		}
		.debt-header {
			display: none;
		}

		/* Each debt stacks into a labelled group. No fill or card — a hairline
		   rule between groups is all the separation it needs, which keeps this
		   reading like the rest of the calculators on the site. */
		.debt-rows {
			gap: var(--space-md);
		}
		.debt-row {
			grid-template-columns: 1fr;
			gap: var(--space-sm);
		}
		.debt-row + .debt-row {
			padding-top: var(--space-md);
			border-top: 1px solid var(--color-border);
		}
		.debt-row-head {
			order: -1;
			height: auto;
		}
		.debt-row-title {
			display: block;
		}
		.calc-label {
			display: block;
		}
		.calc-highlight-value {
			font-size: var(--text-h2);
		}
	}
</style>

<script is:inline define:vars={{ id }}>
(function () {
	var root = document.getElementById(id);
	if (!root) return;

	var MAX_ROWS = 8;
	var rowsContainer = root.querySelector('[data-role="rows"]');
	var addBtn = root.querySelector('[data-action="add"]');
	var summaryEl = root.querySelector('[data-role="summary"]');
	var summaryTotal = root.querySelector('[data-role="summary-total"]');
	var summaryCount = root.querySelector('[data-role="summary-count"]');
	var summaryPayments = root.querySelector('[data-role="summary-payments"]');
	var highlightEl = root.querySelector('[data-role="highlight"]');
	var dateEl = root.querySelector('[data-role="date"]');
	var timespanEl = root.querySelector('[data-role="timespan"]');
	var interestRow = root.querySelector('[data-role="row-interest"]');
	var totalPaidRow = root.querySelector('[data-role="row-total-paid"]');
	var interestEl = root.querySelector('[data-role="interest"]');
	var totalPaidEl = root.querySelector('[data-role="total-paid"]');
	var emptyEl = root.querySelector('[data-role="empty"]');
	var allMutedEl = root.querySelector('[data-role="all-muted"]');
	var warningEl = root.querySelector('[data-role="warning"]');

	function formatCurrency(n) {
		return '$' + Math.round(n).toLocaleString('en-US');
	}

	function formatInput(val) {
		var num = val.replace(/[^0-9.]/g, '');
		var parts = num.split('.');
		if (parts[0]) parts[0] = parseInt(parts[0], 10).toLocaleString('en-US');
		return parts.join('.');
	}

	// Astro's scoped styles only apply to elements present in the built HTML
	// (via a data-astro-cid-* attribute) — elements created client-side via
	// innerHTML don't get it automatically and would silently lose all
	// component styling, so it's copied from an existing element onto every
	// node in a newly built row.
	var scopeAttr = null;
	for (var i = 0; i < root.attributes.length; i++) {
		if (root.attributes[i].name.indexOf('data-astro-cid-') === 0) {
			scopeAttr = root.attributes[i].name;
			break;
		}
	}

	function applyScope(el) {
		if (!scopeAttr) return;
		el.setAttribute(scopeAttr, '');
		el.querySelectorAll('*').forEach(function (child) { child.setAttribute(scopeAttr, ''); });
	}

	function buildRow() {
		var row = document.createElement('div');
		row.className = 'debt-row';
		row.setAttribute('data-row', '');
		row.setAttribute('data-muted', 'false');
		row.innerHTML =
			'<div class="debt-field">' +
				'<label class="calc-label">Debt name</label>' +
				'<input type="text" class="debt-input" data-role="name" placeholder="Debt name (optional)" autocomplete="off" aria-label="Debt name (optional)" />' +
			'</div>' +
			'<div class="debt-field">' +
				'<label class="calc-label">Balance</label>' +
				'<div class="calc-field"><span class="calc-prefix">$</span><input type="text" class="calc-input" data-role="balance" inputmode="decimal" placeholder="0" autocomplete="off" aria-label="Balance" /></div>' +
			'</div>' +
			'<div class="debt-field">' +
				'<label class="calc-label">Interest rate</label>' +
				'<div class="calc-field"><input type="text" class="calc-input" data-role="rate" inputmode="decimal" placeholder="0" autocomplete="off" aria-label="Interest rate" /><span class="calc-suffix">%</span></div>' +
			'</div>' +
			'<div class="debt-field">' +
				'<label class="calc-label">Monthly payment</label>' +
				'<div class="calc-field"><span class="calc-prefix">$</span><input type="text" class="calc-input" data-role="payment" inputmode="decimal" placeholder="0" autocomplete="off" aria-label="Monthly payment" /></div>' +
			'</div>' +
			'<div class="debt-row-head">' +
				'<span class="debt-row-title" data-role="row-title"></span>' +
				'<div class="debt-row-actions">' +
					'<button type="button" class="debt-action" data-action="mute" aria-pressed="false" aria-label="Hide this debt from the calculation">' +
						'<svg class="icon-eye" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>' +
						'<svg class="icon-eye-off" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.5 18.5 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>' +
					'</button>' +
					'<button type="button" class="debt-action" data-action="remove" aria-label="Remove this debt">' +
						'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>' +
					'</button>' +
				'</div>' +
			'</div>';
		applyScope(row);
		return row;
	}

	// The hide/remove controls only make sense once a second debt exists, so the
	// whole head row (and the desktop column it sits in) is dropped below that.
	// Titles stay positional rather than echoing the typed name — the name is
	// already visible in the field directly beneath the heading.
	function updateRowChrome() {
		var rows = rowsContainer.querySelectorAll('[data-row]');
		root.dataset.multi = rows.length > 1 ? 'true' : 'false';
		rows.forEach(function (row, index) {
			row.querySelector('[data-role="row-title"]').textContent = 'Debt ' + (index + 1);
		});
		addBtn.hidden = rows.length >= MAX_ROWS;
	}

	function readDebts(ignoreMute) {
		var rows = rowsContainer.querySelectorAll('[data-row]');
		var debts = [];
		rows.forEach(function (row) {
			if (!ignoreMute && row.dataset.muted === 'true') return;
			var balance = parseFloat((row.querySelector('[data-role="balance"]').value || '').replace(/[^0-9.]/g, '')) || 0;
			var rate = parseFloat((row.querySelector('[data-role="rate"]').value || '').replace(/[^0-9.]/g, '')) || 0;
			var payment = parseFloat((row.querySelector('[data-role="payment"]').value || '').replace(/[^0-9.]/g, '')) || 0;
			if (balance > 0 && payment > 0) {
				debts.push({ balance: balance, apr: rate / 100, payment: payment });
			}
		});
		return debts;
	}

	// Highest interest rate first (avalanche); every payment freed up when a
	// debt clears rolls to the next-highest-rate debt still owing.
	function simulate(debts) {
		var order = debts.slice().sort(function (a, b) { return b.apr - a.apr; });
		var sim = order.map(function (d) { return { balance: d.balance, apr: d.apr, minPayment: d.payment }; });
		var totalInterest = 0;
		var months = 0;
		var MAX_MONTHS = 600; // 50-year safety cap

		while (months < MAX_MONTHS && sim.some(function (d) { return d.balance > 0.01; })) {
			months++;

			sim.forEach(function (d) {
				if (d.balance > 0) {
					var interest = d.balance * (d.apr / 12);
					totalInterest += interest;
					d.balance += interest;
				}
			});

			var budget = 0;
			sim.forEach(function (d) { if (d.balance > 0) budget += d.minPayment; });

			var target = sim.find(function (d) { return d.balance > 0; });
			sim.forEach(function (d) {
				if (d !== target && d.balance > 0) {
					var pay = Math.min(d.minPayment, d.balance);
					d.balance -= pay;
					budget -= pay;
				}
			});

			while (budget > 0.01) {
				var next = sim.find(function (d) { return d.balance > 0.01; });
				if (!next) break;
				var pay = Math.min(budget, next.balance);
				next.balance -= pay;
				budget -= pay;
			}
		}

		return { interest: totalInterest, months: months, maxedOut: months >= MAX_MONTHS };
	}

	function formatTimespan(months) {
		var years = Math.floor(months / 12);
		var rem = months % 12;
		var parts = [];
		if (years > 0) parts.push(years + (years === 1 ? ' year' : ' years'));
		if (rem > 0 || years === 0) parts.push(rem + (rem === 1 ? ' month' : ' months'));
		return parts.join(' ');
	}

	function calculate() {
		var debts = readDebts();
		var totalDebt = 0;
		debts.forEach(function (d) { totalDebt += d.balance; });
		var totalPayments = 0;
		debts.forEach(function (d) { totalPayments += d.payment; });

		if (debts.length === 0) {
			summaryEl.hidden = true;
			highlightEl.hidden = true;
			warningEl.hidden = true;
			var hasMutedDebts = readDebts(true).length > 0;
			emptyEl.hidden = hasMutedDebts;
			allMutedEl.hidden = !hasMutedDebts;
			return;
		}

		emptyEl.hidden = true;
		allMutedEl.hidden = true;
		summaryEl.hidden = false;
		summaryTotal.textContent = formatCurrency(totalDebt);
		summaryCount.textContent = String(debts.length);
		summaryPayments.textContent = formatCurrency(totalPayments);

		var result = simulate(debts);

		if (result.maxedOut) {
			highlightEl.hidden = true;
			interestRow.hidden = true;
			totalPaidRow.hidden = true;
			warningEl.hidden = false;
			return;
		}

		warningEl.hidden = true;
		highlightEl.hidden = false;
		interestRow.hidden = false;
		totalPaidRow.hidden = false;

		var freeDate = new Date();
		freeDate.setMonth(freeDate.getMonth() + result.months);
		dateEl.textContent = freeDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
		timespanEl.textContent = 'Total payoff time: ' + formatTimespan(result.months);

		interestEl.textContent = formatCurrency(result.interest);
		totalPaidEl.textContent = formatCurrency(totalDebt + result.interest);
	}

	rowsContainer.addEventListener('input', function (e) {
		var target = e.target;
		if (!target.classList.contains('calc-input')) return;
		var pos = target.selectionStart;
		var before = target.value.length;
		target.value = formatInput(target.value);
		var after = target.value.length;
		target.setSelectionRange(pos + (after - before), pos + (after - before));
		calculate();
	});

	rowsContainer.addEventListener('click', function (e) {
		if (e.target.closest('[data-action="remove"]')) {
			var row = e.target.closest('[data-row]');
			if (rowsContainer.querySelectorAll('[data-row]').length > 1) {
				row.remove();
				updateRowChrome();
				calculate();
			}
			return;
		}

		var muteBtn = e.target.closest('[data-action="mute"]');
		if (muteBtn) {
			var muteRow = muteBtn.closest('[data-row]');
			var nowMuted = muteRow.dataset.muted !== 'true';
			muteRow.dataset.muted = nowMuted ? 'true' : 'false';
			muteBtn.setAttribute('aria-pressed', nowMuted ? 'true' : 'false');
			muteBtn.setAttribute('aria-label', nowMuted ? 'Show this debt in the calculation' : 'Hide this debt from the calculation');
			calculate();
		}
	});

	addBtn.addEventListener('click', function () {
		var rows = rowsContainer.querySelectorAll('[data-row]');
		if (rows.length >= MAX_ROWS) return;
		rowsContainer.appendChild(buildRow());
		updateRowChrome();
	});

	updateRowChrome();
	calculate();
})();
</script>
