---
import type { Tool } from '../data/tools';

// A miniature of a tool's UI: a white app window with the tool's fields,
// result, and supporting rows, bars, or answer tiles, filled with the sample
// inputs from the tool's `mock` spec in src/data/tools.ts.
//
// It fills its positioned parent (the charcoal media box on a tool card, or
// the homepage preview stage) and scales everything from that box's width
// with container units, so one markup reads the same at 300px and 600px.
// The window runs off the bottom edge on purpose, like a screenshot crop.
// Decorative: the card or row beside it carries the name and link.
interface Props {
	tool: Tool;
	class?: string;
	[attr: string]: unknown;
}

const { tool, class: className, ...rest } = Astro.props;
const m = tool.mock;
// "Debt-Free Date Calculator" reads as a window title without the suffix.
const title = tool.name.replace(/\s+(Calculator|Assessment)$/i, '');
---

<div class:list={['tool-mock', className]} aria-hidden="true" {...rest}>
	<div class="tm-window">
		<span class="tm-dots"><i></i><i></i><i></i></span>
		<p class="tm-title">{title}</p>

		{m.fields?.map((f) => (
			<div class="tm-field">
				<span class="tm-label">{f.label}</span>
				<span class="tm-input">{f.value}</span>
			</div>
		))}

		{m.chips && (
			<div class="tm-chips">
				{m.chips.options.map((c, i) => <span class:list={['tm-chip', { 'is-on': i === m.chips!.selected }]}>{c}</span>)}
			</div>
		)}

		{m.question && <p class="tm-q">{m.question}</p>}
		{m.options && (
			<div class="tm-options">
				{m.options.map((o, i) => <span class:list={['tm-option', { 'is-on': i === m.selected }]}>{o}</span>)}
			</div>
		)}

		{m.result && (
			<div class="tm-result">
				<span class="tm-result-label">{m.result.label}</span>
				<span class="tm-result-value">{m.result.value}</span>
			</div>
		)}

		{m.bars && (
			<div class="tm-bars">
				{m.bars.map((b) => (
					<div class="tm-bar">
						<span class="tm-bar-head"><span>{b.label}</span><span>{b.value}</span></span>
						<span class="tm-bar-track"><span class:list={['tm-bar-fill', `tm-tone-${b.tone}`]} style={`width: ${b.pct}%`}></span></span>
					</div>
				))}
			</div>
		)}

		{m.rows?.map(([label, value]) => (
			<div class="tm-row"><span>{label}</span><span>{value}</span></div>
		))}
	</div>
</div>

<style>
	.tool-mock {
		position: absolute;
		inset: 0;
		container-type: size;
		pointer-events: none;
	}
	.tm-window {
		position: absolute;
		left: 13%;
		right: 13%;
		top: 12%;
		/* Runs past the bottom edge; the parent clips it. */
		min-height: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.7em;
		padding: 1.1em 1.3em;
		border-radius: 1em 1em 0 0;
		background: #FFFFFF;
		color: var(--color-text);
		font-family: var(--font-sans);
		/* Everything inside is sized in em off this: ~13px on a 380px card. */
		font-size: clamp(7px, 3.3cqw, 15px);
		line-height: 1.25;
		box-shadow: 0 1.5em 3em -1em rgba(0, 0, 0, 0.5);
	}
	.tm-dots {
		display: flex;
		gap: 0.4em;
	}
	.tm-dots i {
		width: 0.62em;
		height: 0.62em;
		border-radius: 50%;
		background: #FF5F57;
	}
	.tm-dots i:nth-child(2) { background: #FEBC2E; }
	.tm-dots i:nth-child(3) { background: #28C840; }
	.tm-title {
		margin: 0.4em 0 0.1em;
		font-size: 1.45em;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}
	.tm-field {
		display: flex;
		flex-direction: column;
		gap: 0.3em;
	}
	.tm-label {
		font-size: 0.85em;
		color: var(--color-text-secondary);
	}
	.tm-input {
		padding: 0.55em 0.75em;
		border: 1px solid var(--color-border);
		border-radius: 0.5em;
		background: var(--color-bg-surface);
		font-size: 1em;
		font-variant-numeric: tabular-nums;
	}
	.tm-chips {
		display: flex;
		gap: 0.35em;
	}
	.tm-chip {
		padding: 0.4em 0.8em;
		border-radius: 99em;
		border: 1px solid var(--color-border);
		font-size: 0.85em;
	}
	.tm-chip.is-on {
		background: var(--color-text);
		border-color: var(--color-text);
		color: #FFFFFF;
	}
	.tm-q {
		margin: 0.2em 0 0;
		font-size: 1.15em;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}
	.tm-options {
		display: flex;
		flex-direction: column;
		gap: 0.45em;
	}
	.tm-option {
		padding: 0.7em 0.85em;
		border: 1px solid var(--color-border-hairline);
		border-radius: 0.6em;
		font-size: 0.9em;
	}
	.tm-option.is-on {
		border-color: var(--color-text);
		box-shadow: inset 0 0 0 1px var(--color-text);
	}
	.tm-result {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
		padding: 0.8em 0.9em;
		border-radius: 0.6em;
		background: var(--color-bg-panel);
	}
	.tm-result-label {
		font-size: 0.85em;
		color: var(--color-text-secondary);
	}
	.tm-result-value {
		font-size: 1.9em;
		letter-spacing: -0.03em;
		line-height: 1.05;
		font-variant-numeric: tabular-nums;
	}
	.tm-bars {
		display: flex;
		flex-direction: column;
		gap: 0.65em;
	}
	.tm-bar {
		display: flex;
		flex-direction: column;
		gap: 0.3em;
	}
	.tm-bar-head,
	.tm-row {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		font-size: 0.9em;
		font-variant-numeric: tabular-nums;
	}
	.tm-row {
		padding-top: 0.55em;
		border-top: 1px solid var(--color-border-hairline);
	}
	.tm-row span:first-child {
		color: var(--color-text-secondary);
	}
	.tm-bar-track {
		display: block;
		height: 0.55em;
		border-radius: 99em;
		background: var(--color-bg-emphasis);
		overflow: hidden;
	}
	.tm-bar-fill {
		display: block;
		height: 100%;
		border-radius: inherit;
	}
	.tm-tone-info { background: var(--color-accent-info); }
	.tm-tone-caution { background: var(--color-accent-caution); }
	.tm-tone-positive { background: var(--color-accent-positive); }
	.tm-tone-avalanche { background: var(--color-debt-avalanche); }
	.tm-tone-snowball { background: var(--color-debt-snowball); }
</style>
