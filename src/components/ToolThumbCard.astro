---
import type { Tool } from '../data/tools';

interface Props {
	tool: Tool;
}

const { tool } = Astro.props;
const toolId = tool.url.replace(/\/$/, '').split('/').pop();
---

<a href={tool.url} class="tool-thumb-card" data-cta={`tool_thumb_card:${toolId}`}>
	<div class="tool-thumb-illustration">
		<svg viewBox="0 0 240 160" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={tool.illustration} />
	</div>
	<div class="tool-thumb-body">
		<h3 class="tool-thumb-title">{tool.name}</h3>
		<p class="tool-thumb-desc">{tool.desc}</p>
	</div>
</a>

<style>
	.tool-thumb-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
	}
	.tool-thumb-illustration {
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-bg-panel);
		padding: var(--space-md);
		color: var(--color-text);
		margin-bottom: var(--space-sm);
		transition: background 0.15s ease;
	}
	@media (hover: hover) {
		.tool-thumb-card:hover .tool-thumb-illustration {
			background: var(--color-bg-emphasis);
		}
	}
	.tool-thumb-illustration svg {
		display: block;
		width: 100%;
		height: 100%;
	}
	.tool-thumb-title {
		font-size: var(--text-body);
		font-weight: var(--weight-normal);
		line-height: 1.35;
		margin: 0 0 var(--space-xs);
		color: var(--color-text);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.tool-thumb-desc {
		font-size: var(--text-small);
		color: var(--color-text-secondary);
		line-height: var(--leading-snug);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
