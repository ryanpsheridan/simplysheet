---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

/* `id` is the analytics label, not the visible text — see the data-cta
   attributes below. Naming a nav item by what it *is* rather than what it
   currently says means rewording a link doesn't split its history in GA4. */
const NAV_LINKS = [
	{ href: '/articles/', label: 'Articles', id: 'articles' },
	{ href: '/spreadsheets/', label: 'Spreadsheets', id: 'spreadsheets' },
	{ href: '/tools/', label: 'Free Tools', id: 'tools' },
];

/* The mobile panel carries Home and the quiz alongside the desktop links —
   the bar has no room for either, and both are reachable there instead. */
const MENU_LINKS = [
	{ href: '/', label: 'Home', id: 'home' },
	...NAV_LINKS,
	{ href: '/quiz/budgeting-style/', label: 'Budgeting Style Quiz', id: 'quiz' },
];
---

{/*
	Floating navigation. The shell stays in normal flow and sticks, rather than
	being fixed and overlaying — fixed positioning would need every page to
	reserve matching top padding by hand, and any page that forgot would hide
	its own first heading under the bar.

	DOM order is logo → links → menu button → CTA, which is the order they
	should be read in. Visual placement uses explicit grid columns per
	breakpoint, so mobile can put the CTA and menu button hard right of the
	logo while desktop right-aligns the links against the CTA — neither needs
	the markup reordered underneath it.
*/}
<div class="header-shell">
	<div class="header-inner">
		<header class="site-header">
			{/* Deliberately untracked: a logo click is "go home", not a choice
			    between destinations, and it would swamp the nav numbers. */}
			<a href="/" class="site-logo">
				<img src="/images/logo-svg.svg" alt="Simply Sheets logo" class="site-logo-mark" width="24" height="26" />
				<span class="site-logo-text">{SITE_TITLE}</span>
			</a>

			<nav class="desktop-nav" aria-label="Primary">
				<ul>
					{NAV_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								class="nav-link"
								data-cta={`nav_link:${link.id}`}
								aria-current={isActive(link.href) ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<button
				id="menu-toggle"
				class="menu-toggle"
				type="button"
				aria-haspopup="dialog"
				aria-expanded="false"
				aria-controls="app-menu"
				aria-label="Menu"
			>
				<span class="bar bar-top"></span>
				<span class="bar bar-bottom"></span>
			</button>

			{/* Desktop only — see .header-cta below. The quiz is reachable from the
			    mobile panel, so the bar doesn't carry it twice. */}
			<a href="/quiz/budgeting-style/" class="btn btn-primary btn-sm header-cta" data-cta="nav_cta">Find Your Budget Style</a>
		</header>

		<div id="app-menu" class="app-menu" role="dialog" aria-modal="true" aria-label="Menu">
			<nav aria-label="Primary">
				<ul>
					{MENU_LINKS.map((link, i) => (
						<li style={`--i: ${i};`}>
							<a
								href={link.href}
								class="menu-item"
								data-cta={`nav_menu_link:${link.id}`}
								aria-current={isActive(link.href) ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>
	</div>
</div>

<div class="menu-backdrop" hidden></div>

<style>
	/* --- Floating shell ---------------------------------------------------- */

	.header-shell {
		position: sticky;
		top: var(--space-sm);
		z-index: 50;
		margin-top: var(--space-sm);
		/* Clears the status bar / notch when the page is drawn edge to edge —
		   an installed PWA (the manifest is display: standalone) or Android
		   Chrome's edge-to-edge default. Both insets resolve to 0px in a normal
		   browser tab, so this is inert there. The inline max() covers a
		   landscape notch eating into the side gutters. */
		padding-top: env(safe-area-inset-top, 0px);
		padding-left: max(var(--space-md), env(safe-area-inset-left, 0px));
		padding-right: max(var(--space-md), env(safe-area-inset-right, 0px));
	}

	/* Anchors the dropdown panel: it's positioned against this, not against the
	   bar, so it spans the bar's full width regardless of the bar's padding. */
	.header-inner {
		position: relative;
		max-width: var(--max-width);
		margin-inline: auto;
	}

	.site-header {
		display: grid;
		/* Mobile: logo left, then the CTA and menu button grouped hard right.
		   Desktop re-columns below.

		   minmax(0, 1fr), not 1fr: a grid track's automatic minimum is its
		   content's min-content width, and the logo is white-space: nowrap — so
		   a plain 1fr refuses to shrink and shoves the controls past the right
		   edge on a narrow phone. Letting the track go to zero lets the logo
		   truncate instead, which keeps the controls reachable. */
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-xs);
		padding: 0.75rem;
		border-radius: var(--radius-full);
		/* Pure white rather than the page's warm off-white: at this size a cream
		   fill has almost nothing to separate it from the page behind and reads
		   as a smudge instead of a surface. Held translucent because the blur
		   needs something to see through — at 85% it still reads as white while
		   the page stays visible moving underneath.

		   The hairline does the edge definition, so the shadow stays a hint of
		   lift. A border and a heavy shadow both drawing the same edge is what
		   makes a bar like this feel heavy. */
		background: color-mix(in srgb, var(--color-bg-surface) 85%, transparent);
		border: 1px solid var(--color-border-hairline);
		-webkit-backdrop-filter: saturate(180%) blur(16px);
		backdrop-filter: saturate(180%) blur(16px);
		box-shadow: var(--shadow-sm);
	}

	/* Floating over content, the bar's only separation is its own shadow — so
	   it deepens as the page scrolls under it rather than changing fill.
	   Longhands, not the `animation` shorthand: the shorthand resets
	   animation-timeline to auto, and a minifier may reorder declarations so
	   the reset lands last. */
	@supports (animation-timeline: scroll()) {
		@media (prefers-reduced-motion: no-preference) {
			.site-header {
				animation-name: header-lift;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: scroll(root block);
				animation-range: 0 96px;
			}

			@keyframes header-lift {
				to {
					box-shadow: var(--shadow-md);
				}
			}
		}
	}

	.site-logo {
		/* Explicit row on every child: with grid-column set but the row left to
		   auto-placement, an item asking for column 1 after one already placed
		   in column 2 gets pushed to a second row rather than moving the cursor
		   backwards. Pinning the row keeps the bar one line tall. */
		grid-row: 1;
		grid-column: 1;
		justify-self: start;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-heading);
		font-size: 1.2rem;
		font-weight: var(--weight-medium);
		letter-spacing: var(--tracking-snug);
		color: var(--color-text);
		text-decoration: none;
		white-space: nowrap;
		/* justify-self: start sizes the item to its own content, which can still
		   exceed the track it sits in — so it's capped to the track before the
		   ellipsis can do anything. */
		max-width: 100%;
		min-width: 0;
		overflow: hidden;
	}

	.site-logo-mark {
		display: block;
		flex-shrink: 0;
	}

	.site-logo-text {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Hidden below the desktop breakpoint. On a phone the bar is logo + menu
	   button only: the quiz already sits in the panel, and a second pill beside
	   the menu button was both a space squeeze and a second competing weight. */
	.header-cta {
		display: none;
		grid-row: 1;
		justify-self: end;
	}

	/* --- Desktop nav ------------------------------------------------------- */

	/* Hidden by default and revealed at the breakpoint, so the mobile panel
	   stays the baseline experience rather than a fallback. */
	.desktop-nav {
		display: none;
	}

	.desktop-nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		gap: var(--space-md);
	}

	.nav-link {
		position: relative;
		font-family: var(--font-heading);
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text-secondary);
		text-decoration: none;
		padding-block: var(--space-xs);
		transition: color var(--duration-fast) var(--ease-out);
	}

	.nav-link:hover {
		color: var(--color-text);
	}

	/* The underline is a pseudo-element rather than text-decoration so the
	   current-page state can animate and can't shift the text baseline. */
	.nav-link::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 1.5px;
		border-radius: var(--radius-full);
		background: var(--color-text);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform var(--duration-base) var(--ease-out);
	}

	.nav-link[aria-current='page'] {
		color: var(--color-text);
	}

	.nav-link[aria-current='page']::after {
		transform: scaleX(1);
	}

	/* --- Menu button ------------------------------------------------------- */

	/* A filled disc rather than bare bars, so it reads as a control with real
	   weight. It can be ink again now that the CTA no longer sits beside it —
	   two dark pills side by side were what made the bar feel heavy.

	   Two bars that rotate into an X — the same elements in both states, so
	   there's no icon swap. */
	.menu-toggle {
		grid-row: 1;
		grid-column: 2;
		justify-self: end;
		position: relative;
		width: 2.5rem;
		height: 2.5rem;
		border: none;
		border-radius: 50%;
		background: var(--color-btn);
		padding: 0;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition:
			background-color var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.menu-toggle:hover {
		background: var(--color-btn-hover);
	}

	.menu-toggle:active {
		transform: scale(0.94);
	}

	.menu-toggle .bar {
		position: absolute;
		left: 50%;
		width: 16px;
		margin-left: -8px;
		height: 1.5px;
		border-radius: 2px;
		background: var(--color-bg);
		transition:
			top var(--duration-base) var(--ease-out),
			transform var(--duration-base) var(--ease-out);
	}

	.menu-toggle .bar-top {
		top: 17px;
	}

	.menu-toggle .bar-bottom {
		top: 23px;
	}

	.menu-toggle.open .bar-top {
		top: 20px;
		transform: rotate(45deg);
	}

	.menu-toggle.open .bar-bottom {
		top: 20px;
		transform: rotate(-45deg);
	}

	/* --- Mobile panel ------------------------------------------------------ */

	/* A floating card hung under the bar, not a full-screen takeover. The page
	   stays visible and blurred behind it, so the menu reads as a layer over
	   the site rather than a different screen. */
	.app-menu {
		position: absolute;
		top: calc(100% + 0.75rem);
		left: 0;
		right: 0;
		z-index: 1;
		padding: var(--space-md);
		border-radius: var(--radius-xl);
		/* Matches the bar, so the panel reads as the same surface extended
		   rather than a second material hanging off it. */
		background: color-mix(in srgb, var(--color-bg-surface) 92%, transparent);
		border: 1px solid var(--color-border-hairline);
		-webkit-backdrop-filter: saturate(180%) blur(16px);
		backdrop-filter: saturate(180%) blur(16px);
		box-shadow: var(--shadow-lg);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-8px) scale(0.98);
		transform-origin: top center;
		transition:
			opacity var(--duration-base) var(--ease-out),
			transform var(--duration-base) var(--ease-out),
			visibility 0s linear var(--duration-base);
	}

	.app-menu.open {
		opacity: 1;
		visibility: visible;
		transform: translateY(0) scale(1);
		transition:
			opacity var(--duration-base) var(--ease-out),
			transform var(--duration-base) var(--ease-out),
			visibility 0s linear 0s;
	}

	.app-menu ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	/* Items rise in one after another as the panel opens — 40ms apart, so five
	   finish inside a fifth of a second and it never feels like waiting.

	   --i is set per item in the markup; nth-child rules would cap the effect
	   at however many were written. */
	.menu-item {
		display: block;
		font-family: var(--font-heading);
		font-size: var(--text-body-lg);
		font-weight: var(--weight-medium);
		letter-spacing: var(--tracking-snug);
		color: var(--color-text);
		text-decoration: none;
		padding-block: 0.75rem;
		-webkit-tap-highlight-color: transparent;
		opacity: 0;
		transform: translateY(8px);
		transition:
			color var(--duration-fast) var(--ease-out),
			opacity var(--duration-base) var(--ease-out),
			transform var(--duration-base) var(--ease-out);
	}

	.app-menu.open .menu-item {
		opacity: 1;
		transform: translateY(0);
		transition-delay: calc(var(--i, 0) * 40ms);
	}

	/* Scoped to .app-menu.open so it outranks the stagger rule above, which
	   would otherwise hold transform at translateY(0) and swallow the press. */
	.app-menu.open .menu-item:active {
		transform: translateY(0) scale(0.98);
	}

	.menu-item[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 0.3em;
	}

	/* Duration is already near-zero under reduced motion, but the delay isn't —
	   without this the last item would still wait to appear. */
	@media (prefers-reduced-motion: reduce) {
		.app-menu.open .menu-item {
			transition-delay: 0s;
		}
	}

	/* --- Backdrop ---------------------------------------------------------- */

	.menu-backdrop {
		position: fixed;
		inset: 0;
		z-index: 49;
		background: color-mix(in srgb, var(--color-bg-inverse) 12%, transparent);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
		opacity: 0;
		transition: opacity var(--duration-base) var(--ease-out);
	}

	.menu-backdrop.open {
		opacity: 1;
	}

	/* --- Desktop ----------------------------------------------------------- */

	/* Swap the panel for the inline nav. Both are removed from the
	   accessibility tree when not in use, so exactly one "Primary" navigation
	   landmark is ever exposed. */
	@media (min-width: 860px) {
		.header-shell {
			padding-inline: var(--space-md);
		}

		.site-header {
			grid-template-columns: auto minmax(0, 1fr) auto;
			gap: var(--space-sm);
			padding-inline: var(--space-md);
		}

		.header-cta {
			display: inline-flex;
			grid-column: 3;
		}

		/* Right-aligned against the CTA rather than centred in the track: the
		   links and the CTA then read as one control cluster, instead of the
		   links floating in the middle with dead space on both sides. */
		.desktop-nav {
			display: block;
			grid-row: 1;
			grid-column: 2;
			justify-self: end;
			/* On top of the grid gap. Right-aligned, the last link otherwise sits
			   almost against the CTA and the two read as one run of controls. */
			margin-right: var(--space-md);
		}

		.menu-toggle,
		.app-menu,
		.menu-backdrop {
			display: none;
		}
	}
</style>

<script>
	const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
	const menu = document.getElementById('app-menu') as HTMLDivElement | null;
	const backdrop = document.querySelector<HTMLDivElement>('.menu-backdrop');

	if (toggle && menu) {
		const openMenu = () => {
			menu.classList.add('open');
			toggle.classList.add('open');
			toggle.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
			if (backdrop) {
				backdrop.hidden = false;
				// Next frame, so the element is in the layout before the class that
				// transitions it — setting both in one frame skips the animation.
				requestAnimationFrame(() => backdrop.classList.add('open'));
			}
			menu.querySelector<HTMLAnchorElement>('.menu-item')?.focus();
		};

		const closeMenu = () => {
			menu.classList.remove('open');
			toggle.classList.remove('open');
			toggle.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
			backdrop?.classList.remove('open');
		};

		// Hide the backdrop from hit-testing only once it has finished fading, so
		// a click during the close animation can't land on the page underneath.
		backdrop?.addEventListener('transitionend', (e) => {
			if (e.propertyName === 'opacity' && !backdrop.classList.contains('open')) {
				backdrop.hidden = true;
			}
		});

		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;

			if (target.closest('#menu-toggle')) {
				if (menu.classList.contains('open')) {
					closeMenu();
					toggle.focus();
				} else {
					openMenu();
				}
				return;
			}

			if (target.closest('.app-menu a')) {
				closeMenu();
				return;
			}

			// Tapping the dimmed page outside the panel closes it, which is what
			// the backdrop looks like it should do.
			if (menu.classList.contains('open') && !target.closest('.app-menu')) {
				closeMenu();
			}
		});

		document.addEventListener('keydown', (e) => {
			if (!menu.classList.contains('open')) return;

			if (e.key === 'Escape') {
				closeMenu();
				toggle.focus();
				return;
			}

			// Focus trap. The panel is aria-modal, so focus must not escape it
			// while it's open — without this, tabbing past the last link lands on
			// browser chrome or page content the user can't see.
			if (e.key !== 'Tab') return;

			const items = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));
			if (items.length === 0) return;

			const first = items[0];
			const last = items[items.length - 1];
			const active = document.activeElement;

			if (e.shiftKey && (active === first || !menu.contains(active))) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && active === last) {
				e.preventDefault();
				first.focus();
			}
		});
	}
</script>
