---
// A horizontal row of cards that starts on the content column's left edge
// and runs off the right edge of the screen, so the next card peeks in, in
// Apple's product-page pattern. Native horizontal scrolling with snap points
// (swipe, trackpad, shift-wheel, or keyboard once the track has focus), plus
// round previous/next buttons under the right end.
//
// Cards go in the default slot and are sized by --rail-card. The layout lives
// in global.css (.card-rail), so a rail anywhere on the site looks the same.
interface Props {
	/** Accessible name for the scrolling region, e.g. "Spreadsheets". */
	label: string;
	/** data-cta prefix for the buttons: `${cta}:prev` / `${cta}:next`. */
	cta?: string;
}

const { label, cta } = Astro.props;
---

<div class="card-rail" data-card-rail>
	<div class="card-rail-track" role="region" aria-label={label} tabindex="0">
		<slot />
	</div>
	<div class="card-rail-controls">
		<button type="button" class="card-rail-btn" data-dir="-1" aria-label={`Previous ${label.toLowerCase()}`} data-cta={cta ? `${cta}:prev` : undefined} disabled>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
		</button>
		<button type="button" class="card-rail-btn" data-dir="1" aria-label={`Next ${label.toLowerCase()}`} data-cta={cta ? `${cta}:next` : undefined}>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
		</button>
	</div>
</div>

<script>
	// One step is one card plus the gap. The buttons disable at either end,
	// and re-check on scroll and resize so a swipe keeps them in sync.
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	document.querySelectorAll<HTMLElement>('[data-card-rail]').forEach((rail) => {
		const track = rail.querySelector<HTMLElement>('.card-rail-track');
		const buttons = rail.querySelectorAll<HTMLButtonElement>('.card-rail-btn');
		if (!track) return;

		const step = () => {
			const card = track.firstElementChild as HTMLElement | null;
			const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
			return card ? card.offsetWidth + gap : track.clientWidth;
		};

		const sync = () => {
			const max = track.scrollWidth - track.clientWidth - 2;
			buttons.forEach((b) => {
				b.disabled = b.dataset.dir === '-1' ? track.scrollLeft <= 2 : track.scrollLeft >= max;
			});
		};

		buttons.forEach((b) => {
			b.addEventListener('click', () => {
				track.scrollBy({
					left: Number(b.dataset.dir) * step(),
					behavior: reduceMotion.matches ? 'auto' : 'smooth',
				});
			});
		});

		track.addEventListener('scroll', sync, { passive: true });
		window.addEventListener('resize', sync);
		sync();
	});
</script>
