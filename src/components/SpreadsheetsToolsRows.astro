---
import { getCollection } from 'astro:content';
import { TOOLS } from '../data/tools';
import ToolThumbCard from './ToolThumbCard.astro';

// The Free tools + Spreadsheets rows shared by the homepage and the About
// page. Renders `.home-row` fragments (no section wrapper) so the caller
// controls the surrounding `.home-rows` / `.home-rows-inner` layout. All
// styling lives in the global "Home rows" block in src/styles/global.css.
//
// `only` lets a caller take one row at a time: the homepage pulls Spreadsheets
// out into its own full-bleed band, which needs a separate wrapper element, so
// the two rows can't be emitted as one adjacent pair there. About still asks
// for both and gets them in order.
interface Props {
	only?: 'tools' | 'spreadsheets';
}

const { only } = Astro.props;
const showTools = only !== 'spreadsheets';
const showTemplates = only !== 'tools';

const templates = (await getCollection('templates'))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3)
	.map((t) => ({
		name: t.data.title.replace(/ for (Google )?Sheets & Excel$/, ''),
		desc: t.data.description,
		url: `/spreadsheets/${t.id}/`,
		image: t.data.midImage,
		badge: t.data.badge,
	}));

const topTools = TOOLS.slice(0, 3);
---

{showTools && (
	<div class="home-row">
		<div class="home-row-label">
			<h2 class="home-row-heading">Free tools</h2>
		</div>
		<div class="home-row-items">
			{topTools.map((tool) => (
				<ToolThumbCard tool={tool} />
			))}
			<div class="home-row-viewall">
				<a href="/tools/" class="btn btn-secondary" data-cta="home_tools_row_view_all">All tools <span class="arrow">&rarr;</span></a>
			</div>
		</div>
	</div>
)}
{showTemplates && templates.length > 0 && (
	<div class="home-row">
		<div class="home-row-label">
			<h2 class="home-row-heading">Spreadsheets</h2>
		</div>
		<div class="home-row-items">
			{templates.map((t) => (
				<a href={t.url} class="home-row-item" data-cta={`home_spreadsheets_row_item:${t.url.replace(/^\/spreadsheets\/|\/$/g, '')}`}>
					<div class="home-row-thumb home-row-thumb--product">
						{t.image
							? <img src={t.image} alt={`${t.name} preview`} width="600" height="400" loading="lazy" />
							: <svg class="home-row-placeholder" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 16l5-5 4 4 4-4 5 5" /><circle cx="8.5" cy="8.5" r="1.5" /></svg>
						}
						{t.badge && <span class="badge badge-overlay">{t.badge}</span>}
					</div>
					<div class="home-row-text">
						<h3 class="home-row-title">{t.name}</h3>
						<p class="home-row-desc">{t.desc}</p>
					</div>
				</a>
			))}
			<div class="home-row-viewall">
				<a href="/spreadsheets/" class="btn btn-secondary" data-cta="home_spreadsheets_row_view_all">All spreadsheets <span class="arrow">&rarr;</span></a>
			</div>
		</div>
	</div>
)}
